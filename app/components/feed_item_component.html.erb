<% if show_feed_item? %>
  <%= list_item do %>
    <div class="d-flex align-items-start">
      <div class="mr-3 flex-shrink-0" style="width: 48px;">
        <% if feed_item.weekly_update? %>
          <%= render "shared/jellyswitch_square" %>
        <% elsif feed_item.member_feedback.present? && feed_item.member_feedback.anonymous? %>
          <%= image_tag "profile-125x125.jpg", class: "img-thumbnail rounded-circle", style: "width: 48px; height: 48px; object-fit: cover;" %>
        <% else %>
          <%= render "shared/small_profile_photo", user: feed_item.user %>
        <% end %>
      </div>

      <div class="flex-grow-1" style="min-width: 0;">
        <div class="d-flex justify-content-between align-items-baseline flex-wrap">
          <div class="mr-2" style="min-width: 0;">
            <% unless feed_item.weekly_update? %>
              <% if feed_item.member_feedback.present? && feed_item.member_feedback.anonymous? %>
                <strong class="text-dark">Anonymous</strong>
              <% else %>
                <%= link_to feed_item.user.name, user_path(feed_item.user), class: "text-dark font-weight-bold" %>
              <% end %>
            <% end %>
            <span class="text-muted"><%= feed_item.action_text %></span>
          </div>
          <%= link_to "#{time_ago_in_words(feed_item.created_at)} ago", feed_item_path(feed_item), class: "text-muted small text-decoration-none flex-shrink-0", style: "white-space: nowrap;" %>
        </div>

        <div class="mt-2">
          <% if subcomponent.is_a?(String) %>
            <%= render subcomponent, feed_item: feed_item %>
          <% else %>
            <%= render subcomponent.new(feed_item: feed_item) %>
          <% end %>
        </div>

        <%= render "operator/feed_items/common", feed_item: feed_item, comments: comments %>
      </div>
    </div>
  <% end %>
<% end %>
