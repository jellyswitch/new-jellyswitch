<%# Store badges use local assets — the old linkmaker.itunes.apple.com Apple badge
    host no longer resolves (broken image). Each badge renders only when its URL
    is set. %>
<div class="row">
  <% if operator.ios_url.present? %>
    <div class="col text-center align-middle">
      <a href="<%= operator.ios_url %>" target="_blank" rel="noopener">
        <%= image_tag "app-store-badge.png", alt: "Download on the App Store", style: "height: 40px; width: auto;" %>
      </a>
    </div>
  <% end %>

  <% if operator.android_url.present? %>
    <div class="col text-center align-middle">
      <a href="<%= operator.android_url %>" target="_blank" rel="noopener">
        <%= image_tag "google-play-badge.png", alt: "Get it on Google Play", style: "height: 40px; width: auto;" %>
      </a>
    </div>
  <% end %>
</div>
