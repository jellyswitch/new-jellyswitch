<h4 class="display-4">Payment method</h4>
<p>Tap to change:</p>
<ul class="list-group mt-4">
  <% if card_added_for_location?(helpers.current_location) %>
    <% if cash_or_check? %>
      <%= link_to "Card ending in #{last_4_digits(helpers.current_location)}", credit_card_path, class: "list-group-item" %>
    <% else %>
      <% if user? %>
        <% if bill_to_group? %>
          <%= link_to "Card ending in #{last_4_digits(helpers.current_location)}", credit_card_path, class: "list-group-item" %>
        <% else %>
          <li class="list-group-item active">Card ending in <%= last_4_digits(helpers.current_location) %></li>
        <% end %>
      <% else %>
        <% if cash_or_check? %>
          <%= link_to "Card ending in #{last_4_digits(helpers.current_location)}", credit_card_path, class: "list-group-item" %>
        <% else %>
          <li class="list-group-item active">
            Card ending in <%= last_4_digits(helpers.current_location) %>
            <% if billing_via_contact? %>
              <div class="small text-white-50 mt-1">
                Billed to <%= effective_billable.name %> (billing contact)
              </div>
            <% end %>
          </li>
        <% end %>
      <% end %>
    <% end %>
  <% elsif cash_or_check? && !bill_to_group? %>
    <%# Out of band with no card: still needs an exit back to card billing,
        otherwise the flag is one-way until a card shows up. %>
    <%= link_to "Credit card (none on file yet)", credit_card_path, class: "list-group-item" %>
  <% else %>
    <li class="list-group-item disabled">
      No card on file
      <% if billing_via_contact? %>
        <div class="small text-muted mt-1">
          Billing contact <%= effective_billable.name %> has not added a card yet.
        </div>
      <% end %>
    </li>
  <% end %>

  <% if cash_or_check? && !bill_to_group? %>
    <li class="list-group-item active">Out of band</li>
  <% else %>
    <%= link_to "Out of band", cash_or_check_path, class: "list-group-item" %>
  <% end %>

  <% if billable_to_group? %>
    <% if member_of_group? %>
      <% if bill_to_group? %>
        <li class="list-group-item active">Bill to group (<%= group_name %>)</li>
      <% else %>
        <%= link_to "Bill to group (#{group_name})", bill_to_group_path, class: "list-group-item" %>
      <% end %>
    <% else %>
      <% if bill_to_group? %>
        <span class="badge badge-danger">User is not a member of a group</span>
      <% end %>
      <li class="list-group-item disabled">Group billing unavailable (not a member of a group)</li>
    <% end %>
  <% else %>
    <%= link_to update_card_label, update_card_path, class: "btn btn-block btn-primary mt-3" %>
  <% end %>
</ul>