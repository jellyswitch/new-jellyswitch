<div class="row mb-2 mr-1 ml-1">
  <div class="col mt-3">
    <h5 class="text-center">
      <i class="fas fa-users"></i>
      &nbsp;
      Become a member
    </h5>
    <div class="mt-3">
      <%= location.name %> has <%= pluralize(location.plans.for_individuals.count, "plan") %> available.
    </div>
    <div class="d-flex justify-content-center mt-3">
      <% if location.has_categories? %>
        <%= link_to "Become a member", plan_categories_path, class: "btn btn-primary w-100", style: "max-width: 420px;", data: { acc: 'new-member' } %>
      <% else %>
        <%= link_to "Become a member", subscriptions_path, class: "btn btn-primary w-100", style: "max-width: 420px;", data: { acc: 'new-member' } %>
      <% end %>
    </div>
  </div>
  
</div>