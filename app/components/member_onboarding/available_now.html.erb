<div class="row mb-2 mr-1 ml-1">
  <div class="col mt-3">
    <h5 class="text-center">
      <i class="fas fa-calendar-alt"></i>
      &nbsp;
      Reserve now
    </h5>
    <div class="mt-3">
      Book a meeting room based on available free dates and times. Reserve
      instantly without any hassle.
    </div>
    <div class="mt-3">
      There are <span class="font-weight-bold"><%= available_rooms_now.count %>
        rooms</span> available right now!
    </div>
    <div class="d-flex justify-content-center mt-3">
      <%= link_to "Book a meeting room", calendar_reservations_path, class: "btn btn-primary w-100", style: "max-width: 420px;" %>
    </div>
  </div>
</div>