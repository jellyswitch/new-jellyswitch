<% title "Sign Up" %>

<%= render(Layout::Freola::ColorfulBackgroundCard.new(title: "Sign Up", body: "Create your workspace owner account.")) do %>
  <%= form_with(url: create_user_onboarding_index_path, method: :post) do |f| %>
    <div class="form-group">
      <%= f.label :email, "Email address" %>
      <%= f.email_field :email, placeholder: "you@example.com", class: "form-control", required: true, autocomplete: "email" %>
    </div>
    <div class="form-group">
      <%= f.label :password, "Password" %>
      <%= f.password_field :password, placeholder: "Choose a password (min 6 characters)", class: "form-control", required: true, minlength: 6, autocomplete: "new-password" %>
    </div>
    <div class="form-group">
      <%= f.label :password_confirmation, "Confirm password" %>
      <%= f.password_field :password_confirmation, placeholder: "Re-enter your password", class: "form-control", required: true, minlength: 6, autocomplete: "new-password" %>
    </div>
    <%= f.submit "Begin onboarding", class: "btn btn-primary btn-block", data: { turbo: "false", disable_with: "Starting..." } %>
  <% end %>
<% end %>
