<h2>New tour request</h2>

<p><strong><%= @requester.name %></strong> requested a tour<% if @location %> at <strong><%= @location.name %></strong><% end %>.</p>

<ul>
  <li><strong>Email:</strong> <%= mail_to @requester.email %></li>
  <% if @requester.phone.present? %>
    <li><strong>Phone:</strong> <%= @requester.phone %></li>
  <% end %>
  <% if @preferred_time.present? %>
    <li><strong>Preferred time:</strong> <%= @preferred_time %></li>
  <% end %>
</ul>

<% if @message.present? %>
  <h3>Message</h3>
  <p><%= simple_format(@message) %></p>
<% end %>

<p>
  <%= link_to "Open in Jellyswitch",
              "https://#{@operator.subdomain}.jellyswitch.com/users/#{@requester.id}" %>
</p>

<% if @mirrored_to.present? %>
  <p>
    Also logged as a tour request at <strong><%= @mirrored_to["operator_name"] %></strong><% if @mirrored_to["location_name"].present? %> (<%= @mirrored_to["location_name"] %>)<% end %>.
    <%= link_to "Open in Jellyswitch",
                "https://#{@mirrored_to["operator_subdomain"]}.jellyswitch.com/users/#{@mirrored_to["user_id"]}" %>
  </p>
<% end %>
