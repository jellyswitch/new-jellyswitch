<%#
  People (CRM) umbrella sub-nav. Renders on the People list, Automated
  Emails, and Campaigns index pages. `active_tab:` selects which pill is
  highlighted.
%>
<% tabs = [
  { key: "people",      label: "Members",      path: people_path },
  { key: "waitlist",    label: "Office queue", path: waitlist_people_path },
  { key: "automations", label: "Automations",  path: product_email_templates_path },
  { key: "campaigns",   label: "Campaigns",    path: campaigns_path },
] %>

<div class="bg-light rounded p-2 mb-3" data-testid="people-subnav-container">
  <div class="text-center text-uppercase text-muted small mb-2" style="letter-spacing: 0.5px;">
    People (CRM)
  </div>
  <ul class="nav nav-pills nav-fill mb-0" data-testid="people-subnav">
    <% tabs.each do |tab| %>
      <li class="nav-item">
        <%= link_to tab[:label], tab[:path],
              class: "nav-link font-weight-bold #{'active' if active_tab.to_s == tab[:key]}" %>
      </li>
    <% end %>
  </ul>
</div>
