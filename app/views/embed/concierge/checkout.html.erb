<%
  accent = @operator.embed_accent_color
  price = number_to_currency(@product.amount_in_cents.to_f / 100.0)
  product_param = @product.is_a?(Plan) ? "plan_id" : "day_pass_type_id"
  # A single day pass is for a specific day — let the buyer pick it. Bundles
  # schedule days after purchase and memberships start today, so no picker.
  day_picker = !@product.is_a?(Plan) && !@product.bundle?
%>
<div id="cxco"
     data-purchase-url="<%= embed_concierge_checkout_path(operator_subdomain: @operator.subdomain) %>"
     data-pk="<%= @location.stripe_publishable_key %>"
     data-account="<%= @location.stripe_user_id %>"
     data-product-param="<%= product_param %>"
     data-product-id="<%= @product.id %>"
     data-location-id="<%= @location.id %>"
     data-app-name="<%= @operator.name %>"
     data-ios="<%= @operator.ios_url %>"
     data-android="<%= @operator.android_url %>"
     style="--accent: <%= accent %>;">

  <h2><%= @product.name %></h2>
  <p class="muted"><%= price %> · <%= @location.name %></p>

  <form id="cxco-form">
    <input name="name" type="text" placeholder="Your name" autocomplete="name" required>
    <input name="email" type="email" placeholder="you@email.com" autocomplete="email" required>
    <input name="phone" type="tel" placeholder="Phone number" autocomplete="tel" required>
    <input name="password" type="password" placeholder="Create a password" autocomplete="new-password" required>
    <% if day_picker %>
      <label class="day-label" for="cxco-day">Which day?</label>
      <input id="cxco-day" name="day" type="date" required
             value="<%= Date.current.iso8601 %>"
             min="<%= Date.current.iso8601 %>" max="<%= (Date.current + 60).iso8601 %>">
    <% end %>
    <div id="card-element"></div>
    <label class="terms">
      <input id="terms" name="terms_accepted" type="checkbox" value="1" required>
      I agree to the <a href="<%= @operator.terms_of_service.attached? ? rails_blob_path(@operator.terms_of_service, only_path: true) : "#" %>" target="_blank">Terms of Service</a>.
    </label>
    <div style="position:absolute;left:-5000px;" aria-hidden="true"><input name="_hp" tabindex="-1" autocomplete="off"></div>
    <button id="pay" type="submit">Pay <%= price %></button>
  </form>
  <%# Outside the form: the form hides on success, the confirmation must not. %>
  <div id="cxco-msg" class="msg"></div>
</div>

<style>
  body { margin: 0; font-family: <%= @operator.embed_font_family %>; color: #111827; }
  #cxco { max-width: 420px; margin: 0 auto; padding: 20px; }
  .muted { color: #6b7280; margin-top: -8px; }
  #cxco-form { display: flex; flex-direction: column; gap: 12px; margin-top: 8px; }
  #cxco-form input { padding: 11px 12px; border: 1px solid #d1d5db; border-radius: 10px; font-size: 15px; }
  #card-element { padding: 12px; border: 1px solid #d1d5db; border-radius: 10px; }
  #pay { padding: 13px; background: var(--accent); color: #fff; border: none; border-radius: 10px; font-size: 16px; font-weight: 600; cursor: pointer; }
  #pay:disabled { opacity: .6; }
  .day-label { font-size: 13px; color: #4b5563; margin-bottom: -6px; }
  .terms { font-size: 13px; color: #4b5563; display: flex; align-items: flex-start; gap: 8px; }
  .terms a { color: var(--accent); }
  .msg { font-size: 14px; min-height: 18px; }
  .msg.err { color: #b91c1c; }
  .msg.ok { color: #047857; }
</style>

<script src="https://js.stripe.com/v3/"></script>
<script>
(function () {
  var root = document.getElementById("cxco");
  var stripe = Stripe(root.dataset.pk, root.dataset.account ? { stripeAccount: root.dataset.account } : undefined);
  var card = stripe.elements().create("card");
  card.mount("#card-element");

  var form = document.getElementById("cxco-form");
  var pay = document.getElementById("pay");
  var msg = document.getElementById("cxco-msg");

  function show(text, cls) { msg.textContent = text; msg.className = "msg " + (cls || ""); }

  // The widget stashes the email it captured before handing off to checkout.
  try {
    var stashed = sessionStorage.getItem("jswcx-email");
    if (stashed && !form.email.value) form.email.value = stashed;
    sessionStorage.removeItem("jswcx-email");
  } catch (e) {}

  form.addEventListener("submit", function (e) {
    e.preventDefault();
    pay.disabled = true; show("Processing…");

    stripe.createToken(card).then(function (res) {
      if (res.error) { show(res.error.message, "err"); pay.disabled = false; return; }

      var body = new URLSearchParams({
        stripe_token: res.token.id,
        location_id: root.dataset.locationId,
        name: form.name.value, email: form.email.value, phone: form.phone.value,
        password: form.password.value,
        terms_accepted: document.getElementById("terms").checked ? "1" : "0",
        _hp: form._hp.value,
      });
      body.append(root.dataset.productParam, root.dataset.productId);
      if (form.day && form.day.value) body.append("day", form.day.value);

      fetch(root.dataset.purchaseUrl, { method: "POST", headers: { "Content-Type": "application/x-www-form-urlencoded" }, body: body })
        .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
        .then(function (x) {
          if (x.d && x.d.ok) {
            form.style.display = "none";
            var lines = ["🎉 Payment received" + (x.d.summary ? " — " + x.d.summary + "." : "!")];
            if (x.d.approval_pending) {
              lines.push("The team reviews new members before your first visit — you'll get an email as soon as you're approved.");
            }
            if (x.d.schedule_days) {
              lines.push((x.d.approval_pending ? "Once you're approved, pick" : "Pick") + " the days you want to use your passes in the app.");
            }
            var appName = (x.d.app && x.d.app.name) || root.dataset.appName;
            lines.push("To access the space, book meeting rooms, and connect to wifi, download and log in to the " + appName + " app.");
            show(lines.join(" "), "ok");
            var stores = [["Get the iOS app", x.d.app && x.d.app.ios], ["Get the Android app", x.d.app && x.d.app.android]];
            stores.forEach(function (s) {
              if (!s[1]) return;
              var a = document.createElement("a"); a.href = s[1]; a.textContent = s[0];
              a.style.cssText = "display:block;margin-top:10px;color:var(--accent);";
              root.appendChild(a);
            });
          } else {
            show((x.d && x.d.message) || "Payment failed — please try again.", "err");
            pay.disabled = false;
          }
        })
        .catch(function () { show("Something went wrong — please try again.", "err"); pay.disabled = false; });
    });
  });
})();
</script>
