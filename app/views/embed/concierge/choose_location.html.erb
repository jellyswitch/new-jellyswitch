<%# First step for a global (unpinned) embed at a multi-location operator:
    catalog, prices, offer, and lead routing are all location-scoped, so the
    visitor picks before the conversation starts. Links keep the widget
    server-rendered — no JS state to carry. %>
<div id="cx" style="--cx-primary: <%= @theme[:primary] %>; --cx-accent: <%= @theme[:accent] %>;">
  <header class="cx-head">
    <% if @operator.icon_image.attached? %>
      <%= image_tag @operator.icon_image, class: "cx-avatar", alt: @operator.concierge_display_name %>
    <% end %>
    <strong><%= @operator.concierge_display_name %></strong>
  </header>

  <div class="cx-thread">
    <div class="cx-msg cx-bot"><%= @operator.concierge_greeting_text %></div>
    <div class="cx-msg cx-bot">Which location are you interested in?</div>
  </div>

  <div class="cx-actions">
    <% @locations.each do |loc| %>
      <%= link_to loc.name,
            embed_concierge_for_location_path(
              operator_subdomain: @operator.subdomain, location_id: loc.id,
              preview_token: params[:preview_token].presence,
            ),
            class: "cx-btn" %>
    <% end %>
  </div>
</div>

<style>
  body { margin: 0; font-family: <%= @theme[:font] %>; }
  #cx { display: flex; flex-direction: column; height: 100vh; max-height: 100vh; color: #111827; }
  .cx-head { display: flex; align-items: center; gap: 8px; padding: 12px 14px; background: var(--cx-primary); color: #fff; }
  .cx-avatar { width: 28px; height: 28px; border-radius: 50%; object-fit: cover; background: #fff; }
  .cx-thread { flex: 1; overflow-y: auto; padding: 14px; display: flex; flex-direction: column; gap: 8px; }
  .cx-msg { max-width: 85%; padding: 9px 12px; border-radius: 14px; font-size: 14px; line-height: 1.35; }
  .cx-bot { background: #f3f4f6; align-self: flex-start; border-bottom-left-radius: 4px; }
  .cx-actions { padding: 10px 14px; display: flex; flex-direction: column; gap: 8px; border-top: 1px solid #e5e7eb; }
  .cx-btn { border: 1px solid var(--cx-accent); background: #fff; color: var(--cx-accent); border-radius: 10px; padding: 10px 12px; font-size: 14px; cursor: pointer; text-align: left; text-decoration: none; }
  .cx-btn:hover { background: var(--cx-accent); color: #fff; }
</style>
