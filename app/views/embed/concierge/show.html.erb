<%
  assistant_name = @operator.concierge_display_name
  greeting = @operator.concierge_greeting_text
  offer = @operator.concierge_offer_text.presence
%>
<div id="cx"
     data-capture-url="<%= embed_concierge_capture_path(operator_subdomain: @operator.subdomain) %>"
     data-location-id="<%= @location&.id %>"
     data-ios="<%= @operator.ios_url %>"
     data-android="<%= @operator.android_url %>"
     style="--cx-primary: <%= @theme[:primary] %>; --cx-accent: <%= @theme[:accent] %>;">

  <% if admin_previewing? && !@operator.concierge_active? %>
    <div class="cx-preview">Preview — the Concierge is not live yet.</div>
  <% end %>

  <header class="cx-head">
    <% if @operator.logo_image.attached? %>
      <%= image_tag @operator.logo_image, class: "cx-avatar", alt: assistant_name %>
    <% end %>
    <strong><%= assistant_name %></strong>
  </header>

  <div id="cx-thread" class="cx-thread">
    <div class="cx-msg cx-bot"><%= greeting %></div>
    <% if offer %>
      <div class="cx-msg cx-bot cx-offer">🎁 <%= offer %></div>
    <% end %>
  </div>

  <div id="cx-actions" class="cx-actions"></div>
</div>

<script type="application/json" id="cx-options"><%= raw @options.to_json %></script>

<style>
  body { margin: 0; font-family: <%= @theme[:font] %>; }
  .cx-offer { background: #ecfdf5; }
  #cx { display: flex; flex-direction: column; height: 100vh; max-height: 100vh; color: #111827; }
  .cx-preview { background: #fffbeb; color: #92400e; font-size: 12px; padding: 6px 12px; text-align: center; }
  .cx-head { display: flex; align-items: center; gap: 8px; padding: 12px 14px; background: var(--cx-primary); color: #fff; }
  .cx-avatar { width: 28px; height: 28px; border-radius: 50%; object-fit: cover; background: #fff; }
  .cx-thread { flex: 1; overflow-y: auto; padding: 14px; display: flex; flex-direction: column; gap: 8px; }
  .cx-msg { max-width: 85%; padding: 9px 12px; border-radius: 14px; font-size: 14px; line-height: 1.35; }
  .cx-bot { background: #f3f4f6; align-self: flex-start; border-bottom-left-radius: 4px; }
  .cx-user { background: var(--cx-accent); color: #fff; align-self: flex-end; border-bottom-right-radius: 4px; }
  .cx-actions { padding: 10px 14px; display: flex; flex-direction: column; gap: 8px; border-top: 1px solid #e5e7eb; }
  .cx-btn { border: 1px solid var(--cx-accent); background: #fff; color: var(--cx-accent); border-radius: 10px; padding: 10px 12px; font-size: 14px; cursor: pointer; text-align: left; }
  .cx-btn:hover { background: var(--cx-accent); color: #fff; }
  .cx-cta { background: var(--cx-accent); color: #fff; border: none; text-align: center; font-weight: 600; text-decoration: none; display: block; }
  .cx-input { width: 100%; box-sizing: border-box; padding: 10px 12px; border: 1px solid #d1d5db; border-radius: 10px; font-size: 14px; }
</style>

<script>
(function () {
  var root = document.getElementById("cx");
  var thread = document.getElementById("cx-thread");
  var actions = document.getElementById("cx-actions");
  var options = JSON.parse(document.getElementById("cx-options").textContent || "[]");
  var captureUrl = root.dataset.captureUrl;
  var locationId = root.dataset.locationId;
  var transcript = [];

  function price(cents) { return "$" + (Number(cents || 0) / 100).toFixed(2); }
  function say(text, who) {
    var d = document.createElement("div");
    d.className = "cx-msg " + (who === "user" ? "cx-user" : "cx-bot");
    d.textContent = text;
    thread.appendChild(d);
    thread.scrollTop = thread.scrollHeight;
    transcript.push((who === "user" ? "visitor: " : "bot: ") + text);
  }
  function clearActions() { actions.innerHTML = ""; }
  function button(label, onClick) {
    var b = document.createElement("button");
    b.className = "cx-btn"; b.textContent = label; b.onclick = onClick;
    actions.appendChild(b);
    return b;
  }

  function renderOptions() {
    clearActions();
    options.forEach(function (opt) { button(opt.label, function () { chooseOption(opt); }); });
  }

  function chooseOption(opt) {
    say(opt.label, "user");
    if (opt.self_serve && opt.product) {
      var p = opt.product;
      var line = p.quantity > 1 ? (p.name + " — " + price(p.price_cents) + " for the pack")
                                : (p.name + " — " + price(p.price_cents));
      say("Great choice. " + line + ". Pop in your email and I'll get you set up.", "bot");
    } else if (opt.intent === "question") {
      say("Happy to help — what's your question? Leave your email and we'll reply.", "bot");
    } else {
      say("Got it — that's one our team sets up personally. Leave your email and they'll reach out.", "bot");
    }
    captureForm(opt);
  }

  function captureForm(opt) {
    clearActions();
    var email = document.createElement("input");
    email.className = "cx-input"; email.type = "email"; email.placeholder = "you@email.com";
    actions.appendChild(email);
    button("Continue", function () {
      var val = (email.value || "").trim();
      if (!val) { email.focus(); return; }
      say(val, "user");
      submit(opt, val);
    });
  }

  function submit(opt, email) {
    clearActions();
    var body = new URLSearchParams({
      email: email, intent: opt.intent,
      recommended_product: (opt.product && opt.product.name) || "",
      location_id: locationId || "",
    });
    (transcript || []).forEach(function (t) { body.append("transcript[]", t); });

    fetch(captureUrl, { method: "POST", headers: { "Content-Type": "application/x-www-form-urlencoded" }, body: body })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (!data || !data.ok) { say("Hmm, something went wrong — please try again.", "bot"); return; }
        if (data.self_serve) {
          say("You're all set! Finish up in the app 👇", "bot");
          ctaLinks(data.app);
        } else {
          say("Thanks! Someone from the team will reach out shortly.", "bot");
        }
      })
      .catch(function () { say("Hmm, something went wrong — please try again.", "bot"); });
  }

  function ctaLinks(app) {
    clearActions();
    if (app && app.ios) { var a = document.createElement("a"); a.href = app.ios; a.target = "_blank"; a.className = "cx-btn cx-cta"; a.textContent = "Get the app (iPhone)"; actions.appendChild(a); }
    if (app && app.android) { var g = document.createElement("a"); g.href = app.android; g.target = "_blank"; g.className = "cx-btn cx-cta"; g.textContent = "Get the app (Android)"; actions.appendChild(g); }
  }

  renderOptions();
})();
</script>
