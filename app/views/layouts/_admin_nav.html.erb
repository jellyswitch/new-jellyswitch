<% if ios_request? %>
  <div style="display: flex !important; flex-wrap: nowrap !important; align-items: center; padding: 8px 16px; background-color: #f8f9fa;">
    <a href="<%= feed_items_path %>" style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1 1 0px; min-width: 0; font-size: 0.9rem; font-weight: 500; color: inherit; text-decoration: none; display: flex; align-items: center; gap: 8px;" data-turbo-action="<%= restore_if_possible %>">
      <%- if current_tenant.logo_image.attached? %>
        <%= image_tag current_tenant.logo_image, width: 25, height: 25 %>
      <%- end %>
      <% if current_location %>
        <%= current_location.name %>
      <% else %>
        <%= current_tenant.name %>
      <% end %>
    </a>
    <button onclick="document.getElementById('ios-admin-nav-menu').style.display = document.getElementById('ios-admin-nav-menu').style.display === 'none' ? 'block' : 'none'" style="flex-shrink: 0; padding: 4px 12px; background: none; border: 1px solid rgba(0,0,0,.1); border-radius: 4px; cursor: pointer;">
      <span style="display: inline-block; width: 30px; height: 30px; background-image: url('data:image/svg+xml,%3csvg xmlns=%27http://www.w3.org/2000/svg%27 width=%2730%27 height=%2730%27 viewBox=%270 0 30 30%27%3e%3cpath stroke=%27rgba%280, 0, 0, 0.5%29%27 stroke-linecap=%27round%27 stroke-miterlimit=%2710%27 stroke-width=%272%27 d=%27M4 7h22M4 15h22M4 23h22%27/%3e%3c/svg%3e'); background-repeat: no-repeat; background-position: center; background-size: 100%;"></span>
    </button>
  </div>
  <div id="ios-admin-nav-menu" style="display: none; background-color: #f8f9fa; padding: 0 16px 8px;">
    <% paths.each do |path| %>
      <a href="<%= path[:path] %>" style="display: block; padding: 8px 0; color: rgba(0,0,0,.7); text-decoration: none;" data-turbo-action="<%= restore_if_possible %>"><%= path[:title] %></a>
    <% end %>
  </div>
<% else %>
  <nav class="navbar navbar-expand-lg navbar-light bg-light">
    <a class="navbar-brand" href="<%= feed_items_path %>" data-turbo-action="<%= restore_if_possible %>">
      <%- if current_tenant.logo_image.attached? %>
        <%= image_tag current_tenant.logo_image, width: 30, height: 30 %>
      <%- end %>
      <% if current_location %>
        <%= current_location.name %>
      <% else %>
        <%= current_tenant.name %>
      <% end %>
    </a>
    <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <ul class="navbar-nav mr-auto">
        <% paths.each do |path| %>
          <%= link_to path[:title], path[:path], class: "nav-link", data: { "turbo-action" => restore_if_possible} %>
        <% end %>
      </ul>
    </div>
  </nav>
<% end %>


