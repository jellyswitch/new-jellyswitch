<% if mobile_app_request? %>
  <div style="display: flex !important; flex-wrap: nowrap !important; align-items: center; padding: 10px 16px; padding-top: calc(env(safe-area-inset-top, 0px) + 10px); background-color: #fff; box-shadow: 0 1px 3px rgba(0,0,0,.08);">
    <a href="<%= feed_items_path %>" style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1 1 0px; min-width: 0; font-size: 0.95rem; font-weight: 600; color: #333; text-decoration: none; display: flex; align-items: center; gap: 10px;" data-turbo-action="<%= restore_if_possible %>">
      <%- if current_tenant.logo_image.attached? %>
        <%= image_tag current_tenant.logo_image, width: 44, height: 44, style: "border-radius: 6px;" %>
      <%- end %>
      <% if current_location %>
        <%= current_location.name %>
      <% else %>
        <%= current_tenant.name %>
      <% end %>
    </a>
    <button onclick="document.getElementById('ios-admin-nav-menu').style.display = document.getElementById('ios-admin-nav-menu').style.display === 'none' ? 'block' : 'none'" style="flex-shrink: 0; padding: 8px; background: none; border: none; cursor: pointer; -webkit-tap-highlight-color: transparent;">
      <span style="display: inline-block; width: 22px; height: 22px; background-image: url('data:image/svg+xml,%3csvg xmlns=%27http://www.w3.org/2000/svg%27 width=%2722%27 height=%2722%27 viewBox=%270 0 22 22%27%3e%3cpath stroke=%27%23555%27 stroke-linecap=%27round%27 stroke-width=%272%27 d=%27M3 5h16M3 11h16M3 17h16%27/%3e%3c/svg%3e'); background-repeat: no-repeat; background-position: center; background-size: 100%;"></span>
    </button>
  </div>
  <div id="ios-admin-nav-menu" style="display: none; background-color: #fff; padding: 0 16px 8px; box-shadow: 0 2px 4px rgba(0,0,0,.08);">
    <% paths.each do |path| %>
      <a href="<%= path[:path] %>" onclick="document.getElementById('ios-admin-nav-menu').style.display='none'" style="display: block; padding: 8px 0; color: rgba(0,0,0,.7); text-decoration: none;" data-turbo-action="<%= restore_if_possible %>"><%= path[:title] %></a>
    <% end %>
  </div>
<% else %>
  <nav class="navbar navbar-light bg-light">
    <a class="navbar-brand" href="<%= feed_items_path %>" data-turbo-action="<%= restore_if_possible %>">
      <%- if current_tenant.logo_image.attached? %>
        <%= image_tag current_tenant.logo_image, width: 44, height: 44 %>
      <%- end %>
      <% if current_location %>
        <%= current_location.name %>
      <% else %>
        <%= current_tenant.name %>
      <% end %>
    </a>
    <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <ul class="navbar-nav mr-auto">
        <% paths.each do |path| %>
          <%= link_to path[:title], path[:path], class: "nav-link", data: { "turbo-action" => restore_if_possible} %>
        <% end %>
      </ul>
    </div>
  </nav>
<% end %>


