<% if untethered_ios_request? || !ios_request? %>

  <nav class="navbar navbar-light bg-light" style="display: flex; flex-wrap: nowrap !important; align-items: center;">
    <a class="navbar-brand" href="<%= root_path %>" style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1 1 0; min-width: 0;" data-turbo-action="<%= restore_if_possible %>">
      <%= image_tag current_tenant.logo_image, width: 30, height: 30 if current_tenant.logo_image.attached? %>
      <%= current_location.name %>
    </a>
    <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation" style="flex-shrink: 0;">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <ul class="navbar-nav mr-auto">
        <% paths.each do |path| %>
          <%= link_to path[:title], path[:path], class: "nav-link", data: { "turbo-action" => restore_if_possible} %>
        <% end %>
      </ul>
    </div>
  </nav>

<% end %>
