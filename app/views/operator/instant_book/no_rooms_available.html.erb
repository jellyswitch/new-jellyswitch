<%= render "shared/back_bar", back_path: home_path, back_label: "Home", page_title: "Reserve Now" %>

<div class="row mt-0 mb-0 p-0" style="background: #fff; min-height: 100vh;">
  <div class="col-lg-3"></div>
  <div class="col-lg-6 m-0 p-0">

    <div class="text-center mt-4 mb-3 px-3">
      <div style="font-size: 48px;">&#127970;</div>
      <h4 class="font-weight-bold mb-1">All Rooms Are Booked</h4>
      <p class="text-muted">Here's when each room frees up next:</p>
    </div>

    <% @rooms_with_free_times.each do |entry| %>
      <div class="mx-3 mb-2">
        <div class="card border">
          <div class="card-body py-2 px-3 d-flex justify-content-between align-items-center">
            <div>
              <strong style="font-size: 14px;"><%= entry[:room].name %></strong>
              <div class="text-muted" style="font-size: 11px;"><%= pluralize(entry[:room].capacity, "person") %> · <%= entry[:room].amenities.pluck(:name).join(", ") %></div>
            </div>
            <div class="text-right">
              <% if entry[:free_at] %>
                <div class="text-success font-weight-bold" style="font-size: 13px;">
                  Free at <%= entry[:free_at].in_time_zone(current_location.time_zone).strftime("%-I:%M %p") %>
                </div>
                <div class="text-muted" style="font-size: 10px;">
                  <% minutes_until = ((entry[:free_at] - Time.current) / 60).round %>
                  <% if minutes_until <= 60 %>
                    in <%= minutes_until %> min
                  <% else %>
                    in <%= minutes_until / 60 %>h <%= minutes_until % 60 %>m
                  <% end %>
                </div>
              <% else %>
                <span class="text-muted" style="font-size: 12px;">Check calendar</span>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <div class="mx-3 mt-3">
      <button class="btn btn-outline-success btn-block font-weight-bold" disabled>
        Notify Me When a Room Opens
      </button>
      <small class="text-muted d-block text-center mt-1">Coming soon</small>
    </div>

    <div class="mx-3 mt-2">
      <%= link_to "Use Calendar to Book Ahead", calendar_reservations_path, class: "btn btn-outline-secondary btn-block" %>
    </div>

    <div class="text-center mt-3 mb-4">
      <small class="text-muted">Your space manager has been notified.</small>
    </div>

  </div>
  <div class="col-lg-3"></div>
</div>
