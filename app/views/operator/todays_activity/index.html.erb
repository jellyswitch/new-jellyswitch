<%= render "shared/back_bar", back_path: feed_items_path, back_label: "Dashboard", page_title: "Who's Coming Today" %>

<div class="row mt-0 mb-0 p-0" style="background: #fff; min-height: 100vh;">
  <div class="col-lg-3"></div>
  <div class="col-lg-6 m-0 p-0">

    <%# Header %>
    <div class="px-3 pt-4 pb-2 text-center">
      <h4 class="display-4 mb-1">Today</h4>
      <p class="text-muted mb-3"><%= Date.current.strftime("%A, %B %-d") %></p>
    </div>

    <%# KPI cards %>
    <% total_revenue = @paid_reservation_revenue + @day_pass_revenue + @new_subscription_revenue %>
    <% first_timer_count = @first_timer_ids.size %>
    <div class="row text-center mx-2 mb-3">
      <div class="col-6 col-lg-3 mb-2">
        <div class="border rounded p-3 h-100">
          <div class="font-weight-bold text-info" style="font-size: 1.6rem;"><%= @total_visitors %></div>
          <div class="text-muted small">
            <%= "Visitor".pluralize(@total_visitors) %> expected
          </div>
          <div class="mt-1" style="font-size: 11px;">
            <span class="text-muted">
              <%= @paid_reservations.count + @free_reservations.count %> bookings · <%= @day_passes.count %> day passes
            </span>
          </div>
        </div>
      </div>

      <div class="col-6 col-lg-3 mb-2">
        <div class="border rounded p-3 h-100">
          <div class="font-weight-bold <%= total_revenue > 0 ? 'text-success' : 'text-muted' %>" style="font-size: 1.6rem; white-space: nowrap;">
            <%= number_to_currency(total_revenue, precision: 0) %>
          </div>
          <div class="text-muted small">Booked revenue</div>
          <div class="mt-1" style="font-size: 11px;">
            <span class="text-muted">
              <%= number_to_currency(@paid_reservation_revenue, precision: 0) %> rooms · <%= number_to_currency(@day_pass_revenue, precision: 0) %> passes<% if @new_subscription_revenue > 0 %> · <%= number_to_currency(@new_subscription_revenue, precision: 0) %> subs<% end %>
            </span>
          </div>
        </div>
      </div>

      <div class="col-6 col-lg-3 mb-2">
        <div class="border rounded p-3 h-100">
          <div class="font-weight-bold <%= first_timer_count > 0 ? 'text-warning' : 'text-muted' %>" style="font-size: 1.6rem;">
            <%= first_timer_count %>
          </div>
          <div class="text-muted small">First-time visitors</div>
          <div class="mt-1" style="font-size: 11px;">
            <span class="text-muted">Worth a warm welcome</span>
          </div>
        </div>
      </div>

      <div class="col-6 col-lg-3 mb-2">
        <div class="border rounded p-3 h-100">
          <div class="font-weight-bold <%= @new_members.count > 0 ? 'text-primary' : 'text-muted' %>" style="font-size: 1.6rem;">
            <%= @new_members.count %>
          </div>
          <div class="text-muted small">New members</div>
          <div class="mt-1" style="font-size: 11px;">
            <span class="text-muted">Joined in the last 7 days</span>
          </div>
        </div>
      </div>
    </div>

    <%# Paid Room Bookings %>
    <% if @paid_reservations.any? %>
      <div class="px-3 pt-3 pb-1">
        <small class="text-uppercase font-weight-bold" style="letter-spacing: 0.5px; color: #5a8a30;">
          <i class="fas fa-dollar-sign"></i> Paid Bookings (<%= @paid_reservations.count %>)
        </small>
      </div>
      <% @paid_reservations.each do |reservation| %>
        <div class="mx-3 mb-2">
          <div class="card border-success" style="border-left: 4px solid #7ab648 !important;">
            <div class="card-body py-2 px-3">
              <div class="d-flex justify-content-between align-items-start">
                <div>
                  <%= link_to reservation.user.name, user_path(reservation.user), class: "font-weight-bold text-dark", style: "font-size: 14px; text-decoration: underline;" %>
                  <% if @first_timer_ids.include?(reservation.user_id) %>
                    <span class="badge badge-warning" style="font-size: 10px;">NEW VISITOR</span>
                  <% end %>
                  <div class="text-muted" style="font-size: 12px;">
                    <%= reservation.room.name %> &middot;
                    <%= reservation.datetime_in.strftime("%-I:%M %p") %> - <%= reservation.datetime_out.strftime("%-I:%M %p") %>
                  </div>
                  <% if reservation.user.organization.present? %>
                    <div class="text-muted" style="font-size: 11px;"><%= reservation.user.organization.name %></div>
                  <% end %>
                </div>
                <span class="text-success font-weight-bold" style="font-size: 15px;">
                  <%= number_to_currency(reservation.room.hourly_rate_in_cents * (reservation.minutes / 60.0) / 100.0) %>
                </span>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>

    <%# Day Passes %>
    <% if @day_passes.any? %>
      <div class="px-3 pt-3 pb-1">
        <small class="text-uppercase font-weight-bold" style="letter-spacing: 0.5px; color: #e67e22;">
          <i class="fas fa-ticket-alt"></i> Day Passes (<%= @day_passes.count %>)
        </small>
      </div>
      <% @day_passes.each do |day_pass| %>
        <div class="mx-3 mb-2">
          <div class="card" style="border-left: 4px solid #e67e22 !important;">
            <div class="card-body py-2 px-3">
              <div class="d-flex justify-content-between align-items-start">
                <div>
                  <%= link_to day_pass.user.name, user_path(day_pass.user), class: "font-weight-bold text-dark", style: "font-size: 14px; text-decoration: underline;" %>
                  <% if @first_timer_ids.include?(day_pass.user_id) %>
                    <span class="badge badge-warning" style="font-size: 10px;">NEW VISITOR</span>
                  <% end %>
                  <div class="text-muted" style="font-size: 12px;">
                    <%= day_pass.day_pass_type_name %>
                  </div>
                  <% if day_pass.user.organization.present? %>
                    <div class="text-muted" style="font-size: 11px;"><%= day_pass.user.organization.name %></div>
                  <% end %>
                </div>
                <% amount = day_pass.day_pass_type&.amount_in_cents.to_i %>
                <span class="<%= amount > 0 ? 'text-success' : 'text-muted' %> font-weight-bold" style="font-size: 15px;">
                  <%= amount > 0 ? number_to_currency(amount / 100.0) : "Free" %>
                </span>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>

    <%# Member Room Bookings (included in plan) %>
    <% if @free_reservations.any? %>
      <div class="px-3 pt-3 pb-1">
        <small class="text-uppercase font-weight-bold text-muted" style="letter-spacing: 0.5px;">
          <i class="far fa-calendar-alt"></i> Member Bookings (<%= @free_reservations.count %>)
        </small>
      </div>
      <% @free_reservations.each do |reservation| %>
        <div class="mx-3 mb-2">
          <div class="card" style="border-left: 4px solid #dee2e6 !important;">
            <div class="card-body py-2 px-3">
              <div class="d-flex justify-content-between align-items-start">
                <div>
                  <%= link_to reservation.user.name, user_path(reservation.user), class: "font-weight-bold text-dark", style: "font-size: 14px; text-decoration: underline;" %>
                  <div class="text-muted" style="font-size: 12px;">
                    <%= reservation.room.name %> &middot;
                    <%= reservation.datetime_in.strftime("%-I:%M %p") %> - <%= reservation.datetime_out.strftime("%-I:%M %p") %>
                  </div>
                </div>
                <span class="text-muted" style="font-size: 12px;">Included</span>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>

    <%# Members Here Today — walked in via door access or front-desk
        checkin without an explicit reservation/day pass on the books. %>
    <% if @walk_in_members.any? %>
      <div class="px-3 pt-3 pb-1">
        <small class="text-uppercase font-weight-bold" style="letter-spacing: 0.5px; color: #16a085;">
          <i class="fas fa-door-open"></i> Members Here Today (<%= @walk_in_members.count %>)
        </small>
      </div>
      <% @walk_in_members.each do |member| %>
        <% arrived = @arrived_at_by_user[member.id] %>
        <div class="mx-3 mb-2">
          <div class="card" style="border-left: 4px solid #16a085 !important;">
            <div class="card-body py-2 px-3">
              <div class="d-flex justify-content-between align-items-start">
                <div>
                  <%= link_to member.name, user_path(member), class: "font-weight-bold text-dark", style: "font-size: 14px; text-decoration: underline;" %>
                  <div class="text-muted" style="font-size: 12px;">
                    <% if arrived %>
                      Arrived <%= arrived.in_time_zone(Time.zone).strftime("%-I:%M %p") %>
                    <% end %>
                  </div>
                  <% if member.organization.present? %>
                    <div class="text-muted" style="font-size: 11px;"><%= member.organization.name %></div>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>

    <%# New Members %>
    <% if @new_members.any? %>
      <div class="px-3 pt-3 pb-1">
        <small class="text-uppercase font-weight-bold" style="letter-spacing: 0.5px; color: #3498db;">
          <i class="fas fa-user-plus"></i> New Members (<%= @new_members.count %>)
        </small>
      </div>
      <% @new_members.each do |member| %>
        <div class="mx-3 mb-2">
          <div class="card" style="border-left: 4px solid #3498db !important;">
            <div class="card-body py-2 px-3">
              <div class="d-flex justify-content-between align-items-start">
                <div>
                  <%= link_to member.name, user_path(member), class: "font-weight-bold text-dark", style: "font-size: 14px; text-decoration: underline;" %>
                  <span class="badge badge-info" style="font-size: 10px;">NEW MEMBER</span>
                  <div class="text-muted" style="font-size: 12px;">
                    Joined <%= time_ago_in_words(member.created_at) %> ago
                    <% if member.subscriptions.active.first %>
                      &middot; <%= member.subscriptions.active.first.plan.name %>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>

    <%# Empty state %>
    <% if @paid_reservations.empty? && @day_passes.empty? && @free_reservations.empty? && @new_members.empty? && @walk_in_members.empty? %>
      <div class="text-center py-4 px-3">
        <div class="mb-3" style="font-size: 2.5rem; color: #c8ced3;">
          <i class="fas fa-mug-hot"></i>
        </div>
        <h5 class="mb-2">Quiet day</h5>
        <p class="text-muted small mb-0" style="max-width: 320px; margin-left: auto; margin-right: auto;">
          No bookings, day passes, or new members on the books for today. Coffee's on you.
        </p>
      </div>
    <% end %>

    <div class="pb-4"></div>
  </div>
  <div class="col-lg-3"></div>
</div>
