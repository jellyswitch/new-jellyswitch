<%- title "Archived Members" %>

<%= breadcrumb do %>
  <li class="breadcrumb-item"><%= link_to "Members & Groups", members_groups_path %></li>
  <li class="breadcrumb-item"><%= link_to "Member Directory", users_path %></li>
  <li class="breadcrumb-item active" aria-current="page">Archived Members</li>
<% end %>

<div class="row mt-1 mb-0 p-0">
  <div class="col-lg-3"></div>
  <div class="col-lg-6 m-0 p-0">
    <%= list_wrapper do %>
      <%= list_item do %>
        <h4 class="display-4 text-center">Archived Members</h4>
      <% end %>
      <%= form_with(url: search_archived_users_path, method: :get, local: true) do |f| %>
        <div class="form-group mx-3 mb-2 mt-2">
          <div class="input-group">
            <%= f.text_field :query, value: @query, placeholder: "Search archived members...", class: "form-control" %>
            <div class="input-group-append">
              <%= button_tag(type: "submit", class: "btn btn-primary search-btn") do %>
                <i class="fas fa-search"></i>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
      <% if @users.count < 1 %>
          <p class="text-center text-muted mt-2"><%= @query.present? ? "No archived members found for \"#{@query}\"." : "Your member archive is empty." %></p>
      <% else %>
        <% @users.each_with_index do |user, index| %>
          <%= render "list_item", user: user, index: index %>
        <% end %>
      <% end %>
    <% end %>
    <%== pagy_bootstrap_nav(@pagy) %>
  </div>
  <div class="col-lg-3"></div>
</div>