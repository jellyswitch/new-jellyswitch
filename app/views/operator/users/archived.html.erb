<%- title "Archived Members" %>

<%= render "shared/back_bar", back_path: members_groups_path, back_label: "Members & Groups", page_title: "Archived Members" %>

<%= wide_card do %>
  <h4 class="display-4 text-center mb-1">Archived</h4>
  <p class="text-center text-muted mb-3">Members who have been archived. They no longer count toward active stats.</p>

  <div class="d-flex justify-content-center mb-3">
    <div class="btn-group" role="group" aria-label="Member view">
      <%= link_to "All", users_path, class: "btn btn-sm btn-outline-secondary" %>
      <%= link_to unapproved_users_path, class: "btn btn-sm btn-outline-secondary" do %>
        Approval queue
      <% end %>
      <%= link_to archived_users_path, class: "btn btn-sm btn-primary" do %>
        Archived
      <% end %>
    </div>
  </div>

  <%= form_with(url: search_archived_users_path, method: :get, local: true) do |f| %>
    <div class="input-group">
      <div class="input-group-prepend">
        <span class="input-group-text bg-white border-right-0"><i class="fas fa-search text-muted"></i></span>
      </div>
      <%= f.text_field :query, value: @query, placeholder: "Search archived members...", class: "form-control border-left-0" %>
      <% if @query.present? %>
        <div class="input-group-append">
          <%= link_to archived_users_path, class: "btn btn-outline-secondary", title: "Clear search" do %>
            <i class="fas fa-times"></i>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>

<%= wide_card do %>
  <% if @users.count < 1 %>
    <div class="text-center py-4">
      <div class="mb-3" style="font-size: 2.5rem; color: #c8ced3;">
        <i class="fas fa-archive"></i>
      </div>
      <% if @query.present? %>
        <h5 class="mb-2">No archived members match "<%= @query %>"</h5>
        <p class="text-muted small mb-3">Try a different name or email.</p>
        <%= link_to "Clear search", archived_users_path, class: "btn btn-sm btn-outline-primary" %>
      <% else %>
        <h5 class="mb-2">No archived members</h5>
        <p class="text-muted small" style="max-width: 320px; margin-left: auto; margin-right: auto;">
          Archived members will appear here. You can archive a member from their profile.
        </p>
      <% end %>
    </div>
  <% else %>
    <div class="list-group list-group-flush">
      <% @users.each_with_index do |user, index| %>
        <%= render "list_item", user: user, index: index %>
      <% end %>
    </div>
    <div class="mt-3">
      <%== pagy_bootstrap_nav(@pagy) %>
    </div>
  <% end %>
<% end %>
