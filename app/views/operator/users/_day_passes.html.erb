<div class="row mt-2">
  <div class="col">
    <%= render(Buttons::NewDayPass.new(user: user, classes: "btn btn-primary btn-block")) do %>
      Add day pass
    <% end %>
  </div>
</div>

<% bundles = user.day_pass_bundles.order(purchased_at: :desc) %>
<% if bundles.any? %>
  <h5 class="display-5 text-center mt-3">Day Pass Bundles:</h5>
  <ul class="list-group list-group-flush mb-3">
    <% bundles.each do |bundle| %>
      <li class="list-group-item">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <strong><%= bundle.day_pass_type.name %></strong>
            &mdash; <%= bundle.passes_remaining %> / <%= bundle.quantity_purchased %> passes remaining
            <% if bundle.expires_at.present? %>
              <span class="text-muted small">(expires <%= bundle.expires_at.to_date %>)</span>
            <% end %>
          </div>
          <div class="d-flex">
            <% if bundle.active? %>
              <%= button_to "Burn a pass",
                    user_day_pass_bundle_burns_path(user),
                    method: :post,
                    params: { day_pass_bundle_id: bundle.id, reason: "admin burn" },
                    class: "btn btn-sm btn-outline-secondary mr-1",
                    form: { data: { turbo_confirm: "Burn one pass from this bundle without scheduling a day?" } } %>
            <% end %>
            <%= button_to "Restore a pass",
                  user_day_pass_bundle_restores_path(user),
                  method: :post,
                  params: { day_pass_bundle_id: bundle.id, reason: "admin restore" },
                  class: "btn btn-sm btn-outline-secondary",
                  form: { data: { turbo_confirm: "Restore one pass to this bundle?" } } %>
          </div>
        </div>
      </li>
    <% end %>
  </ul>
  <%# Web parity with the mobile admin schedule picker: today = burn now
      (front-desk member without the app), future = reserve ahead. ScheduleDay
      picks the pack, so one control for all bundles, not one per row. %>
  <% if user.day_pass_bundles.active.where(location: current_location).any? %>
    <p class="text-muted small mb-1">
      Use a pass for a day — today burns it now, a future date reserves it. Draws from the soonest-expiring pack.
    </p>
    <%= form_with url: user_day_pass_bundle_schedules_path(user), method: :post, class: "d-flex align-items-center mb-3" do |f| %>
      <%= f.date_field :day, value: Time.zone.today, min: Time.zone.today,
            max: Time.zone.today + Billing::DayPassBundles::ScheduleDay::HORIZON_DAYS,
            class: "form-control form-control-sm mr-1", style: "width: 10rem;" %>
      <%= f.submit "Use a pass", class: "btn btn-sm btn-outline-primary",
            data: { turbo_confirm: "Use one of #{user.name}'s bundle passes for the selected date? Picking today burns it now." } %>
    <% end %>
  <% end %>
<% end %>

<% if @user.day_passes.count < 1 %>
  <div class="row">
    <div class="col text-center">
      No day passes.
    </div>
  </div>
<% else %>
  <h5 class="display-5 text-center mt-3">Day Passes:</h5>
  <% bundle_sourced_ids = user.day_passes.bundle_sourced.pluck(:id).to_set %>
  <ul class="list-group list-group-flush">
    <% user.day_passes.order('day DESC').each do |day_pass| %>
      <li class="list-group-item">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <%= day_pass.pretty_day %>
            <% if bundle_sourced_ids.include?(day_pass.id) %>
              <span class="text-muted small">(from pack)</span>
            <% end %>
            <% unless day_pass.reschedulable? %>
              <span class="text-muted small">(used)</span>
            <% end %>
            <% if (hold = day_pass.office_hold) %>
              <br>
              <span class="text-muted small">
                <%= hold.room.name %> &middot; <%= hold.window_label %><%= " (hidden)" unless hold.room.visible %>
              </span>
            <% end %>
          </div>
          <div class="d-flex align-items-center">
            <% if day_pass.reschedulable? && policy(day_pass).reschedule? %>
              <%= form_with url: reschedule_day_pass_path(day_pass), method: :patch, class: "d-flex align-items-center" do |f| %>
                <%= f.date_field :day, value: day_pass.day, min: Time.zone.today, class: "form-control form-control-sm mr-1", style: "width: 10rem;" %>
                <%= f.submit "Move", class: "btn btn-sm btn-outline-secondary",
                      data: { turbo_confirm: "Move this pass to the selected date?" } %>
              <% end %>
            <% end %>
            <%# Room reassign (Task 14, ADR 0026): same staff gate as the Move
                control above (policy(day_pass).reschedule?) — the office hold
                itself is admin-reassignable (ReservationPolicy#reassign_room?),
                but reusing the day-pass gate here keeps one check for every
                staff control this partial renders. datetime_out > Time.current:
                a past-window hold is not a live thing to move (mirrors
                ReassignRoom.call's own liveness guard) — the info line above
                still shows it, but offering a Reassign control for it would
                only round-trip into that service's "no longer active" refusal. %>
            <% if (hold = day_pass.office_hold) && hold.datetime_out > Time.current && policy(day_pass).reschedule? %>
              <% room_options = DayOffices::ReassignRoom.options_for(hold) %>
              <% if room_options.any? %>
                <%= form_with url: reassign_room_reservation_path(hold), method: :patch, class: "d-flex align-items-center ml-1" do |f| %>
                  <%= select_tag :room_id,
                        options_for_select(room_options.map { |r| [r.visible ? r.name : "#{r.name} (hidden)", r.id] }),
                        class: "form-control form-control-sm mr-1", style: "width: 10rem;" %>
                  <%= f.submit "Reassign", class: "btn btn-sm btn-outline-secondary",
                        data: { turbo_confirm: "Move this office hold to the selected room?" } %>
                <% end %>
              <% else %>
                <span class="text-muted small ml-1">No other rooms free</span>
              <% end %>
            <% end %>
            <% if bundle_sourced_ids.include?(day_pass.id) && day_pass.day > Time.zone.today %>
              <%= button_to "Return to pack",
                    user_day_pass_bundle_schedule_path(user, day_pass),
                    method: :delete,
                    class: "btn btn-sm btn-outline-secondary ml-1",
                    form: { data: { turbo_confirm: "Cancel this scheduled day and return the pass to #{user.name}'s pack?" } } %>
            <% end %>
          </div>
        </div>
      </li>
    <% end %>
  </ul>
<% end %>
