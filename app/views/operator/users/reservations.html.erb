<% title "My Reservations" %>

<%= render "shared/back_bar", back_path: user_path(@user), back_label: "My Account", page_title: "My Reservations" %>

<%= render Layout::FullWidth.new do %>
  <%= link_to user_past_reservations_path(@user), class: "list-group-item list-group-item-action d-flx m-0" do %>
    <div class="row">
      <div class="col-11">
        <i class="fas fa-history"></i>
        &nbsp;
        Past Reservations
      </div>
      <div class="col-1">
        <i class="fas fa-chevron-right"></i>
      </div>
    </div>
  <% end %>


  <% if @reservations.count < 1 %>
    <%= list_item do %>
      <p class="lead text-center">No upcoming reservations.</p>
    <% end %>
  <% else %>
    <% @reservations.each do |res_hash| %>
      <%= render Reservations::DayList.new(reservation_hash: res_hash) %>
    <% end %>
  <% end %>
<% end %>
