<%- title "My Account" %>

<%= render(Layout::FullWidth.new) do %>
  <%= list_item do %>
    <h4 class="display-4 text-center">My Account</h4>

    <p class="lead text-center">Quick Actions</p>
    <% if policy(:payment).enabled? %>
      <%= link_to "View my membership", user_memberships_path(current_user), class: "btn btn-block btn-primary" %>
      <%= link_to "View my day passes", user_day_passes_path(current_user), class: "btn btn-block btn-primary" %>
      <%= link_to "View my invoices", user_invoices_path(current_user), class: "btn btn-block btn-primary" %>
    <% end %>
    <% if policy(:room).enabled? %>
      <%= link_to "View my reservations", user_reservations_path(current_user), class: "btn btn-block btn-primary" %>
    <% end %>
    <% if current_user.organization_owner? %>
      <%= link_to "View my group", organization_path(current_user.owned_organization), class: "btn btn-block btn-primary" %>
    <% end %>
    <% if policy(:room).enabled? && current_location.rooms.visible.count > 0 %>
      <%= link_to "Meeting Room Preferences", "#meeting-prefs", class: "btn btn-block btn-primary", data: { toggle: "collapse" } %>
    <% end %>
    <%= link_to "Change my password", user_change_password_path(current_user), class: "btn btn-block btn-info" %>
    <%= link_to "Change My Account", user_change_account_path(current_user), class: "btn btn-block btn-warning" %>
    <%= link_to "Log out", logout_path, data: { turbo_method: :delete }, class: "btn btn-block btn-warning" %>
  <% end %>

  <% if policy(:room).enabled? && current_location.rooms.visible.count > 0 %>
    <%= list_item do %>
      <div class="collapse" id="meeting-prefs">
        <h5 class="font-weight-bold mb-3">Meeting Room Preferences</h5>
        <p class="text-muted" style="font-size: 13px;">These preferences are used when you tap "Reserve Now" to pre-select your room and duration.</p>
        <%= form_with(model: current_user, url: user_path(current_user), method: :patch, local: true) do |f| %>
          <div class="form-group">
            <%= f.label :preferred_room_id, "Favorite Room", class: "font-weight-bold" %>
            <%= f.select :preferred_room_id,
                  current_location.rooms.visible.order(:name).map { |r| ["#{r.name} (#{r.capacity} people)", r.id] },
                  { include_blank: "No preference", selected: current_user.preferred_room_id },
                  class: "form-control" %>
          </div>
          <div class="form-group">
            <%= f.label :preferred_meeting_duration, "Usual Meeting Length", class: "font-weight-bold" %>
            <%= f.select :preferred_meeting_duration,
                  [["15 minutes", 15], ["30 minutes", 30], ["45 minutes", 45], ["1 hour", 60], ["1.5 hours", 90], ["2 hours", 120]],
                  { selected: current_user.preferred_meeting_duration || 60 },
                  class: "form-control" %>
          </div>
          <%= f.submit "Save Preferences", class: "btn btn-success btn-block" %>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <%= list_item do %>
    <h4 class="display-4 text-center">My Usage</h4>
    <%= render "usage", user: @user, usage_report: @usage_report %>
  <% end %>

  <%= list_item do %>
    <h4 class="display-4 text-center">Personal Information</h4>

    <dl class="row">
      <dt class="col-6">Name</dt>
      <dd class="col"><%= @user.name %></dd>

      <dt class="col-6">Email address</dt>
      <dd class="col"><%= @user.email %></dd>

      <dt class="col-6">Phone number</dt>
      <dd class="col">
        <% if @user.phone.present? %>
          <%= number_to_phone(@user.phone) %>
        <% else %>
          <i>Not set</i>
        <% end %>
      </dd>

      <dt class="col-6">Profile Photo</dt>
      <dd class="col">
        <%- if @user.has_profile_photo? %>
          <%= image_tag @user.square_profile_photo, class: "img-thumbnail" %>
        <%- else %>
          (none set)
        <%- end %>
      </dd>

      <%- if @user.original_location.present? %>
        <dt class="col-6">Main location</dt>
        <dd class="col original-location"><%= @user.original_location.name %></dd>
      <%- end %>

      <%- if @user.current_location.present? %>
        <dt class="col-6">Current location</dt>
        <dd class="col current-location"><%= @user.current_location.name %></dd>
      <%- end %>

      <dt class="col-6">Bio</dt>
      <dd class="col"><%= @user.bio %></dd>

      <dt class="col-6">Linkedin</dt>
      <dd class="col"><%= @user.linkedin %></dd>

      <dt class="col-6">Twitter</dt>
      <dd class="col"><%= @user.twitter %></dd>

      <dt class="col-6">Website</dt>
      <dd class="col"><%= @user.website %></dd>
    </dl>
    <%= link_to "Update personal information", edit_user_path(@user), class: "btn btn-block btn-primary" %>
  <% end %>

  <%= list_item do %>
    <h4 class="display-4 text-center">Payment Information</h4>

    <%= render "payment_method_user", user: @user %>
    <hr />
    <%= link_to "Update payment information", user_billing_path(current_user), class: "btn btn-block btn-primary" %>
  <% end %>

  <%= list_item do %>
    <h4 class="display-4 text-center text-danger">Delete Account</h4>
    <p class="text-muted text-center">Permanently delete your account and all associated data. This action cannot be undone. Any active memberships will be cancelled.</p>
    <%= link_to "Delete My Account", user_path(@user), method: :delete, class: "btn btn-block btn-outline-danger", data: { confirm: "Are you sure you want to delete your account? This will cancel any active memberships and cannot be undone. Type DELETE to confirm.", turbo_method: :delete, turbo_confirm: "Are you sure you want to delete your account? This will cancel any active memberships and cannot be undone." } %>
  <% end %>
<% end %>