<%- title "Member Directory" %>

<%= render "shared/back_bar", back_path: members_groups_path, back_label: "Members & Groups", page_title: "Member Directory" %>

<%= wide_card do %>
  <h4 class="display-4 text-center mb-1">Members</h4>
  <p class="text-center text-muted mb-3">Everyone who's been added or signed up at this location.</p>

  <% if policy(@users).index? %>
    <div class="text-center mb-3">
      <%= link_to add_member_users_path, class: "btn btn-primary" do %>
        <i class="fas fa-user-plus"></i>&nbsp; Add a member
      <% end %>
    </div>
  <% end %>

  <div class="d-flex justify-content-center mb-3">
    <div class="btn-group" role="group" aria-label="Member view">
      <%= link_to "All", users_path, class: "btn btn-sm #{params[:action] == 'index' || params[:action] == 'search' ? 'btn-primary' : 'btn-outline-secondary'}" %>
      <%= link_to unapproved_users_path, class: "btn btn-sm btn-outline-secondary" do %>
        Approval queue
        <% if @unapproved_users.count > 0 %>
          <span class="badge badge-light ml-1"><%= @unapproved_users.count %></span>
        <% end %>
      <% end %>
      <%= link_to archived_users_path, class: "btn btn-sm btn-outline-secondary" do %>
        Archived
        <% if @archived_users_count > 0 %>
          <span class="badge badge-light ml-1"><%= @archived_users_count %></span>
        <% end %>
      <% end %>
    </div>
  </div>

  <%= form_with(url: search_users_path, method: :get, local: true, class: "mb-3") do |f| %>
    <div class="input-group">
      <div class="input-group-prepend">
        <span class="input-group-text bg-white border-right-0"><i class="fas fa-search text-muted"></i></span>
      </div>
      <%= f.text_field :query, placeholder: "Search by name or email...", class: "form-control border-left-0", value: @query %>
      <% if @query.present? %>
        <div class="input-group-append">
          <%= link_to users_path, class: "btn btn-outline-secondary", title: "Clear search" do %>
            <i class="fas fa-times"></i>
          <% end %>
        </div>
      <% end %>
    </div>
  <%- end %>
<% end %>

<%= wide_card do %>
  <% if @users.count < 1 %>
    <div class="text-center py-4">
      <div class="mb-3" style="font-size: 2.5rem; color: #c8ced3;">
        <i class="fas fa-user-friends"></i>
      </div>
      <% if @query.present? %>
        <h5 class="mb-2">No members match "<%= @query %>"</h5>
        <p class="text-muted small mb-3">Try a different name or email.</p>
        <%= link_to "Clear search", users_path, class: "btn btn-sm btn-outline-primary" %>
      <% else %>
        <h5 class="mb-2">No members yet</h5>
        <p class="text-muted small mb-3" style="max-width: 320px; margin-left: auto; margin-right: auto;">
          Members will appear here once they sign up or you add them manually.
        </p>
        <% if policy(@users).index? %>
          <%= link_to "Add the first member", add_member_users_path, class: "btn btn-sm btn-outline-primary" %>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="list-group list-group-flush">
      <% @users.each_with_index do |user, index| %>
        <%= render "list_item", user: user, index: index %>
      <% end %>
    </div>
    <div class="mt-3">
      <%== pagy_bootstrap_nav(@pagy) %>
    </div>
  <% end %>
<% end %>
