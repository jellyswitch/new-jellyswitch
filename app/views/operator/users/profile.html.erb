<% title @user.name %>

<%= wide_card do %>
  <div class="d-flex align-items-center mb-3">
    <div class="mr-3 flex-shrink-0" style="width: 56px;">
      <%= render "shared/small_profile_photo", user: @user %>
    </div>
    <div class="flex-grow-1" style="min-width: 0;">
      <h5 class="mb-1 text-truncate">
        <%= link_to @user.name, user_path(@user), class: "text-dark" %>
      </h5>
      <small class="text-muted">
        Joined <%= time_ago_in_words(@user.created_at) %> ago
        (<%= @user.created_at.strftime("%b %e, %Y") %>)
      </small>
    </div>
  </div>

  <% if policy(:payment).enabled? %>
    <% badges_present = @user.member_at_operator?(current_tenant) && (@user.has_active_subscription? || @user.has_active_day_pass? || @user.has_active_lease?) || @user.pending? %>
    <% if badges_present %>
      <div class="mb-3">
        <% if @user.member_at_operator?(current_tenant) %>
          <% if @user.has_active_subscription? %>
            <span class="badge badge-success">Member</span>
          <% end %>
          <% if @user.has_active_day_pass? %>
            <span class="badge badge-primary">Day Pass</span>
          <% end %>
          <% if @user.has_active_lease? %>
            <span class="badge badge-info">Office Lease</span>
          <% end %>
        <% end %>
        <% if @user.pending? %>
          <span class="badge badge-warning">Pending</span>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <button type="button" class="btn btn-block btn-primary" data-toggle="modal" data-target="#newModal">
    <i class="fas fa-bolt"></i>&nbsp; Quick actions
  </button>

  <% if policy(@user).log_tour? %>
    <button type="button" class="btn btn-block btn-outline-primary mt-2" data-toggle="modal" data-target="#logTourModal">
      <i class="fas fa-walking"></i>&nbsp; Log a tour
    </button>
  <% end %>

  <% if policy(@user).add_note? %>
    <button type="button" class="btn btn-block btn-outline-primary mt-2" data-toggle="modal" data-target="#addNoteModal">
      <i class="far fa-sticky-note"></i>&nbsp; Add note
    </button>
  <% end %>

  <% if @user.has_active_subscription? && !@user.has_active_lease? %>
    <%= link_to new_office_lease_path(user_id: @user.id), class: "btn btn-block btn-outline-primary mt-2" do %>
      <i class="fas fa-building"></i>&nbsp; Upgrade to Office
    <% end %>
  <% end %>

  <div class="mt-3">
    <label class="small text-muted mb-1">Owned by</label>
    <% if policy(@user).reassign_point_of_contact? %>
      <%= form_with url: user_reassign_point_of_contact_path(@user), method: :patch, local: true do %>
        <%= select_tag :point_of_contact_id,
              options_from_collection_for_select(
                current_tenant.users.taggable.order(:name),
                :id, :name, @user.point_of_contact_id),
              include_blank: "Unassigned",
              class: "form-control form-control-sm",
              onchange: "this.form.requestSubmit()" %>
      <% end %>
    <% else %>
      <p class="mb-0"><%= @user.point_of_contact&.name || "Unassigned" %></p>
    <% end %>
  </div>

  <%= render "operator/users/interest_section", user: @user %>
<% end %>

<div class="row mt-3 mb-2">
  <div class="col-lg-3"></div>
  <div class="col-lg">
    <%= render "shared/notes_section", notable: @user, notable_type: "User" %>
    <%= render "operator/users/conversations_section", user: @user %>
  </div>
  <div class="col-lg-3"></div>
</div>

<%= wide_card do %>
  <%= render "timeline", user: @user, active_tab: @active_tab %>
<% end %>

<%= wide_card do %>
  <h6 class="text-uppercase text-muted mb-2" style="font-size: 11px; letter-spacing: 0.5px;">About</h6>
  <div class="list-group list-group-flush mb-4">
    <%= render "nav_link", label: "About", path: user_about_path(@user), icon: "fa-info-circle" %>
    <%= render "nav_link", label: "Group", path: user_organization_path(@user), icon: "fa-users" %>
  </div>

  <h6 class="text-uppercase text-muted mb-2" style="font-size: 11px; letter-spacing: 0.5px;">Activity</h6>
  <div class="list-group list-group-flush mb-4">
    <%= render "nav_link", label: "Usage", path: user_usage_path(@user), icon: "fa-chart-bar" %>
    <%= render "nav_link", label: "Check-ins", path: user_checkins_path(@user), icon: "fa-door-open" %>
    <% if policy(:childcare).enabled? %>
      <%= render "nav_link", label: "Childcare", path: user_childcare_path(@user), icon: "fa-child" %>
    <% end %>
    <%= render "nav_link", label: "Lifetime Value (LTV)", path: user_ltv_path(@user), icon: "fa-chart-line" %>
  </div>

  <% if policy(:payment).enabled? || policy(:credit).enabled? %>
    <h6 class="text-uppercase text-muted mb-2" style="font-size: 11px; letter-spacing: 0.5px;">Billing</h6>
    <div class="list-group list-group-flush mb-4">
      <% if policy(:credit).enabled? %>
        <%= render "nav_link", label: "Credits", path: user_credits_path(@user), icon: "fa-coins", count: number_with_delimiter(@user.credit_balance) %>
      <% end %>
      <% if policy(:payment).enabled? %>
        <%= render "nav_link", label: "Membership", path: user_membership_path(@user), icon: "fa-id-card", count: @user.subscriptions.active.count %>
        <%= render "nav_link", label: "Day Passes", path: user_admin_day_passes_path(@user), icon: "fa-ticket-alt" %>
        <%= render "nav_link", label: "Invoices", path: user_admin_invoices_path(@user), icon: "fa-file-invoice-dollar", count: @user.invoices.count %>
        <%= render "nav_link", label: "Payment method", path: user_payment_method_path(@user), icon: "fa-credit-card" %>
      <% end %>
    </div>
  <% end %>
<% end %>


<div class="modal fade" id="newModal" tabindex="-1" role="dialog" aria-labelledby="quickActionsTitle">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content">
      <div class="modal-header py-2">
        <h6 class="modal-title mb-0" id="quickActionsTitle">Quick actions for <%= @user.name %></h6>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body p-0">
        <div class="list-group list-group-flush">
          <% if policy(:payment).enabled? %>
            <%= render(Buttons::NewInvoice.new(user: @user, classes: "list-group-item list-group-item-action d-flex align-items-start")) do %>
              <i class="fas fa-dollar-sign text-muted mr-3 mt-1" style="width: 18px;"></i>
              <div>
                <div>Create invoice</div>
                <small class="text-muted">Bill this member for a one-off charge</small>
              </div>
            <% end %>

            <%= render(Buttons::NewDayPass.new(user: @user, classes: "list-group-item list-group-item-action d-flex align-items-start")) do %>
              <i class="fas fa-ticket-alt text-muted mr-3 mt-1" style="width: 18px;"></i>
              <div>
                <div>Add a day pass</div>
                <small class="text-muted">Grant a single-day visit</small>
              </div>
            <% end %>

            <% if @user.has_active_subscription? %>
              <%= link_to subscription_path(@user.subscriptions.active.first), data: { turbo_method: :delete }, class: "list-group-item list-group-item-action d-flex align-items-start" do %>
                <i class="fas fa-times-circle text-danger mr-3 mt-1" style="width: 18px;"></i>
                <div>
                  <div class="text-danger">Cancel membership</div>
                  <small class="text-muted">End this member's active subscription</small>
                </div>
              <% end %>
            <% else %>
              <%= render(Buttons::NewMembership.new(user: @user, classes: "list-group-item list-group-item-action d-flex align-items-start")) do %>
                <i class="fas fa-id-card text-muted mr-3 mt-1" style="width: 18px;"></i>
                <div>
                  <div>Add a membership</div>
                  <small class="text-muted">Subscribe this member to a plan</small>
                </div>
              <% end %>
            <% end %>
          <% end %>

          <% if @user.member_of_organization? %>
            <%= link_to user_remove_from_organization_path(@user), class: "list-group-item list-group-item-action d-flex align-items-start" do %>
              <i class="fas fa-user-minus text-muted mr-3 mt-1" style="width: 18px;"></i>
              <div>
                <div>Remove from <%= @user.organization.name %></div>
                <small class="text-muted">Detach from the parent group</small>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
      <div class="modal-footer py-2">
        <button type="button" class="btn btn-sm btn-outline-secondary" data-dismiss="modal">Cancel</button>
      </div>
    </div>
  </div>
</div>

<% if policy(@user).add_note? %>
  <div class="modal fade" id="addNoteModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered" role="document">
      <div class="modal-content">
        <%= form_with url: user_add_note_path(@user), method: :post, local: true do |f| %>
          <div class="modal-header">
            <h5 class="modal-title">Add note for <%= @user.name %></h5>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
              <span aria-hidden="true">&times;</span>
            </button>
          </div>
          <div class="modal-body">
            <%= f.fields_for :note, Note.new do |note_form| %>
              <%= note_form.rich_text_area :body, placeholder: "Type a note about this person..." %>
            <% end %>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
            <%= f.submit "Add note", class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<% if policy(@user).log_tour? %>
  <div class="modal fade" id="logTourModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered" role="document">
      <div class="modal-content">
        <%= form_with url: user_log_tour_path(@user), method: :post, local: true do |f| %>
          <div class="modal-header">
            <h5 class="modal-title">Log a tour for <%= @user.name %></h5>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
              <span aria-hidden="true">&times;</span>
            </button>
          </div>
          <div class="modal-body">
            <div class="form-group">
              <%= f.label :notes, "Notes (optional)" %>
              <%= f.text_area :notes, class: "form-control", rows: 4, placeholder: "Where did they come from, what did they ask about, etc." %>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
            <%= f.submit "Log", class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
