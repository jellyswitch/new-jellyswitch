<% title "Check-ins" %>

<%= render "shared/back_bar", back_path: user_path(@user), back_label: @user.name, page_title: "Check-ins" %>

<div class="row mt-0 mb-0">
  <div class="col-lg-3"></div>
  <div class="col-lg-6 m-0 pl-0 pr-0">
    <%= list_wrapper do %>
      <%= list_item do %>
        
        <%= render "checkins", user: @user %>
        
      <% end %>
    <% end %>
  </div>
  <div class="col-lg-3"></div>
</div>

