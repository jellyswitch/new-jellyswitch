<%= javascript_include_tag "stripe_handler.js" %>

<div class="row mt-3 mb-3">
  <div class="col-sm-3"></div>
  <div class="card col-sm bg-light p-3">
    <div class="card-body">
      <h4 class="display-4 text-center mt-4 card-title">
        Update billing information<% if @user && @user != current_user %> for <%= @user.name %><% end %>
      </h4>
      <p class="lead text-center mb-3 mt-3">
        To replace
        <%= @user && @user != current_user ? "#{@user.name}'s" : "your" %>
        current card on file, please enter the credit card information below.
      </p>
      <%= form_with(url: user_billing_path(@user || current_user), html: {id: "stripe-form" }) do |f| %>
        <div class="form-group row">
          <div class="col-1"></div>
            <%= render "shared/billing" %>
          <div class="col-1"></div>
        </div>
        <div class="form-group row">
          <div class="col-1"></div>
            <button class="form-control btn btn-primary col" id="stripe-submit" data-disable-with="Updating...">
              Update
            </button>
          <div class="col-1"></div>
        </div>
      <% end %>
    </div>
  </div>
  <div class="col-sm-3"></div>
</div>
