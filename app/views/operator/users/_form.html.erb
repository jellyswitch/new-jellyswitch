<%= form_with(model: @user, local: true) do |f| %>
  <%= render "shared/error_messages" , model: @user %>
  <div class="form-group row">
    <div class="col-1"></div>
    <%= f.text_field :name, placeholder: "Name *", class: "form-control col", required: true %>
    <div class="col-1"></div>
  </div>
  <div class="form-group row">
    <div class="col-1"></div>
    <%= f.email_field :email, placeholder: "Email *", class: "form-control col", required: true %>
    <div class="col-1"></div>
  </div>
  <div class="form-group row">
    <div class="col-1"></div>
    <%= f.telephone_field :phone, placeholder: "Phone Number *", class: "form-control col", required: true %>
    <div class="col-1"></div>
  </div>
  <div class="form-group row">
    <div class="col-1"></div>
    <%= f.password_field :password, placeholder: "Password (min 6 characters) *", class: "form-control col", required: true, minlength: 6 %>
    <div class="col-1"></div>
  </div>
  <div class="form-group row">
    <div class="col-1"></div>
    <%= f.password_field :password_confirmation, placeholder: "Confirm password *", class: "form-control col", required: true %>
    <div class="col-1"></div>
  </div>
  <div class="form-group row mb-0">
    <div class="col-1"></div>
    <%= f.label :original_location_id, "Main location", class: "col p-0 m-0" %>
    <div class="col-1"></div>
  </div>
  <div class="form-group row">
    <div class="col-1"></div>
    <%= f.select :original_location_id, options_for_select(current_tenant.locations.map { |l| ["#{l.name} - #{l.full_address}", l.id] }, current_location&.id || current_tenant.locations.first&.id), {}, class: "form-control col" %>
    <div class="col-1"></div>
  </div>
  <div class="form-group row">
    <div class="col-1"></div>
    <div class="form-check col">
      <%= f.check_box :marketing_consent, class: "form-check-input", id: "marketing_consent" %>
      <%= f.label :marketing_consent, "I'd like to receive events and special promotions", class: "form-check-label", for: "marketing_consent" %>
    </div>
    <div class="col-1"></div>
  </div>
  <% if current_tenant.terms_of_service.attached? %>
    <div class="form-group row">
      <div class="col-1"></div>
      <div class="col d-flex align-items-center" style="gap: 8px;">
        <%= f.check_box :terms_accepted, id: "terms_accepted", required: true, style: "width: 22px; height: 22px; min-width: 22px; margin: 0; cursor: pointer;" %>
        <label for="terms_accepted" style="margin: 0; cursor: pointer;">I agree to the</label>
        <a href="#" data-toggle="modal" data-target="#termsModal">Terms of Use</a>
      </div>
      <div class="col-1"></div>
    </div>

    <div class="modal fade" id="termsModal" tabindex="-1" role="dialog" aria-labelledby="termsModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="termsModalLabel">Terms of Use</h5>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
              <span aria-hidden="true">&times;</span>
            </button>
          </div>
          <div class="modal-body">
            <iframe src="<%= url_for(current_tenant.terms_of_service) %>" width="100%" height="500" frameborder="0" style="border: none;"></iframe>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-primary" data-dismiss="modal">Close</button>
          </div>
        </div>
      </div>
    </div>
  <% end %>
  <!-- Honeypot field - hidden from real users, filled by bots -->
  <div style="position: absolute; left: -9999px; top: -9999px;" aria-hidden="true">
    <%= f.text_field :website_url, tabindex: "-1", autocomplete: "off" %>
  </div>
  <!-- reCAPTCHA v3 hidden token -->
  <%= f.hidden_field :recaptcha_token, id: "recaptcha_token" %>
  <div class="form-group row">
    <div class="col-1"></div>
    <%= f.submit label, class: "form-control btn btn-primary col", id: "signup_submit", data: { acc: 'register' } %>
    <div class="col-1"></div>
  </div>
  <% if ENV['RECAPTCHA_SITE_KEY'].present? %>
    <script>
      // Pre-load reCAPTCHA token so form can submit normally
      (function() {
        function refreshToken() {
          grecaptcha.ready(function() {
            grecaptcha.execute('<%= ENV["RECAPTCHA_SITE_KEY"] %>', {action: 'signup'}).then(function(token) {
              var field = document.getElementById('recaptcha_token');
              if (field) field.value = token;
            });
          });
        }
        // Get token immediately
        refreshToken();
        // Refresh token every 90 seconds (tokens expire after 2 minutes)
        setInterval(refreshToken, 90000);
      })();
    </script>
  <% end %>
<%- end %>
