<% title "Invoices" %>

<%= render "shared/back_bar", back_path: user_path(@user), back_label: @user.name, page_title: "Invoices" %>

<div class="row mt-0 mb-0">
  <div class="col-lg-3"></div>
  <div class="col-lg-6 m-0 pl-0 pr-0">
    <%= list_wrapper do %>
      <%= list_item do %>
        
          <div class="card-body list-group list-group-flush p-0">
          <% if policy(:invoice).new? %>
            <%= render(Buttons::NewInvoice.new(user: @user, classes: "btn btn-primary btn-block")) do %>
              <i class="fas fa-dollar-sign"></i>
              &nbsp;
              New Invoice
            <% end %>
          <% end %>

            <%= render "invoices", user: @user %>
          </div>
        
      <% end %>
    <% end %>
  </div>
  <div class="col-lg-3"></div>
</div>