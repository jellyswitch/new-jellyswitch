<%# Full door-access history (newest first). Pulled out of "Recent" so the
    timeline isn't flooded with door punches; Recent keeps only the first punch
    after each join/payment milestone. %>
<% activities = user.activities.where(kind: "door_punch").recent.limit(100) %>
<% if activities.any? %>
  <% activities.each do |activity| %>
    <%= render "timeline_activity_row", activity: activity %>
  <% end %>
<% else %>
  <p class="text-muted text-center py-3 mb-0">No door access yet.</p>
<% end %>
