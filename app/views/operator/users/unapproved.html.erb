<% title "Approval Queue" %>

<%= render "shared/back_bar", back_path: members_groups_path, back_label: "Members & Groups", page_title: "Approval Queue" %>

<div class="row mt-1 mb-0 p-0">
  <div class="col-lg-3"></div>
  <div class="col-lg-6 m-0 p-0">
    <%= list_wrapper do %>
      <%= list_item do %>
      <% end %>

      <% if @users.count < 1 %>
        <%= list_item do %>
          <p class="text-center text-muted">Your approval queue is empty.</p>
        <% end %>
      <% else %>
        <% @users.each do |user| %>
          <%= render "approval_card", user: user %>
        <% end %>
      <% end %>
    <% end %>
  </div>
  <div class="col-lg-3"></div>
</div>