<% title "My Reservations" %>

<%= render "shared/back_bar", back_path: user_reservations_path(@user), back_label: "My Reservations", page_title: "Past Reservations" %>

<%= render Layout::FullWidth.new do %>
  <%= list_item do %>
  <% end %>

  <% if @reservations.count < 1 %>
    <%= list_item do %>
      <p class="lead text-center">No past reservations.</p>
    <% end %>
  <% else %>
    <% @reservations.each do |res_hash| %>
      <%= render Reservations::DayList.new(reservation_hash: res_hash) %>
    <% end %>
  <% end %>
<% end %>
