<% title "Credits" %>

<%= render "shared/back_bar", back_path: user_path(@user), back_label: @user.name, page_title: "Credits" %>

<%= render Layout::FullWidth.new do %>
  <%= list_item do %>

    <div class="row">
      <div class="col">
        Current balance:
        &nbsp;
        <%= render CreditAmount.new(amount: @user.credit_balance) %>
      </div>
    </div>
  <% end %>

  <%= list_item do %>
    <%= form_with(url: user_add_credits_path, method: :post, class: 'form') do |f| %>
      <div class="form-group">
        <%= f.number_field :amount, placeholder: "Number of credits", class: "form-control" %>
      </div>

      <%= f.submit "Add Credits", class: "btn btn-primary btn-block" %>
    <% end %>
  <% end %>
<% end %>