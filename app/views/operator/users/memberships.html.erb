<% title "My Membership" %>

<%= breadcrumb do %>
  <li class="breadcrumb-item"><%= link_to "My Account", user_path(@user) %></li>
  <li class="breadcrumb-item">My Membership</li>
<% end %>

<%= render Layout::FullWidth.new do %>
  <%= list_item do %>
    <h4 class="display-4 text-center">My Membership</h4>
  <% end %>

  <% active_subs = @user.subscriptions.for_operator(current_tenant).active %>
  <% if active_subs.empty? %>
    <%= list_item do %>
      <p class="text-center text-muted">No active membership.</p>
      <% if current_user.admin_or_manager?(current_location) %>
        <%= link_to "Add membership", new_operator_admin_subscription_path(user_id: @user.id), class: "btn btn-block btn-primary" %>
      <% end %>
    <% end %>
  <% end %>

  <% pending_subs = @user.subscriptions.for_operator(current_tenant).where(pending: true) %>
  <% if pending_subs.any? && current_user.admin_or_manager?(current_location) %>
    <%= list_item do %>
      <p class="text-muted text-center">You have a stuck pending membership blocking new signups.</p>
      <% pending_subs.each do |sub| %>
        <%= link_to "Remove pending #{sub.plan&.name || 'membership'}", operator_admin_subscription_path(sub), data: { turbo_method: :delete, confirm: "Remove this stuck pending membership?" }, class: "btn btn-block btn-outline-danger mb-2" %>
      <% end %>
    <% end %>
  <% end %>

  <% @user.subscriptions.order('created_at DESC').each do |subscription| %>
    <%= list_item do %>
      <%= render "operator/subscriptions/membership_card", subscription: subscription %>
    <% end%>
  <% end %>
<% end %>
