<% title "My Invoices" %>

<%= render "shared/back_bar", back_path: user_path(@user), back_label: "My Account", page_title: "My Invoices" %>

<%= wide_card do %>
  <ul class="list-group list-group-flush">
    <% @invoices.each do |invoice| %>
      <%= render "invoice", invoice: invoice %>
    <% end %>
  </ul>
<% end %>