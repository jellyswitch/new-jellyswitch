<%- if policy(:user).show? %>
  <a class="list-group-item list-group-item-action d-flex align-items-center py-3" href="<%= user_path(user) %>" <% if index == 0 %>style="border-top: 0;"<% end %>>
<%- else %>
  <li class="list-group-item d-flex align-items-center py-3" <% if index == 0 %>style="border-top: 0;"<% end %>>
<%- end %>

  <div class="mr-3 flex-shrink-0" style="width: 44px;">
    <%= render "shared/small_profile_photo", user: user %>
  </div>

  <div class="flex-grow-1" style="min-width: 0;">
    <div class="font-weight-bold text-dark text-truncate"><%= user.name %></div>
    <div class="mt-1">
      <% if policy(:payment).enabled? && user.member_at_operator?(current_tenant) %>
        <% if user.has_active_subscription? %>
          <span class="badge badge-success">Member</span>
        <% end %>
        <% if user.has_active_day_pass? %>
          <span class="badge badge-primary">Day Pass</span>
        <% end %>
        <% if user.has_active_lease? %>
          <span class="badge badge-info">Office Lease</span>
        <% end %>
      <% end %>
      <% if policy(:payment).enabled? && user.pending? %>
        <span class="badge badge-warning">Pending</span>
      <% end %>
      <small class="text-muted ml-1">Joined <%= user.created_at.strftime("%b %Y") %></small>
    </div>
  </div>

  <% if policy(:user).show? %>
    <i class="fas fa-chevron-right text-muted flex-shrink-0 ml-2"></i>
  <% end %>

<% if policy(:user).show? %>
  </a>
<% else %>
  </li>
<% end %>
