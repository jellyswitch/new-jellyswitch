<% title "Invoices" %>

<%= render "shared/back_bar", back_path: organization_path(@organization), back_label: @organization.name, page_title: "Invoices" %>

<div class="row mt-0 mb-0">
  <div class="col-lg-3"></div>
  <div class="col-lg-6 m-0 pl-0 pr-0">
    <%= list_wrapper do %>
      <%= list_item do %>

          <div class="card-body list-group list-group-flush p-0">
            <% if @organization.has_billing_for_location?(current_location) || @organization.out_of_band? %>
              <%= link_to new_invoice_path(organization_id: @organization.id), class: "btn btn-block btn-primary" do %>
                <i class="fas fa-dollar-sign"></i>
                &nbsp;
                New Invoice
              <% end %>
            <% else %>
              <%= link_to "Create new invoice", new_invoice_path(organization_id: @organization.id), class: "btn btn-block btn-primary disabled" %>
              <div class="text-center">
                <small>Set a payment method to create a new invoice</small>
              </div>
            <% end %>
            <%= render partial: "operator/invoices/invoice", collection: @organization.invoices, as: :invoice %>
          </div>

      <% end %>
    <% end %>
  </div>
  <div class="col-lg-3"></div>
</div>

