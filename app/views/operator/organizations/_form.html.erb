<% users = User.lease_options_for_select(current_tenant, current_location) %>

<%= form_for(@organization) do |f| %>
  <%= render "shared/error_messages" , model: @organization %>

  <div class="form-group">
    <%= f.label :name %>
    <%= f.text_field :name, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= f.label :website %>
    <%= f.text_field :website, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= f.label :owner %>
    <input type="text" class="form-control" list="owner-options" id="owner-input"
      placeholder="Type to search members..."
      value="<%= users.find { |name, id| id == @organization.owner_id }&.first %>">
    <datalist id="owner-options">
      <% users.each do |name, id| %>
        <option value="<%= name %>" data-id="<%= id %>">
      <% end %>
    </datalist>
    <%= f.hidden_field :owner_id, id: "owner-hidden-id" %>
  </div>

  <div class="form-group">
    <%= f.label :billing_contact %>
    <input type="text" class="form-control" list="billing-contact-options" id="billing-contact-input"
      placeholder="Type to search members..."
      value="<%= users.find { |name, id| id == @organization.billing_contact_id }&.first %>">
    <datalist id="billing-contact-options">
      <% users.each do |name, id| %>
        <option value="<%= name %>" data-id="<%= id %>">
      <% end %>
    </datalist>
    <%= f.hidden_field :billing_contact_id, id: "billing-contact-hidden-id" %>

    <% active_subs = @organization.active_subscriptions %>
    <% active_leases = @organization.active_leases %>
    <% if active_subs.any? || active_leases.any? %>
      <div class="mt-2 small text-muted">
        <i class="fas fa-info-circle"></i>
        Changing the billing contact will route future charges on the following to the new contact's card:
        <ul class="mb-0 mt-1">
          <% active_subs.each do |subscription| %>
            <li><%= link_to "#{subscription.subscribable.name}'s #{subscription.plan.name} Membership", user_membership_path(user_id: subscription.subscribable) %></li>
          <% end %>
          <% active_leases.each do |office_lease| %>
            <li><%= link_to "#{office_lease.subscription.subscribable.name}'s Office Lease ending #{office_lease.pretty_date}", office_lease_path(office_lease) %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </div>

  <div class="form-check mb-3">
    <%= f.check_box :visible, class: "form-check-input" %>
    <%= f.label :visible, "Check this box if you want this group to be visible", class: "form-check-label" %>
  </div>

  <%= f.submit label, class: "form-control btn btn-primary mb-2" %>
<% end %>

<script>
  (function() {
    function setupDatalistSync(inputId, datalistId, hiddenId) {
      var input = document.getElementById(inputId);
      var hidden = document.getElementById(hiddenId);
      if (!input || !hidden) return;

      input.addEventListener("input", function() {
        var opts = document.querySelectorAll("#" + datalistId + " option");
        hidden.value = "";
        opts.forEach(function(opt) {
          if (opt.value === input.value) {
            hidden.value = opt.dataset.id;
          }
        });
      });
    }

    setupDatalistSync("owner-input", "owner-options", "owner-hidden-id");
    setupDatalistSync("billing-contact-input", "billing-contact-options", "billing-contact-hidden-id");
  })();
</script>
