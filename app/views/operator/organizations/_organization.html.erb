<%= list_item do %>
  <div class="row">
    <div class="col">
      <h5 class="display-5 text-center"><%= organization.name %></h5>
    </div>
  </div>
  <div class="row">
    <div class="col">
      <%# Imported groups (e.g. the TLH OfficeRnD import) can be ownerless —
          the association is optional, so mirror show.html.erb's guard. %>
      <% if organization.owner %>
        Owned by <%= link_to organization.owner.name, organization.owner %>
      <% else %>
        <span class="text-muted">No owner assigned</span>
      <% end %>
    </div>
  </div>
  <% if view %>
    <div class="row mt-3">
      <div class="col">
        <%= link_to 'View', organization, class: "btn btn-block btn-primary" %>
      </div>
    </div>
  <% end %>
<% end %>