
<%- title "Groups" %>

<%= render "shared/back_bar", back_path: members_groups_path, back_label: "Members & Groups", page_title: "Groups" %>

<div class="row mt-0 mb-0 p-0">
  <div class="col-lg-3"></div>
  <div class="col-lg-6 m-0 p-0">
    <%= list_wrapper do %>
      <%= list_item do %>

        <% if policy(Organization).new? %>
          <%= link_to "Add a new group", new_organization_path, class: "btn btn-block btn-primary" %>
        <% end %>
      
      <% end %>

      <%= render partial: "operator/organizations/organization", collection: @organizations, as: :organization, locals: { view: true } %>

      <div class="mt-4 mb-4">
        <%= list_item do %>
          <h4 class="display-4 text-center">Archived</h4>
          <%= render partial: "operator/organizations/organization", collection: @archived_organizations, as: :organization, locals: { view: true } %>    
        <% end %>
      </div>

    <% end %>
  </div>
  <div class="col-lg-3"></div>
</div>
