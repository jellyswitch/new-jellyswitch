
<% title "Community" %>

<%= render "operator/events/apps" %>

<div class="row mt-0 mb-0 p-0">
  <div class="col-lg-3"></div>
  <div class="col-lg-6 m-0 p-0">
    <%= list_wrapper do %>
      <%# Community lander mirrors the mobile EventsScreen — Bulletin Board %>
      <%# tile on top, conditional "Propose Event" for members + lease     %>
      <%# holders, then the upcoming-events list. Used to live as separate %>
      <%# hamburger entries (Bulletin Board + Events); consolidated here   %>
      <%# so members get one front door.                                    %>
      <% if policy(:post).enabled? %>
        <%= link_to posts_path, class: "list-group-item list-group-item-action d-flex align-items-center m-0" do %>
          <span style="font-size: 28px; margin-right: 12px;">📝</span>
          <div style="flex: 1;">
            <div style="font-weight: 600;">Bulletin Board</div>
            <small class="text-muted">Community posts</small>
          </div>
          <i class="fas fa-chevron-right text-muted"></i>
        <% end %>
      <% end %>

      <% if policy(Event).new? %>
        <% is_admin = current_user&.admin_or_manager?(current_location) || current_user&.superadmin? %>
        <%= link_to new_event_path, class: "list-group-item list-group-item-action d-flex align-items-center m-0" do %>
          <span style="font-size: 28px; margin-right: 12px;">✨</span>
          <div style="flex: 1;">
            <div style="font-weight: 600;">
              <%= is_admin ? "Create an Event" : "Propose an Event" %>
            </div>
            <small class="text-muted">
              <%= is_admin ? "Publishes immediately" : "Subject to approval" %>
            </small>
          </div>
          <i class="fas fa-chevron-right text-muted"></i>
        <% end %>
      <% end %>

      <%= list_item do %>
        <h4 class="display-4 text-center">Upcoming Events</h4>
        <div class="text-center">
          <small>(Showing events scheduled at <%= current_location.name %>)</small>
        </div>
      <% end %>

      <%= link_to past_events_path, class: "list-group-item list-group-item-action d-flx m-0" do %>
        <div class="row">
          <div class="col-11">
            <i class="fas fa-history"></i>
            &nbsp;
            Past Events
          </div>
          <div class="col-1">
            <i class="fas fa-chevron-right"></i>
          </div>
        </div>
      <% end %>

      <%= render "events_list", events: @events %>

    <% end %>
  </div>
  <div class="col-lg-3"></div>
</div>
