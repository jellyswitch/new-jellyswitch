
<% title "New Event" %>

<%= render "shared/back_bar", back_path: events_path, back_label: "Events", page_title: "New Event" %>

<div class="row mt-1 mb-0 p-0">
  <div class="col-lg-3"></div>
  <div class="col-lg-6 m-0 p-0">
    <%= list_wrapper do %>
      <%= list_item do %>

        <%= form_with(model: @event, local: true, html: {class: "form", multipart: true}, data: {type: :html}) do |f| %>
          <%= render "form", event: @event, f: f %>

          <div class="form-group row m-0 p-0">
            <button class="form-control btn btn-primary col" id="submit" data-disable-with="Creating...">
              <i class="far fa-calendar-alt"></i>      
              &nbsp;
              Create event
            </button>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>
  <div class="col-lg-3"></div>
</div>
