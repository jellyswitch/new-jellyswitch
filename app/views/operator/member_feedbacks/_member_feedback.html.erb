<% latest_reply = member_feedback.feedback_replies.max_by(&:created_at) %>
<% preview = member_feedback.comment.presence || latest_reply&.body %>
<% reply_count = member_feedback.feedback_replies.size %>

<div id="<%= dom_id(member_feedback) %>" class="list-group-item d-flex justify-content-between align-items-center">
  <%= link_to member_feedback_path(member_feedback), class: "text-decoration-none text-dark flex-grow-1 mr-3", style: "min-width: 0;" do %>
    <div class="font-weight-bold mb-1 text-truncate"><%= member_feedback.user&.name %></div>
    <p class="mb-1 text-truncate text-muted"><%= truncate(preview.to_s, length: 100) %></p>
    <small class="text-muted">
      <%= time_ago_in_words(member_feedback.updated_at) %> ago
      <% if reply_count > 0 %>
        &middot; <%= reply_count %> <%= "message".pluralize(reply_count) %>
      <% end %>
    </small>
  <% end %>

  <%= button_to dismiss_member_feedback_path(member_feedback),
        method: :post,
        class: "btn btn-sm btn-outline-secondary flex-shrink-0",
        form_class: "mb-0",
        form: { data: { turbo_confirm: "Dismiss this conversation? You can restore it later from the member's page." } },
        title: "Dismiss conversation",
        aria: { label: "Dismiss conversation" } do %>
    <i class="fas fa-times"></i>
  <% end %>
</div>
