<% title "Conversation" %>

<% if current_user.admin_or_manager?(current_location) %>
  <%= render "shared/back_bar", back_path: member_feedbacks_path, back_label: "Messages", page_title: "Conversation" %>
<% else %>
  <%= render "shared/back_bar", back_path: root_path, back_label: "Home", page_title: "Conversation" %>
<% end %>

<% is_admin = current_user.admin_or_manager?(current_location) %>
<%# Compute unread status BEFORE we render — mark_as_read! runs in the
    controller after this view loads, but on first paint the unread reply
    should glow so the member can spot it instantly. %>
<% last_read = @member_feedback.last_read_at %>

<%= render Layout::FullWidth.new do %>
  <%= list_item do %>
    <div class="feedback-chat" id="feedback-chat">
      <%# Original feedback message (always from the member). Skip the
          bubble when the comment is blank — that's the "host messaged
          first" case, where the conversation should start with the
          host's FeedbackReply rather than an empty member bubble. %>
      <% if @member_feedback.comment.to_s.strip.present? %>
        <div class="chat-bubble <%= is_admin ? 'chat-bubble-other' : 'chat-bubble-mine' %>">
          <div class="chat-body"><%= simple_format(@member_feedback.comment) %></div>
          <div class="chat-meta">
            <%= is_admin ? "Member" : "You" %>
            &middot; <%= time_ago_in_words(@member_feedback.created_at) %> ago
          </div>
        </div>
      <% end %>

      <%# Replies %>
      <% @feedback_replies.each do |reply| %>
        <% is_mine = (reply.from_admin? && is_admin) || (!reply.from_admin? && !is_admin) %>
        <% unread_for_member = !is_admin && reply.from_admin? && (last_read.nil? || reply.created_at > last_read) %>
        <div class="chat-bubble <%= is_mine ? 'chat-bubble-mine' : 'chat-bubble-other' %> <%= 'chat-bubble--unread' if unread_for_member %>">
          <div class="chat-body"><%= simple_format(reply.body) %></div>
          <div class="chat-meta">
            <% if is_mine %>
              You
            <% elsif reply.from_admin? %>
              <%= reply.user.name %>
            <% else %>
              Member
            <% end %>
            &middot; <%= time_ago_in_words(reply.created_at) %> ago
            <% if unread_for_member %>
              &middot; <span class="text-warning"><strong>New</strong></span>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <%# Reply form. Use a <button> (rather than <input type="submit">) and
        an oversized hit area — Jamie reported the previous "Send" only
        registered taps on a small sliver inside the visual button on iOS
        WKWebView. min-height: 56px clears the Apple HIG 44pt touch target
        comfortably; the inner span keeps the visual label centered. %>
    <%= form_with url: reply_member_feedback_path(@member_feedback), scope: :feedback_reply, method: :post, local: true do |f| %>
      <div class="feedback-reply-form mt-3">
        <%= f.text_area :body,
              placeholder: "Type a reply...",
              class: "form-control",
              rows: 3,
              required: true,
              id: "reply-body" %>
        <button type="submit"
                id="reply-submit"
                class="btn btn-primary btn-block btn-lg mt-2 feedback-reply-form__send">
          <i class="fas fa-paper-plane mr-2"></i>Send
        </button>
      </div>
    <% end %>
  <% end %>
<% end %>

<style>
  .feedback-chat {
    padding: 10px 0;
    display: flex;
    flex-direction: column;
  }
  .chat-bubble {
    max-width: 80%;
    padding: 10px 14px;
    border-radius: 16px;
    margin-bottom: 10px;
    word-wrap: break-word;
  }
  .chat-bubble p {
    margin-bottom: 0;
  }
  .chat-bubble-mine {
    background: var(--brand-color, #007bff);
    color: #fff;
    align-self: flex-end;
    border-bottom-right-radius: 4px;
  }
  .chat-bubble-other {
    background: #f1f1f1;
    color: #333;
    align-self: flex-start;
    border-bottom-left-radius: 4px;
  }
  .chat-bubble--unread {
    box-shadow: 0 0 0 2px #ffc107, 0 2px 8px rgba(255, 193, 7, 0.25);
  }
  .chat-meta {
    font-size: 11px;
    margin-top: 4px;
    opacity: 0.7;
  }
  .chat-bubble-mine .chat-meta {
    color: rgba(255,255,255,0.8);
  }
  .feedback-reply-form {
    background: #fff;
    padding-top: 8px;
    /* Was position: sticky; bottom: 0 — collided with the mobile app's
       fixed bottom tab bar (z-index 1050), which sat right on top of the
       Send button so only a thin slice above the tab bar was clickable.
       Static positioning keeps the form at the end of the conversation
       and avoids the overlap. */
  }
  .feedback-reply-form__send {
    min-height: 56px;          /* generous touch target on iOS / Android */
    font-size: 1rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .feedback-reply-form__send i { font-size: 0.95em; }
  @media (max-width: 768px) {
    .chat-bubble {
      max-width: 90%;
    }
  }
</style>

<script>
  // Drop the user onto the unread reply rather than the original message —
  // mark_as_read! fires after this page renders, so the .chat-bubble--unread
  // marker still exists on the DOM at load time.
  document.addEventListener("DOMContentLoaded", function () {
    var unread = document.querySelector(".chat-bubble--unread");
    if (unread) unread.scrollIntoView({ block: "center" });
  });
</script>
