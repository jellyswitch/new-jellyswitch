<% title "Customization" %>

<%= render(Layout::FullWidth.new) do %>
  <%= list_wrapper do %>
    <%= list_item do %>
      <h4 class="display-4 text-center">Modules</h4>
      <p>
        Enable and disable various modules of your Jellyswitch app.
      </p>
      <%= link_to "View Modules", modules_path, class: "btn btn-block btn-primary" %>
    <% end %>

    <%= list_item do %>
      <h4 class="display-4 text-center">Global Settings</h4>

      <p>
        Set up your account name, homepage description, enable the approval queue, required check-ins, and more.
      </p>

      <%= link_to "Customize Jellyswitch", operator_path(current_tenant, subdomain: current_tenant.subdomain), class: "btn btn-block btn-primary" %>
    <% end %>

    <%= list_item do %>
      <h4 class="display-4 text-center">Notification Settings</h4>

      <p>
        Customize what shows up in your team's feed and which events trigger push notifications.
      </p>

      <%= link_to "Configure Notifications", notifications_path, class: "btn btn-block btn-primary" %>
    <% end %>
  
    <%= list_item do %>
      <h4 class="display-4 text-center">Location Settings</h4>

      <p>
        Add, remove, and update settings on a per-location basis.
      </p>

      <%= link_to "Customize Locations", locations_path, class: "btn btn-primary btn-block" %>
    <% end %>

    <%= list_item do %>
      <h4 class="display-4 text-center">Integrations</h4>

      <p>
        Connect external services like Mailchimp for email marketing.
      </p>

      <%= form_with(model: current_tenant, url: operator_path(current_tenant), method: :patch, local: true) do |f| %>
        <div class="form-group">
          <%= f.label :mailchimp_api_key, "Mailchimp API Key" %>
          <%= f.text_field :mailchimp_api_key, class: "form-control", placeholder: "Enter your Mailchimp API key" %>
          <small class="form-text text-muted">Found in Mailchimp under Account > Extras > API Keys</small>
        </div>
        <div class="form-group">
          <%= f.label :mailchimp_audience_id, "Mailchimp Audience ID" %>
          <%= f.text_field :mailchimp_audience_id, class: "form-control", placeholder: "Enter your audience/list ID" %>
          <small class="form-text text-muted">Found in Mailchimp under Audience > Settings > Audience name and defaults</small>
        </div>
        <%= f.submit "Save Integration Settings", class: "btn btn-primary btn-block" %>
      <% end %>

      <% if current_tenant.mailchimp_api_key.present? && current_tenant.mailchimp_audience_id.present? %>
        <hr/>
        <p class="text-muted small">Mailchimp is connected. Members are synced with tags: member, day_pass, room_booker, pending, inactive.</p>
        <%= link_to "Sync All Members Now", "#", class: "btn btn-outline-secondary btn-sm", data: { turbo_method: :post, turbo_confirm: "Sync all members to Mailchimp?" }, id: "mailchimp-sync-btn" %>
      <% end %>
    <% end %>
  <% end %>
<% end %>