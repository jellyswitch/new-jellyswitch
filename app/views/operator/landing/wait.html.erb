<% title "Awaiting Approval" %>

<div class="row mt-3" data-controller="approval-poll" data-approval-poll-url-value="/approval_status">
  <div class="col-sm-3"></div>
  <div class="col-sm">
    <div class="jumbotron bg-white pb-4 pt-4">
      <h4 class="display-4 text-center mt-2">We're excited you're here!</h4>
      <p class="lead text-center mb-4 mt-3">
        Your account is being reviewed. We'll notify you as soon as you're approved.
      </p>

      <%# Progress indicators %>
      <div class="px-3 mb-4">
        <% pending_sub = current_user.subscriptions.pending.first %>
        <% has_billing = current_user.has_billing_for_location?(current_location) %>

        <div class="d-flex align-items-center mb-2">
          <span class="text-success mr-2" style="font-size: 18px;">&#10003;</span>
          <span>Account created</span>
        </div>

        <div class="d-flex align-items-center mb-2">
          <span class="text-success mr-2" style="font-size: 18px;">&#10003;</span>
          <span>Email confirmed</span>
        </div>

        <% if pending_sub %>
          <div class="d-flex align-items-center mb-2">
            <span class="text-success mr-2" style="font-size: 18px;">&#10003;</span>
            <span>Plan selected: <strong><%= pending_sub.plan.name %></strong></span>
          </div>
        <% else %>
          <div class="d-flex align-items-center mb-2">
            <span class="text-muted mr-2" style="font-size: 18px;">&#9675;</span>
            <span class="text-muted">
              No plan selected yet —
              <%= link_to "browse options", choose_path %>
            </span>
          </div>
        <% end %>

        <% if has_billing %>
          <div class="d-flex align-items-center mb-2">
            <span class="text-success mr-2" style="font-size: 18px;">&#10003;</span>
            <span>Payment method added</span>
          </div>
        <% elsif pending_sub %>
          <div class="d-flex align-items-center mb-2">
            <span class="text-muted mr-2" style="font-size: 18px;">&#9675;</span>
            <span class="text-muted">
              Payment method needed —
              <%= link_to "add now", activate_path %>
            </span>
          </div>
        <% end %>

        <div class="d-flex align-items-center mb-2">
          <div class="spinner-grow spinner-grow-sm text-warning mr-2" role="status">
            <span class="sr-only">Waiting...</span>
          </div>
          <span class="text-warning font-weight-bold">Awaiting approval</span>
        </div>
      </div>

      <hr/>

      <p class="text-center text-muted mt-3" style="font-size: 14px;">
        Need to get started right away? Reach out to us:
      </p>
      <p class="text-center">
        <% if current_tenant.contact_email.present? %>
          <%= mail_to current_tenant.contact_email, current_tenant.contact_name || current_tenant.contact_email, class: "btn btn-outline-primary btn-sm" %>
        <% end %>
        <% if current_tenant.contact_phone.present? %>
          <%= link_to current_tenant.contact_phone, "tel:#{current_tenant.contact_phone}", class: "btn btn-outline-primary btn-sm" %>
        <% end %>
      </p>
    </div>
  </div>
  <div class="col-sm-3"></div>
</div>
