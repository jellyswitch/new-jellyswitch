<% title @title %>

<%= render "shared/back_bar", back_path: accounting_index_path, back_label: "Invoices & Expenses", page_title: @title %>

<%= wide_card do %>
  <%= render "operator/invoices/nav" %>
  <ul class="list-group list-group-flush">
    <%= render partial: "operator/invoices/invoice", collection: @invoices, as: :invoice %>
  </ul>
  <div class="mt-2">
    <%== pagy_bootstrap_nav(@pagy) %>
  </div>
<% end %>
