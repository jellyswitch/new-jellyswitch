<%= javascript_include_tag "stripe_handler.js" %>

<%= form_for(day_pass, html: { class: "form", id: "stripe-form"}) do |f| %>
  <%# N-Pack bundles are redeemed later (one pass per visit), so no purchase
      date applies — showing the date picker is what led buyers to check out a
      bundle as a single dated pass. Hide it for bundle SKUs. %>
  <% unless @day_pass_type&.bundle? %>
    <div class="form-group row">
      <div class="col-1"></div>
      <%# Next year appears only from October, when buying into January is
          plausible. The rest of the year a single-option year select makes the
          "today's date, next year" mis-tap impossible (a member paid $40 for a
          pass dated a year out). Server enforces DayPass::MAX_ADVANCE_DAYS. %>
      <%= f.date_select :day, {
        default: Time.zone.today,
        order: [:month, :day, :year],
        start_year: Time.zone.today.year,
        end_year: Time.zone.today.year + (Time.zone.today.month >= 10 ? 1 : 0)
      }, class: "form-control form-control-sm col ml-1 mr-1" %>
      <div class="col-1"></div>
    </div>
  <% end %>

  <% if @day_pass_type %>
    <dl class="row">
      <dt class="col-6">Selected day pass:</dt>
      <dd class="col-6"><%= @day_pass_type.name.capitalize %></dd>
    </dl>

    <dl class="row">
      <dt class="col-6">Price:</dt>
      <dd class="col-6">
        <span class="text-success font-weight-bold"><%= number_to_currency(dollar_amount(@day_pass_type.amount_in_cents)) %></span>
      </dd>
    </dl>

    <% if @day_pass_type.bundle? %>
      <dl class="row">
        <dt class="col-6">Day passes included:</dt>
        <dd class="col-6"><%= @day_pass_type.quantity %></dd>
      </dl>
      <p class="text-muted small text-center">No date needed — redeem these passes any day, one per visit.</p>
    <% end %>
    <%= f.hidden_field :day_pass_type, value: @day_pass_type.id %>
  <% else %>
    <div class="form-group row">
      <div class="col-1"></div>
        <%= f.select :day_pass_type, day_pass_type_options(DayPassType.options_for_select(current_tenant)), {}, { class: "form-control form-control-sm col ml-1 mr-1" } %>
      </div>
      <div class="col-1"></div>
    </div>
  <% end %>

  <%= f.hidden_field :user_id, value: user.id %>

  <% if !user.has_billing_for_location?(current_location) && !user.bill_to_organization? %>
    <div class="form-group row">
      <div class="col-1"></div>
      <%= render "shared/billing" %>
      <div class="col-1"></div>
    </div>
  <% end %>

  <%# Discount codes don't apply to bundles (rejected server-side) — hide the field. %>
  <% unless @day_pass_type&.bundle? %>
    <% if local_assigns[:code].present? %>
      <%# Redeem flow: the access code the member entered unlocked this (hidden)
          pass. Carry it on the purchase POST so the server can confirm the code
          matches this type — hidden passes can't be self-purchased without it.
          The visible "have a discount code?" field is suppressed to avoid a
          second input clobbering this same-named param. %>
      <%= hidden_field_tag :discount_code, local_assigns[:code] %>
    <% else %>
      <div class="form-group row">
        <div class="col-1"></div>
        <div class="col">
          <%= render "shared/discount_code_field" %>
        </div>
        <div class="col-1"></div>
      </div>
    <% end %>
  <% end %>
  <div class="form-group row">
    <%= f.button class: 'form-control btn btn-primary col ml-3 mr-3', id: 'stripe-submit', data: { acc: 'add-payment', disable_with: "Processing..." } do %>
      <span class="show-when-enabled">
        <%= label %>
      </span>
      <span class="show-when-disabled">
        Processing...
      </span>
    <% end %>
  </div>
<% end %>
