<% title @recurring_reservation.title %>

<%= list_wrapper do %>
  <%= list_item do %>
    <div class="d-flex justify-content-between align-items-start mb-3">
      <div>
        <h4 class="mb-1"><%= @recurring_reservation.title %></h4>
        <p class="text-muted mb-0">
          <i class="fas fa-sync-alt"></i> <%= @recurring_reservation.pattern_description %>
          at <%= @recurring_reservation.time_description %>
          (<%= @recurring_reservation.duration_description %>)
        </p>
      </div>
      <% if @recurring_reservation.cancelled? %>
        <span class="badge badge-warning">Cancelled</span>
      <% else %>
        <span class="badge badge-success">Active</span>
      <% end %>
    </div>

    <div class="row mb-3">
      <div class="col-sm-6">
        <p class="mb-1"><strong>Room:</strong> <%= @recurring_reservation.room.name %></p>
        <p class="mb-1"><strong>Booked for:</strong> <%= link_to @recurring_reservation.user.name, user_path(@recurring_reservation.user) %></p>
      </div>
      <div class="col-sm-6">
        <p class="mb-1"><strong>Start:</strong> <%= @recurring_reservation.start_date.strftime("%B %d, %Y") %></p>
        <p class="mb-1"><strong>End:</strong> <%= @recurring_reservation.end_date.strftime("%B %d, %Y") %></p>
      </div>
    </div>

    <% unless @recurring_reservation.cancelled? %>
      <button type="button" class="btn btn-danger btn-sm mb-3" data-toggle="modal" data-target="#cancel-series-modal">
        <i class="fas fa-times-circle"></i> Cancel Entire Series
      </button>
    <% end %>
  <% end %>

  <% if @upcoming_reservations.any? %>
    <%= list_item do %>
      <h5 class="mb-3">Upcoming Meetings (<%= @upcoming_reservations.count %>)</h5>
      <div class="table-responsive">
        <table class="table table-sm">
          <thead>
            <tr>
              <th>Date</th>
              <th>Time</th>
              <th>Status</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% @upcoming_reservations.each do |reservation| %>
              <tr class="<%= 'table-secondary' if reservation.cancelled? %>">
                <td><%= reservation.datetime_in.strftime("%a, %b %d, %Y") %></td>
                <td><%= reservation.datetime_in.strftime("%l:%M %p").strip %> - <%= reservation.datetime_out.strftime("%l:%M %p").strip %></td>
                <td>
                  <% if reservation.cancelled? %>
                    <span class="badge badge-warning">Cancelled</span>
                  <% else %>
                    <span class="badge badge-success">Scheduled</span>
                  <% end %>
                </td>
                <td class="text-right">
                  <% unless reservation.cancelled? %>
                    <%= link_to cancel_occurrence_recurring_reservation_path(@recurring_reservation, reservation_id: reservation.id),
                        data: { turbo_method: :put, turbo_confirm: "Cancel this occurrence on #{reservation.datetime_in.strftime('%B %d, %Y')}?" },
                        class: "btn btn-outline-danger btn-sm" do %>
                      <i class="fas fa-times"></i> Cancel
                    <% end %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  <% end %>

  <% if @past_reservations.any? %>
    <%= list_item do %>
      <h5 class="mb-3">Past Meetings</h5>
      <div class="table-responsive">
        <table class="table table-sm">
          <thead>
            <tr>
              <th>Date</th>
              <th>Time</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% @past_reservations.each do |reservation| %>
              <tr class="table-secondary">
                <td><%= reservation.datetime_in.strftime("%a, %b %d, %Y") %></td>
                <td><%= reservation.datetime_in.strftime("%l:%M %p").strip %> - <%= reservation.datetime_out.strftime("%l:%M %p").strip %></td>
                <td>
                  <% if reservation.cancelled? %>
                    <span class="badge badge-warning">Cancelled</span>
                  <% else %>
                    <span class="badge badge-secondary">Completed</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  <% end %>
<% end %>

<%= link_to "Back to Recurring Meetings", recurring_reservations_path, class: "btn btn-outline-dark mt-3" %>

<!-- Cancel Series Modal -->
<div class="modal fade" id="cancel-series-modal" tabindex="-1" role="dialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Cancel Recurring Series</h5>
        <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
      </div>
      <div class="modal-body">
        <p>Are you sure you want to cancel all future meetings in this series?</p>
        <p class="text-muted">This will cancel <strong><%= @upcoming_reservations.where(cancelled: false).count %></strong> upcoming reservation(s). Past reservations will not be affected.</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
        <%= link_to "Cancel Series", cancel_series_recurring_reservation_path(@recurring_reservation),
            data: { turbo_method: :put }, class: "btn btn-danger" %>
      </div>
    </div>
  </div>
</div>
