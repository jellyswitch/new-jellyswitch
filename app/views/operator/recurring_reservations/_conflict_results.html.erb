<% has_conflicts = dates_with_status.any? { |d| d[:conflict] } %>

<% if dates_with_status.empty? %>
  <div class="alert alert-warning">
    <i class="fas fa-exclamation-triangle"></i> No dates match the selected pattern. Please adjust your settings.
  </div>
<% else %>
  <div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
      <strong><%= dates_with_status.size %> occurrence(s) scheduled</strong>
      <% if has_conflicts %>
        <span class="badge badge-danger"><%= dates_with_status.count { |d| d[:conflict] } %> conflict(s)</span>
      <% else %>
        <span class="badge badge-success">All clear!</span>
      <% end %>
    </div>
    <div class="card-body p-0">
      <div style="max-height: 300px; overflow-y: auto;">
        <table class="table table-sm mb-0">
          <thead>
            <tr>
              <th>Date</th>
              <th>Time</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% dates_with_status.each do |entry| %>
              <tr class="<%= 'table-danger' if entry[:conflict] %>">
                <td><%= entry[:date].strftime("%a, %b %d, %Y") %></td>
                <td><%= entry[:time].strftime("%l:%M %p").strip %></td>
                <td>
                  <% if entry[:conflict] %>
                    <span class="badge badge-danger"><i class="fas fa-times-circle"></i> Conflict</span>
                  <% else %>
                    <span class="badge badge-success"><i class="fas fa-check-circle"></i> Available</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <% if has_conflicts %>
    <div class="alert alert-danger mt-2 mb-0">
      <i class="fas fa-exclamation-triangle"></i>
      <strong>Cannot create series.</strong> Please resolve conflicts by choosing a different time, room, or adjusting dates.
    </div>
  <% end %>
<% end %>
