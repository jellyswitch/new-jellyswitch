<p class="text-muted">
  A curated good / better / best presentation of your day passes and memberships with live
  prices, pinned per page to a product type and location. Buy / Sign up goes straight to checkout.
</p>

<%= form_with url: settings_update_website_widgets_path, method: :patch, scope: :operator, model: @operator, local: true do |f| %>
  <%= hidden_field_tag :widget, "showcase" %>
  <div class="form-check mb-3">
    <%= f.check_box :showcase_enabled, class: "form-check-input" %>
    <%= f.label :showcase_enabled, "Enable the Showcase embeds", class: "form-check-label" %>
  </div>
  <small class="form-text text-muted mb-3">
    Tiers come from your visible day passes and individual plans — order, the featured
    badge, and the bullet points are edited on each product's form. Day passes and their
    packs show as one group; Day Office types and their packs as another.
  </small>
  <%= f.submit "Save Showcase settings", class: "btn btn-primary" %>
<% end %>

<hr>
<h5>Embed snippets</h5>
<p class="text-muted mb-2">Paste on the matching page with a Custom HTML block. One line each.</p>
<% modes = [["Day passes", "day_passes"], ["Memberships", "memberships"], ["Both", "all"], ["Standalone cards (e.g. Virtual Office page)", "cards"]] %>
<% locations.each do |loc| %>
  <h6 class="mt-3"><%= loc.name %></h6>
  <% modes.each do |label, mode| %>
    <% url = embed_showcase_url(operator_subdomain: @operator.subdomain, host: request.host_with_port,
                                products: mode, location_id: (locations.count > 1 ? loc.id : nil)) %>
    <div class="input-group input-group-sm mb-1">
      <span class="input-group-text" style="min-width:110px;"><%= label %></span>
      <input class="form-control" readonly value='<script src="<%= url %>" async></script>'
             onclick="this.select();navigator.clipboard.writeText(this.value)">
    </div>
  <% end %>
<% end %>

<hr>
<h5>Link-out cards</h5>
<p class="text-muted mb-2">
  Cards for services sold elsewhere (e.g. Virtual Office) — they render among the tiers
  or standalone, and link out to where sign-up happens.
</p>
<% if @cards.any? %>
  <table class="table table-sm">
    <thead><tr><th>Location</th><th>Label</th><th>Price</th><th>Slot</th><th>URL</th><th></th></tr></thead>
    <tbody>
      <% @cards.each do |card| %>
        <tr>
          <td><%= card.location.name %></td>
          <td><%= card.label %></td>
          <td><%= card.price_text %></td>
          <td><%= card.slot.humanize %></td>
          <td class="text-truncate" style="max-width:180px;"><%= card.url %></td>
          <td><%= button_to "Remove", showcase_card_path(card), method: :delete, class: "btn btn-sm btn-outline-danger", form: { data: { turbo_confirm: "Remove this card?" } } %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<%= form_with url: showcase_cards_path, scope: :showcase_card, local: true do |f| %>
  <div class="form-row row g-2 align-items-end">
    <div class="col-md-2">
      <%= f.label :location_id, "Location" %>
      <%= f.select :location_id, options_from_collection_for_select(locations, :id, :name), {}, class: "form-control form-control-sm" %>
    </div>
    <div class="col-md-2">
      <%= f.label :label, "Label" %>
      <%= f.text_field :label, class: "form-control form-control-sm", placeholder: "Virtual Office" %>
    </div>
    <div class="col-md-2">
      <%= f.label :price_text, "Price line" %>
      <%= f.text_field :price_text, class: "form-control form-control-sm", placeholder: "From $49/mo" %>
    </div>
    <div class="col-md-2">
      <%= f.label :slot, "Slot" %>
      <%= f.select :slot, options_for_select(ShowcaseCard::SLOTS.map { |s| [s.humanize, s] }), {}, class: "form-control form-control-sm" %>
    </div>
    <div class="col-md-3">
      <%= f.label :url, "Outbound URL" %>
      <%= f.text_field :url, class: "form-control form-control-sm", placeholder: "https://…" %>
    </div>
    <div class="col-md-1">
      <%= f.submit "Add", class: "btn btn-sm btn-primary" %>
    </div>
  </div>
  <div class="form-group mt-2">
    <%= f.label :description, "Blurb (one line, optional)" %>
    <%= f.text_field :description, class: "form-control form-control-sm" %>
  </div>
<% end %>
