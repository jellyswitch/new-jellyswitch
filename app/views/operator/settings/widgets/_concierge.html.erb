<p class="text-muted">
  The Concierge greets visitors on your site, figures out what they need, recommends the right
  option at your real price, and captures them into your CRM. It automatically uses your
  <strong>brand name, logo, colors, and hours</strong> — you only tune the copy below.
</p>

<% if @report %>
  <% chat = @report[:chatters]; no_chat = @report[:non_chatters] %>
  <div class="card mb-4">
    <div class="card-body">
      <h5 class="card-title">Conversion lift</h5>
      <% if chat[:count].zero? %>
        <p class="text-muted mb-0">No chats yet — once visitors start using the Concierge, you'll see how much more they convert here.</p>
      <% else %>
        <div class="row text-center">
          <div class="col">
            <div class="h4 mb-0"><%= number_to_percentage(chat[:rate] * 100, precision: 0) %></div>
            <small class="text-muted">Chatted (<%= chat[:converted] %>/<%= chat[:count] %> bought)</small>
          </div>
          <div class="col">
            <div class="h4 mb-0"><%= number_to_percentage(no_chat[:rate] * 100, precision: 0) %></div>
            <small class="text-muted">Didn't chat (<%= no_chat[:converted] %>/<%= no_chat[:count] %> bought)</small>
          </div>
          <div class="col">
            <div class="h4 mb-0 text-success">
              <%= @report[:lift].positive? ? "#{number_with_precision(@report[:lift], precision: 1)}×" : "—" %>
            </div>
            <small class="text-muted">Lift from chatting</small>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<%= form_with(model: @operator, url: settings_update_concierge_path, method: :patch, local: true) do |f| %>
  <div class="form-check form-switch mb-4">
    <%= f.check_box :concierge_enabled, class: "form-check-input" %>
    <%= f.label :concierge_enabled, "Enable the Concierge", class: "form-check-label" %>
  </div>

  <h5>Copy</h5>
  <div class="form-group mb-3">
    <%= f.label :concierge_assistant_name, "Assistant name" %>
    <%= f.text_field :concierge_assistant_name, class: "form-control", placeholder: @operator.name %>
    <small class="form-text text-muted">Defaults to your brand name.</small>
  </div>
  <div class="form-group mb-3">
    <%= f.label :concierge_greeting, "Greeting" %>
    <%= f.text_field :concierge_greeting, class: "form-control", placeholder: @operator.concierge_greeting_text %>
  </div>
  <div class="form-group mb-4">
    <%= f.label :concierge_offer_text, "Offer / hook (optional)" %>
    <%= f.text_field :concierge_offer_text, class: "form-control", placeholder: "First day pass 50% off — mention this chat" %>
    <small class="form-text text-muted">Shown as a gift bubble in the chat and as the floating launcher's teaser.</small>
  </div>

  <% if locations.count > 1 %>
    <div class="form-group mb-4">
      <label>Per-location offers (optional)</label>
      <% locations.each do |loc| %>
        <div class="input-group mb-2">
          <span class="input-group-text"><%= loc.name %></span>
          <%= text_field_tag "locations[#{loc.id}][concierge_offer_text]",
                loc.concierge_offer_text, class: "form-control", placeholder: "Uses the shared offer above" %>
        </div>
      <% end %>
      <small class="form-text text-muted">
        Each location can run its own promo; leave blank to use the shared offer.
        Point an embed at a location by adding <code>?location_id=&lt;id&gt;</code> to the launcher script URL.
      </small>
    </div>
  <% end %>

  <%= f.submit "Save Concierge settings", class: "btn btn-primary" %>
<% end %>

<hr class="my-4" />

<% preview_token = Embed::ConciergeController.verifier.generate({
     "operator_id" => @operator.id, "exp" => 1.hour.from_now.to_i }) %>
<% public_url = embed_concierge_url(operator_subdomain: @operator.subdomain, host: request.host_with_port) %>
<% launcher_url = embed_concierge_launcher_url(operator_subdomain: @operator.subdomain, host: request.host_with_port) %>
<% preview_url = embed_concierge_url(operator_subdomain: @operator.subdomain, host: request.host_with_port, preview_token: preview_token) %>

<h5>Embed on your website</h5>
<p class="text-muted mb-2">
  Recommended — paste this one line before <code>&lt;/body&gt;</code> (most site builders
  have a "custom code" or "footer code" box). Visitors get a floating chat bubble in your
  accent color on every page, with your offer as the teaser.
</p>
<div class="input-group mb-3">
  <textarea id="cx-launcher-snippet" class="form-control" rows="2" readonly><script src="<%= launcher_url %>" async></script></textarea>
  <button class="btn btn-outline-secondary" type="button" onclick="navigator.clipboard.writeText(document.getElementById('cx-launcher-snippet').value)">Copy</button>
</div>

<details class="mb-4">
  <summary class="text-muted">Prefer an inline box instead of the floating bubble?</summary>
  <div class="input-group mt-2">
    <textarea id="cx-snippet" class="form-control" rows="3" readonly><iframe src="<%= public_url %>" width="380" height="560" style="border:none;" title="<%= @operator.name %> Concierge"></iframe></textarea>
    <button class="btn btn-outline-secondary" type="button" onclick="navigator.clipboard.writeText(document.getElementById('cx-snippet').value)">Copy</button>
  </div>
</details>

<h5>Live preview</h5>
<iframe src="<%= preview_url %>" width="380" height="560"
        style="border: 1px solid #ddd; border-radius: 8px;" title="Concierge preview"></iframe>
