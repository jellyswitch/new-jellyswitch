<% provide(:title, "Website Widgets") %>
<%
  widgets = [
    { key: "concierge", label: "Concierge",        icon: "fas fa-comments" },
    { key: "tour",      label: "Tour Request",     icon: "fas fa-calendar-check" },
    { key: "showcase",  label: "Showcase",         icon: "fas fa-th" },
    { key: "offices",   label: "Office Inventory", icon: "fas fa-building" },
  ]
  locations = @operator.locations.where(visible: true).order(:name)
%>

<%= render "tab_layout", active: :website_widgets do %>
  <p class="text-muted">
    Everything your marketing site embeds. Look &amp; feel below themes every widget;
    pick a widget to configure it and grab its embed snippet.
  </p>

  <%= form_with url: settings_update_website_widgets_path, method: :patch, scope: :operator, model: @operator, local: true, html: { class: "card mb-4" } do |f| %>
    <div class="card-body">
      <h5 class="card-title mb-3">Look &amp; feel <small class="text-muted">(shared by every widget)</small></h5>
      <%= hidden_field_tag :widget, @widget %>
      <div class="form-row row">
        <div class="form-group col-md-4">
          <%= f.label :embed_font, "Font" %>
          <%= f.select :embed_font,
                options_for_select(
                  ["", "Arial, sans-serif", "Georgia, serif", "Helvetica, Arial, sans-serif",
                   "'Inter', system-ui, sans-serif", "'Poppins', system-ui, sans-serif",
                   "'Roboto', system-ui, sans-serif", "system-ui, sans-serif"],
                  @operator.embed_font),
                { include_blank: "Default (Showcase inherits your site's font)" }, class: "form-control" %>
        </div>
        <div class="form-group col-md-4">
          <%= f.label :embed_accent_override, "Accent color (hex, optional)" %>
          <%= f.text_field :embed_accent_override, class: "form-control", placeholder: @operator.accent_color.presence || "#2563eb" %>
          <small class="form-text text-muted">Buttons, check marks, and the chat bubble. Blank = your brand accent.</small>
        </div>
        <div class="form-group col-md-4">
          <%= f.label :showcase_button_color, "Buy / Sign up button color (hex, optional)" %>
          <%= f.text_field :showcase_button_color, class: "form-control", placeholder: "e.g. #16a34a" %>
          <small class="form-text text-muted">Showcase buttons only. Blank = accent color.</small>
        </div>
      </div>
      <small class="form-text text-muted mb-3">
        Brand colors and logo come from <%= link_to "Branding & Content", settings_branding_path %>.
      </small>
      <%= f.submit "Save look & feel", class: "btn btn-primary" %>
    </div>
  <% end %>

  <ul class="nav nav-pills mb-4" id="widget-picker" role="tablist">
    <% widgets.each do |w| %>
      <li class="nav-item">
        <a class="nav-link <%= 'active' if @widget == w[:key] %>" data-toggle="pill" role="tab"
           href="#widget-<%= w[:key] %>" data-widget="<%= w[:key] %>">
          <i class="<%= w[:icon] %> mr-1"></i><%= w[:label] %>
        </a>
      </li>
    <% end %>
  </ul>

  <div class="tab-content">
    <div class="tab-pane fade <%= 'show active' if @widget == 'concierge' %>" id="widget-concierge" role="tabpanel">
      <%= render "operator/settings/widgets/concierge", locations: locations %>
    </div>
    <div class="tab-pane fade <%= 'show active' if @widget == 'tour' %>" id="widget-tour" role="tabpanel">
      <%= render "operator/settings/widgets/tour", locations: locations %>
    </div>
    <div class="tab-pane fade <%= 'show active' if @widget == 'showcase' %>" id="widget-showcase" role="tabpanel">
      <%= render "operator/settings/widgets/showcase", locations: locations %>
    </div>
    <div class="tab-pane fade <%= 'show active' if @widget == 'offices' %>" id="widget-offices" role="tabpanel">
      <%= render "operator/settings/widgets/offices", locations: locations %>
    </div>
  </div>

  <script>
    // Keep the picked widget in the URL so a save, a refresh, or a shared
    // link lands on the same widget instead of the first one.
    (function () {
      var picker = document.getElementById("widget-picker");
      if (!picker || !window.jQuery) return;
      jQuery(picker).on("shown.bs.tab", 'a[data-toggle="pill"]', function (e) {
        var key = e.target.getAttribute("data-widget");
        var url = new URL(window.location.href);
        url.searchParams.set("widget", key);
        history.replaceState(null, "", url.toString());
        document.querySelectorAll("input[name=widget]").forEach(function (i) { i.value = key; });
      });
    })();
  </script>
<% end %>
