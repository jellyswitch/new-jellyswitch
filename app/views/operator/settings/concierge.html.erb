<% content_for :title, "Concierge (Chat Widget)" %>

<div class="container py-4" style="max-width: 760px;">
  <h2>Concierge — your website chat widget</h2>
  <p class="text-muted">
    The Concierge greets visitors on your site, figures out what they need, recommends the right
    option at your real price, and captures them into your CRM. It automatically uses your
    <strong>brand name, logo, colors, and hours</strong> — you only tune the copy below.
  </p>

  <%= form_with(model: @operator, url: settings_update_concierge_path, method: :patch, local: true) do |f| %>
    <%= render "shared/error_messages", model: @operator rescue nil %>

    <div class="form-check form-switch mb-4">
      <%= f.check_box :concierge_enabled, class: "form-check-input" %>
      <%= f.label :concierge_enabled, "Enable the Concierge", class: "form-check-label" %>
    </div>

    <h5>Copy</h5>
    <div class="form-group mb-3">
      <%= f.label :concierge_assistant_name, "Assistant name" %>
      <%= f.text_field :concierge_assistant_name, class: "form-control",
            placeholder: @operator.name %>
      <small class="form-text text-muted">Defaults to your brand name.</small>
    </div>
    <div class="form-group mb-3">
      <%= f.label :concierge_greeting, "Greeting" %>
      <%= f.text_field :concierge_greeting, class: "form-control",
            placeholder: @operator.concierge_greeting_text %>
    </div>
    <div class="form-group mb-3">
      <%= f.label :concierge_offer_text, "Offer / hook (optional)" %>
      <%= f.text_field :concierge_offer_text, class: "form-control",
            placeholder: "First day pass 50% off — ask for the code" %>
    </div>
    <div class="form-group mb-3">
      <%= f.label :concierge_promo_code, "Promo code (optional)" %>
      <%= f.text_field :concierge_promo_code, class: "form-control", placeholder: "FIRSTDAY" %>
      <small class="form-text text-muted">Surfaced in the chat and pre-applied at checkout.</small>
    </div>
    <div class="form-group mb-4">
      <%= f.label :concierge_off_hours_message, "Off-hours message" %>
      <%= f.text_field :concierge_off_hours_message, class: "form-control",
            placeholder: "We're closed — leave your email and we'll get back to you." %>
    </div>

    <h5>Look &amp; feel <small class="text-muted">(shared with your tour widget)</small></h5>
    <div class="form-group mb-3">
      <%= f.label :embed_font, "Font" %>
      <%= f.select :embed_font,
            options_for_select(
              ["", "Arial, sans-serif", "Georgia, serif", "Helvetica, Arial, sans-serif",
               "'Inter', system-ui, sans-serif", "'Poppins', system-ui, sans-serif",
               "'Roboto', system-ui, sans-serif", "system-ui, sans-serif"],
              @operator.embed_font),
            { include_blank: "Default (system)" }, class: "form-control" %>
    </div>
    <div class="form-group mb-4">
      <%= f.label :embed_accent_override, "Accent color override (optional)" %>
      <%= f.text_field :embed_accent_override, class: "form-control",
            placeholder: @operator.accent_color.presence || "#2563eb" %>
      <small class="form-text text-muted">Leave blank to inherit your brand accent color.</small>
    </div>

    <%= f.submit "Save Concierge settings", class: "btn btn-primary btn-block" %>
  <% end %>

  <hr class="my-4" />

  <% preview_token = Embed::ConciergeController.verifier.generate({
       "operator_id" => @operator.id, "exp" => 1.hour.from_now.to_i }) %>
  <% public_url = embed_concierge_url(operator_subdomain: @operator.subdomain, host: request.host_with_port) %>
  <% preview_url = embed_concierge_url(operator_subdomain: @operator.subdomain, host: request.host_with_port, preview_token: preview_token) %>

  <h5>Embed on your website</h5>
  <div class="input-group mb-4">
    <textarea id="cx-snippet" class="form-control" rows="3" readonly><iframe src="<%= public_url %>" width="380" height="560" style="border:none;" title="<%= @operator.name %> Concierge"></iframe></textarea>
    <button class="btn btn-outline-secondary" type="button" onclick="navigator.clipboard.writeText(document.getElementById('cx-snippet').value)">Copy</button>
  </div>

  <h5>Live preview</h5>
  <iframe src="<%= preview_url %>" width="380" height="560"
          style="border: 1px solid #ddd; border-radius: 8px;" title="Concierge preview"></iframe>
</div>
