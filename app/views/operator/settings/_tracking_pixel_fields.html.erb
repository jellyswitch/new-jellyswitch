<div class="card mb-2">
  <div class="card-body">
    <%= f.hidden_field :id %>
    <%= f.hidden_field :operator_id, value: current_operator.id %>
    <div class="form-row">
      <div class="form-group col-md-3">
        <%= f.label :name %>
        <%= f.text_field :name, class: "form-control" %>
      </div>
      <div class="form-group col-md-6">
        <%= f.label :script, "Snippet (HTML/JavaScript)" %>
        <%= f.text_area :script, rows: 2, class: "form-control text-monospace" %>
      </div>
      <div class="form-group col-md-3">
        <%= f.label :position, "Placement" %>
        <%= f.select :position,
              [["Header — inside <head>", "head"],
               ["Body — right after <body>", "body"],
               ["Footer — end of page", "footer"]],
              {}, { class: "form-control" } %>
      </div>
    </div>
    <div class="form-check">
      <%= f.check_box :always_on, class: "form-check-input" %>
      <%= f.label :always_on, "Load on every page (site-wide tags like Google Tag Manager or GA4)", class: "form-check-label small" %>
      <div class="text-muted small">Unchecked: fires once, on the page shown right after a purchase (conversion pixels).</div>
    </div>
    <div class="form-check">
      <%= f.check_box :_destroy, class: "form-check-input" %>
      <%= f.label :_destroy, "Delete this pixel", class: "form-check-label small text-danger" %>
    </div>
  </div>
</div>
