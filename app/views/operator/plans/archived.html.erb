
<%- title 'Plans' %>

<%= render "shared/back_bar", back_path: plans_day_passes_path, back_label: "Plans & Day Passes", page_title: "Archived Plans" %>

<%= render(Layout::FullWidth.new) do %>
  <%= list_wrapper do %>

    <%= list_item do %>

      <% if @plans.unavailable.count < 1 %>
        <i>All plans are available.</i>
      <% else %>
        <div class="list-group list-group-flush mt-4">
          <%= render partial: "operator/plans/plan", collection: @plans.unavailable, as: :plan %>
        </div>
      <% end %>
    <% end %>

  <% end %>
<% end %>
