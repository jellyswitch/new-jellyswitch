<div class="form-group">
  <%= f.label :name, "What is this plan called?" %>
  <%= f.text_field :name, placeholder: "Full Time Membership", class: "form-control", disabled: !plan.new_record? %>
</div>

<%= f.hidden_field :plan_type, value: "individual" %>

<% if plan.new_record? %>
  <%= f.label :amount_in_cents, "How much does this plan cost?" %>
  <div class="input-group">
    <div class="input-group-prepend">
      <span class="input-group-text">$</span>
    </div>
    <%= f.text_field :amount_in_cents, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= f.label :interval, "How frequent should members be charged?" %>
    <%= f.select :interval, Plan.options_for_interval, { selected: "monthly" }, class: "form-control" %>
  </div>
<% else %>
  <%= f.label :amount_in_cents, "How much does this plan cost?" %>
  <div class="input-group">
    <div class="input-group-prepend">
      <span class="input-group-text">$</span>
    </div>
    <%= f.text_field :amount_in_cents, value: dollar_amount(plan.amount_in_cents), class: "form-control", disabled: true %>
  </div>
  <div class="row mb-3 mt-3">
    <small class="col">(You cannot change the price of a plan after it's created.)</small>
  </div>

  <div class="form-group">
    <%= f.label :interval, "How frequent should members be charged?" %>
    <%= f.select :interval, Plan.options_for_interval, { selected: "monthly" }, class: "form-control", disabled: true %>
  </div>
<% end %>

<div class="form-group">

  <div class="form-check">
    <%= f.check_box :available, class: "form-check-input" %>
    <%= f.label :available, "Available", class: "form-check-label" %>
  </div>

  <div class="form-check mt-3">
    <%= f.check_box :visible, class: "form-check-input" %>
    <%= f.label :visible, "Visible to new members", class: "form-check-label" %>
  </div>

  <div class="form-group mt-3">
    <%= f.label :building_access_level, "Building access for members on this plan", class: "form-label d-block" %>
    <%= f.select :building_access_level,
          [["No building access", "none"],
           ["Business hours only", "business_hours"],
           ["24/7 access", "all_hours"]],
          {}, class: "form-control", style: "max-width: 20rem;" %>
    <small class="form-text text-muted">
      "Business hours" follows this location's posted working hours; "24/7" is unrestricted;
      "No building access" is for non-building tiers (e.g. mailbox or virtual memberships).
    </small>
  </div>
</div>

<div class="form-group">
  <%= f.label :description %>
  <%= f.rich_text_area :description %>
</div>

<hr/>
<p>Other options:</p>

<% if policy(:credit).enabled? %>
  <%= render Accordion.new(title: "Credit System") do %>
    <div class="form-group">
      <%= f.label :credits, "How many credits per billing cycle does this plan include?" %>
      <%= f.text_field :credits, placeholder: "Number of credits per billing cycle", class: "form-control" %>
    </div>
  <% end %>
<% end %>

<% if policy(:childcare).enabled? %>
  <%= render Accordion.new(title: "Childcare Reservations") do %>
    <div class="form-group">
      <%= f.label :childcare_reservations, "How many childcare reservations per billing cycle does this plan include?" %>
      <%= f.text_field :childcare_reservations, placeholder: "Number of childcare reservations per billing cycle", class: "form-control" %>
    </div>
  <% end %>
<% end %>

<%= render Accordion.new(title: "Monthly Limits") do %>
  <div class="form-check">
    <%= f.check_box :has_day_limit, class: "form-check-input" %>
    <%= f.label :has_day_limit, "Limit number of days per month to:", class: "form-check-label" %>
  </div>

  <div class="form-group">
    <%= f.number_field :day_limit, class: "form-control", min: 1, step: 1,
        value: (plan.day_limit if plan.has_day_limit?), placeholder: "e.g. 10" %>
  </div>
<% end %>

<% if plan.respond_to?(:included_meeting_room_minutes) %>
  <%= render Accordion.new(title: "Meeting Room Limits") do %>
    <div class="form-group">
      <%= f.label :included_meeting_room_minutes, "Included meeting room hours per billing cycle" %>
      <div class="input-group">
        <%= f.number_field :included_meeting_room_minutes,
            value: plan.included_meeting_room_minutes ? plan.included_meeting_room_minutes / 60.0 : nil,
            step: 0.5, min: 0, placeholder: "Leave blank for unlimited",
            class: "form-control" %>
        <div class="input-group-append">
          <span class="input-group-text">hours</span>
        </div>
      </div>
      <small class="form-text text-muted">Leave blank for unlimited meeting room use.</small>
    </div>

    <div class="form-group">
      <%= f.label :overage_rate_in_cents, "Overage rate per hour" %>
      <div class="input-group">
        <div class="input-group-prepend">
          <span class="input-group-text">$</span>
        </div>
        <%= f.number_field :overage_rate_in_cents,
            value: plan.overage_rate_in_cents && plan.overage_rate_in_cents > 0 ? plan.overage_rate_in_cents / 100.0 : nil,
            step: 0.01, min: 0, placeholder: "0.00",
            class: "form-control" %>
      </div>
      <small class="form-text text-muted">Charged in 30-minute increments when member exceeds included hours.</small>
    </div>
  <% end %>
<% end %>

<%= render Accordion.new(title: "Commitment Length") do %>
  <div class="form-group">
    <%= f.label :commitment_interval, "For example, 6 for 6 months, 12 for 12 weeks, etc" %>
    <%= f.number_field :commitment_interval, class: "form-control" %>
  </div>
<% end %>

<div class="form-group">
  <div class="mt-2">
    <%= f.label :plan_category, "Select a plan category" %>
  </div>
  <%= f.select :plan_category_id, PlanCategory.where(operator_id: current_location.operator.id).collect { |plan_category| [plan_category.name, plan_category.id] }, { include_blank: "No Category" }, class: "form-control" %>
</div>

  <fieldset class="mt-3">
    <legend style="font-size:1rem;">Website Showcase</legend>
    <div class="form-check mb-2">
      <%= f.check_box :featured, class: "form-check-input" %>
      <%= f.label :featured, "Featured tier (highlighted on the website)", class: "form-check-label" %>
    </div>
    <div class="form-group mb-2">
      <%= f.label :display_order, "Display order (lower shows first)" %>
      <%= f.number_field :display_order, class: "form-control", step: 1 %>
    </div>
    <div class="form-group mb-2">
      <%= f.label :features_text, "What's included — one line each (shown after the automatic lines)" %>
      <%= f.text_area :features_text, value: f.object.features.join("\n"), rows: 4, class: "form-control", placeholder: "Free coffee & tea\nMail service" %>
    </div>
  </fieldset>

