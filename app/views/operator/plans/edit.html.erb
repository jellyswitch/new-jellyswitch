<%- title "Edit Plan" %>

<%= render "shared/back_bar", back_path: plans_path, back_label: "Plans", page_title: "Edit Plan" %>

<%= render Layout::FullWidth.new do %>
  <%= list_item do %>
    <%= render "edit_form", plan: @plan, url: plan_path(@plan) %>
    <div class="row mt-3">
      <div class="col-12">
        <%= link_to plan_path(@plan), class: "btn btn-block btn-warning" do %>
          <i class="fas fa-times"></i>
          &nbsp;
          Cancel
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>