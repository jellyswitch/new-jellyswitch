<%= stylesheet_link_tag "reservation_calendar", media: "all" %>

<% title "Reservation" %>

<div id="reservation-calendar-container" data-controller="reservation-calendar" data-location-timezone="<%= ActiveSupport::TimeZone::MAPPING[current_location.time_zone] %>" data-is-manager="<%= current_user&.role != User::UNASSIGNED %>">
  <div class="full-calendar-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2 class="mb-0">Reservation Date</h2>

      <div class="d-flex align-items-center">
        <% if current_user&.admin_or_manager?(current_location) %>
          <%= link_to new_recurring_reservation_path, class: "btn btn-outline-dark btn-sm mr-2" do %>
            <i class="fas fa-sync-alt"></i> Recurring
          <% end %>
        <% end %>
        <div class="room-filter-container">
          <select id="room-filter" class="form-control">
            <option value="">All Rooms</option>
            <% room_filter_scope = current_user&.admin_or_manager?(current_location) ? current_location.rooms : current_location.rooms.visible %>
            <% room_filter_scope.order(:name).each do |room| %>
              <option value="<%= room.id %>"><%= room.name %></option>
            <% end %>
          </select>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-body p-0">
        <div class="mx-auto" id="reservation-fullcalendar"></div>
      </div>
    </div>
  </div>

  <div id="modal-view-event-add" class="modal modal-top fade calendar-modal bottom-sheet-modal">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
      <div class="modal-content">
        <div class="bottom-sheet-handle"><span></span></div>
        <form id="add-reservation" method="post" data-turbo="false">
          <div class="modal-body">
            <h4>Reservation Details</h4>

            <div class="form-group">
              <label>Date</label>
              <p class="date-value"></p>
              <input type='date' class="reservation-date-input form-control"
                name="date" value="<%= @current_date %>" data-reserve-now="<%= @is_reserve_now %>" hidden>
            </div>

            <div class="existing-reservations mb-3">
              <div class="d-flex align-items-center reservations-list-toggle collapsed"
                   data-toggle="collapse"
                   data-target="#reservationsList"
                   aria-expanded="false">
                <i class="fas fa-chevron-right mr-2"></i>
                <span>Existing Reservations</span><span class="badge badge-dark ml-2 reservation-count-badge">0</span>
              </div>

              <div id="reservationsList" class="collapse">
                <div class="reservations-list mt-2">
                  <!-- Dynamically populated by JS -->
                </div>
              </div>
            </div>

            <div class="form-group">
              <label>Select a Time</label>
              <div id="time-slots-container"></div>
              <input type='text' class="form-control" name="time" hidden
                value="<%= @nearest_time_slot&.strftime("%I:%M") %>">
              <input type='hidden' name="day_or_night" value="<%= Time.current.hour >= 12 ? 'night' : 'day' %>">
            </div>

            <div class="form-group duration-group d-none">
              <label>Meeting Duration</label>
              <div class="duration-slider-container">
                <div class="duration-display">
                  <span class="duration-value">30 minutes</span>
                </div>
                <input type="range" id="duration-slider" class="duration-slider"
                  min="15" max="480" step="15" value="30">
                <div class="duration-range-labels">
                  <span>15 min</span>
                  <span class="duration-max-label">8 hrs</span>
                </div>
              </div>
              <div class="duration-quick-picks mt-2">
                <div class="duration-quick-pick" data-duration="30">30 min</div>
                <div class="duration-quick-pick" data-duration="60">1 hr</div>
                <div class="duration-quick-pick" data-duration="120">2 hrs</div>
                <div class="duration-quick-pick" data-duration="240">4 hrs</div>
              </div>
              <input type='text' class="form-control" name="duration" hidden>
            </div>

            <div class="day-pass-overage-alert d-none alert alert-warning mt-2 mb-3">
              <strong><i class="fas fa-exclamation-triangle"></i> Overage Notice</strong>
              <p class="overage-message mb-0 mt-1"></p>
            </div>

            <div class="form-group available-room-group d-none mb-0">
              <label>Available Room</label>
              <div id="rooms-container">
                <div class="rooms-select-container">
                  <select id="rooms-select" class="form-control" name="room_id">
                  </select>
                </div>

                <div class="room-details d-none">
                  <label>Room Details</label>

                  <div class="details-label hourly-price">Hourly Price:
                    <span class="details-value"></span>
                  </div>

                  <div class="details-label room-capacity">Capacity:
                    <span class="details-value"></span>
                  </div>

                  <div class="details-label room-amenities">Amenities:
                    <span class="details-value"></span>
                  </div>
                </div>

                <div class="amenities-container d-none">
                  <label class="font-size-16">Additional Amenities:</label>
                  <div class="row amenities-list">
                  </div>
                </div>

                <%# Attendees — shown by the controller for paid meeting rooms;
                    optional, capped at the room's capacity. %>
                <div class="form-group attendee-container mt-1 pl-1 pr-1 d-none">
                  <label for="reservation-attendees">Number of attendees <small class="text-muted">(optional)</small></label>
                  <input type="number" id="reservation-attendees" name="attendee_count" min="1" class="form-control form-control-sm" placeholder="How many people?">
                </div>

                <div class="price-container d-none">
                  <label class="mb-0">Total Price:</label>
                  <div class="price-value"></div>
                </div>

                <div class="billing-section d-none">
                  <label>Payment Information</label>
                  <div id="card-element" class="form-control mb-2"></div>
                  <div id="card-errors" class="text-danger mb-2" role="alert"></div>
                </div>

                <% if current_user&.admin_or_manager?(current_location) %>
                  <div class="form-group note-container mt-1 pl-1 pr-1 d-none">
                    <label for="reservation-note">Note</label>
                    <textarea id="reservation-note" name="note" class="form-control form-control-sm" rows="3" placeholder="Add a reservation note (visible to admins only)"></textarea>
                  </div>
                <% end %>
              </div>
            </div>
          </div>

          <div class="modal-footer" style="position: sticky; bottom: 0; background: white; z-index: 10; border-top: 1px solid #dee2e6; padding-bottom: calc(1rem + env(safe-area-inset-bottom, 0px));">
            <button type="button" class="btn btn-dark cancel-btn"
              data-dismiss="modal">Close</button>
            <button type="submit" class="btn btn-dark" disabled>Confirm</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>