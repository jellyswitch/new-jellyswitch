
<% title "Today's Reservations" %>


<%= render "shared/back_bar", back_path: feed_items_path, back_label: "Home", page_title: "Today's Reservations" %>

<div class="row mt-1 mb-0 p-0">
  <div class="col-lg-3"></div>
  <div class="col-lg-6 m-0 p-0">
    <%= list_wrapper do %>
      <%= list_item do %>
      <% end %>

      <% @rooms.each do |room| %>
        <%= list_item do %>
          <div class="row mb-2">
            <div class="col">
              <h5 class="mb-0"><%= room[:room].name %></h5>
              <span class="text-secondary"><%= room[:room].location.name %></span>
              <h6 class="text-danger mt-2">
                <%= render(HourLabel.new(hours: room[:hours])) %>
              </h6>
            </div>
          </div>

          <% room[:users].each do |user| %>
            <div class="row mb-2">
              <div class="col-2">
                <%= render "shared/small_profile_photo", user: user[:user] %>
              </div>
              <div class="col pt-2">
                <%= user[:user].name %>
                <span class="text-secondary">
                  <%= render(HourLabel.new(hours: user[:hours])) %>
                </span>
              </div>
            </div>
          <% end %>

        <% end %>
      <% end %>
    <% end %>
  </div>
  <div class="col-lg-3"></div>
</div>
