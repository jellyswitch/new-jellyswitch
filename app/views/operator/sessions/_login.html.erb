<%= form_for(:session, url: login_path) do |f| %>
  <div class="form-group row">
    <div class="col-1"></div>
    <%= f.email_field :email, placeholder: "Email", class: "form-control col" %>
    <div class="col-1"></div>
  </div>
  <div class="form-group row">
    <div class="col-1"></div>
    <%= f.password_field :password, placeholder: "Password", class: "form-control col" %>
    <div class="col-1"></div>
  </div>

  <div class="form-group row">
    <div class="col-1"></div>
    <%= f.submit "Sign In", class: "form-control btn btn-primary col", id: "sign-in", data: { disable_with: "Signing in..." } %>
    <div class="col-1"></div>
  </div>
  <div class="form-group row">
    <div class="col-1"></div>
    <div class="col-sm-7 text-center">
      <small>
        Not a member? <%= link_to "Sign up", signup_path, data: { "turbo-action" => "replace" } %>
      </small>
    </div>
    <div class="col-1"></div>
  </div>
  <div class="form-group row">
    <div class="col-1"></div>
    <div class="col-sm-7 text-center">
      <small>
        Forgot your password? <%= link_to "Reset my password", new_password_reset_path, data: { "turbo-action" => "replace" } %>
      </small>
    </div>
    <div class="col-1"></div>
  </div>
  <div class="form-group row">
    <div class="col-1"></div>
    <div class="col-sm-7 text-center">
      <small>
        Or <%= link_to "email me a login code", new_login_code_path, data: { "turbo-action" => "replace" } %> instead.
      </small>
    </div>
    <div class="col-1"></div>
  </div>
<%- end %>
