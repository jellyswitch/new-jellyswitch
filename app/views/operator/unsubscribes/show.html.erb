<% title "Unsubscribe" %>

<div class="row mt-5">
  <div class="col-sm-3"></div>
  <div class="col-sm">
    <div class="jumbotron bg-white pb-4 pt-4 text-center">
      <% if @error %>
        <h4 class="mt-3">Invalid Link</h4>
        <p class="text-muted mt-3">This unsubscribe link is invalid or has expired.</p>
      <% else %>
        <h4 class="mt-3">You've been unsubscribed</h4>
        <p class="text-muted mt-3">
          You will no longer receive marketing emails from <%= @operator.name %>.
          You'll still receive important account notifications like payment confirmations and booking reminders.
        </p>
      <% end %>
    </div>
  </div>
  <div class="col-sm-3"></div>
</div>
