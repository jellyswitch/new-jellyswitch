<%= form_for(location, html: {multipart: true}) do |f| %>
  <%= render "shared/error_messages" , model: location %>

  <div class="form-group ">
    <%= f.label :name %>
    <%= f.text_field :name, placeholder: "Name", class: "form-control" %>
  </div>

  <div class="form-group">
    <%= f.label :snippet, "Homepage Description" %>
    <%= f.text_area :snippet, placeholder: "Description", class: "form-control" %>
  </div>

  <% if location.allow_hourly? %>
    <div class="form-group">
      <%= f.label :hourly_rate_in_cents %>
      <%= f.number_field :hourly_rate_in_cents, placeholder: "300", class: "form-control" %>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :contact_name, "Contact Name (for members)" %>
    <%= f.text_field :contact_name, placeholder: "Contact Name", class: "form-control" %>
  </div>

  <div class="form-group">
    <%= f.label :contact_email, "Contact email (for members)" %>
    <%= f.text_field :contact_email, placeholder: "Contact Email", class: "form-control" %>
  </div>

  <div class="form-group">
    <%= f.label :contact_phone, "Contact phone number (for members)" %>
    <%= f.text_field :contact_phone, placeholder: "Contact Phone Number", class: "form-control" %>
  </div>

  <% if location.persisted? && location.operator.present? && policy(location).set_space_host? %>
    <div class="form-group">
      <%= f.label :space_host_id, "Space host" %>
      <% candidates = location.operator.users
                              .where(role: [User::ADMIN, User::GENERAL_MANAGER, User::COMMUNITY_MANAGER])
                              .visible
                              .order(:name) %>
      <%= f.select :space_host_id,
            options_from_collection_for_select(candidates, :id, :name, location.space_host_id),
            { include_blank: "(Use default: oldest admin)" },
            class: "form-control" %>
      <small class="form-text text-muted">Whose name + photo appears as the host on the first chat greeting.</small>
    </div>
  <% end %>

  <hr />
  <h5>Email Settings</h5>
  <p class="text-muted small">Override operator-level email settings for this location. Leave blank to use the operator defaults.</p>

  <div class="form-group">
    <%= f.label :sender_email, "Sender Email" %>
    <%= f.text_field :sender_email, placeholder: "team@yourlocation.com", class: "form-control" %>
    <small class="form-text text-muted">Emails to members at this location will be sent from this address. Must be verified in SendGrid.</small>
  </div>

  <div class="form-group">
    <%= f.label :google_reviews_url, "Google Reviews URL" %>
    <%= f.text_field :google_reviews_url, placeholder: "https://g.page/r/your-location/review", class: "form-control" %>
    <small class="form-text text-muted">Used in follow-up emails to link members to this location's Google Reviews page.</small>
  </div>

  <div class="form-group">
    <%= f.label :renewal_reminder_days, "Renewal Reminder Days" %>
    <%= f.number_field :renewal_reminder_days, class: "form-control", min: 0, max: 90, placeholder: "7" %>
    <small class="form-text text-muted">Send renewal reminder this many days before membership renewal. Set to 0 to disable.</small>
  </div>

  <hr />

  <div class="form-group">
    <%= f.label :square_footage %>
    <%= f.number_field :square_footage, placeholder: "Square Footage", class: "form-control" %>
  </div>

  <div class="form-group">
    <%= f.label :flex_square_footage %>
    <%= f.number_field :flex_square_footage, placeholder: "Flex Square Footage", class: "form-control" %>
  </div>

  <div class="form-group">
    <%= f.label :common_square_footage %>
    <%= f.number_field :common_square_footage, placeholder: "Common Square Footage", class: "form-control" %>
  </div>

  <div class="form-group">
    <%= f.label :wifi_name %>
    <%= f.text_field :wifi_name, placeholder: "WiFi Name", class: "form-control" %>
  </div>

  <div class="form-group">
    <%= f.label :wifi_password %>
    <%= f.text_field :wifi_password, placeholder: "WiFi Password", class: "form-control" %>
  </div>

  <div class="form-group">
    <%= f.label :kisi_api_key %>
    <%# value: "" so the live key is never rendered into the HTML. When a key is
        set, the placeholder shows a masked hint and a blank submit keeps it
        (see LocationsController#location_params). %>
    <%= f.text_field :kisi_api_key, value: "", autocomplete: "off",
          placeholder: masked_kisi_key(f.object.kisi_api_key) || "Kisi API Key",
          class: "form-control" %>
    <% if f.object.kisi_api_key.present? %>
      <small class="form-text text-muted">A key is set. Leave blank to keep it; enter a new key to replace it.</small>
    <% end %>
  </div>

  <div class="form-group">
    <%= f.label :building_access_instructions %>
    <%= f.text_field :building_access_instructions, placeholder: "Please see a host for your key...", class: "form-control" %>
  </div>

  <div class="form-group">
    <%= f.label :pause_warning, "Pause membership warning" %>
    <%= f.text_area :pause_warning, rows: 4, class: "form-control",
          placeholder: "Heads up! If you have belongings stored at a dedicated desk, pausing means giving up that desk..." %>
    <small class="form-text text-muted">
      Shown to a member for confirmation before they pause a membership, in the app and on the web.
      Leave blank for no warning.
    </small>
  </div>


  <div class="form-group">
    <%= f.label :building_address %>
    <%= f.text_field :building_address, placeholder: "Building Address", class: "form-control" %>
  </div>

  <div class="form-group">
    <%= f.label :city %>
    <%= f.text_field :city, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= f.label :state %>
    <%= f.select :state, state_options, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= f.label :zip %>
    <%= f.text_field :zip, class: "form-control" %>
  </div>

  <div class="form-group row">
    <div class="col">
      <%= f.label :latitude, "Latitude (for proximity door access)" %>
      <%= f.text_field :latitude, placeholder: "e.g. 38.6780", class: "form-control" %>
    </div>
    <div class="col">
      <%= f.label :longitude %>
      <%= f.text_field :longitude, placeholder: "e.g. -121.1761", class: "form-control" %>
    </div>
  </div>
  <small class="form-text text-muted mb-3">Find coordinates at <a href="https://www.latlong.net/" target="_blank">latlong.net</a>. Used for automatic door unlock notifications when members approach the building.</small>

  <div class="form-group custom-file mb-3">
    <label class="custom-file-label" for="customFile">Choose background image</label>
    <%= f.file_field :background_image, placeholder: "Background Image File Path", class: "custom-file-input" %>
  </div>

  <% if policy(location).edit_tracking_pixels? %>
    <div class="form-group custom-file mb-3">
      <%= f.label :tracking_pixels, "Tracking Pixels", class: "font-weight-bold" %>
      <% if f.object.tracking_pixels.empty? %>
        <p class="text-muted">No tracking pixels have been added yet.</p>
      <% end %>
      <%= f.fields_for :tracking_pixels do |pixel_form| %>
        <%= render "pixel_fields", f: pixel_form %>
      <% end %>
      <div class="links text-center">
        <%= link_to_add_association "+ Add Tracking Pixel", f, :tracking_pixels, partial: 'operator/locations/pixel_fields', class: "mt-2" %>
      </div>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :time_zone %>
    <%= f.time_zone_select(:time_zone, nil, {},  {class: "form-control form-control-sm"}) %>
  </div>

  <div class="form-group">
    <%= f.label :working_day_start %>
    <%= f.select :working_day_start, @hourly_options %>
  </div>

  <div class="form-group">
    <%= f.label :working_day_end %>
    <%= f.select :working_day_end, @hourly_options %>
  </div>

  <div class="form-group">
    <label>Working Days</label>
  </div>
  <% [:open_sunday, :open_monday, :open_tuesday, :open_wednesday, :open_thursday, :open_friday, :open_saturday].each do |day| %>
    <div class="form-check">
      <%= f.check_box day, class: "form-check-input" %>
      <%= f.label :day, "#{day.to_s.humanize.titleize}?", class: "form-check-label" %>
    </div>
  <% end %>

  <div class="mt-3"></div>
  <%= f.submit label, class: "form-control btn btn-primary" %>
<% end %>
