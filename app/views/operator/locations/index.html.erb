<% title "Locations" %>

<%= render "shared/back_bar", back_path: customization_path, back_label: "Customization", page_title: "Location Settings" %>

<div class="row mt-0 mb-0">
  <div class="col-lg-3"></div>
  <div class="col-lg-6 m-0 pl-0 pr-0">
    <%= list_wrapper do %>
      <%= list_item do %>
        <h4 class="display-4 text-center">Locations</h4>
        <% if policy(:location).new? %>
          <%= link_to "Add a location", new_location_path, class: "btn btn-block btn-primary" %>
        <% end %>
      <% end %>

      <%= render partial: "operator/locations/location", collection: @locations, as: :location, locals: { label: "Switch to" } %>
    <% end %>
  </div>
  <div class="col-lg-3"></div>
</div>

