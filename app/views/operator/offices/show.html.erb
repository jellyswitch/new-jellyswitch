<% title @office.name %>

<%= render "shared/back_bar", back_path: offices_path, back_label: "Offices", page_title: @office.name %>

<div class="row mt-1 mb-0 p-0">
  <div class="col-lg-3"></div>
  <div class="col-lg-6 m-0 p-0">
    <%= list_wrapper do %>
      <%= list_item do %>
        <%= render "operator/offices/office_detail", office: @office %>
      <% end %>
    <% end %>
  </div>
  <div class="col-lg-3"></div>
</div>
