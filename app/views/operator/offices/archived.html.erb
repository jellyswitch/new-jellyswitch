<% title "Archived Offices" %>

<%= render "shared/back_bar", back_path: offices_path, back_label: "Offices", page_title: "Archived Offices" %>

<div class="row mt-1 mb-0 p-0">
  <div class="col-lg-3"></div>
  <div class="col-lg-6 m-0 p-0">
    <%= list_wrapper do %>
      <%= list_item do %>

        <div class="text-center">
          <small>
            Showing offices for <strong><%= current_location.name %></strong>. Switch locations to manage offices at other locations.
          </small>
        </div>
      <% end %>

      <% if @offices.count < 1 %>
        <%= list_item do %>
          <p class="lead text-center">No hidden offices.</p>
        <% end %>
      <% else %>
        <% @offices.each do |office| %>
          <%= link_to edit_office_path(office), class: "list-group-item list-group-item-action" do %>
            <%= render office %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </div>
  <div class="col-lg-3"></div>
</div>
