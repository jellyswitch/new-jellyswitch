<% title "New Post" %>

<%= render "shared/back_bar", back_path: posts_path, back_label: "Bulletin Board", page_title: "New Post" %>

<%= render Layout::FullWidth.new do %>
  <%= list_item do %>

    <%= form_with(model: @post, url: posts_path, local: true) do |f| %>
      <div class="form-group">
        <%= f.label :title %>
        <%= f.text_field :title, class: "form-control" %>
      </div>

      <div class="form-group">
        <%= f.label :content, "What would you like to post?" %>
        <%= f.rich_text_area :content %>
      </div>

      <%= f.submit "Post", class: "btn btn-block btn-primary" %>
    <% end %>
  <% end %>
<% end %>