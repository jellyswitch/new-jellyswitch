<% title "Review Renewal" %>

<%= render "shared/back_bar", back_path: lease_renewal_requests_path, back_label: "Renewals", page_title: "Review" %>

<%= render Layout::FullWidth.new do %>
  <%= list_item do %>
    <div class="text-center mb-3">
      <% if @request.pending_admin? %>
        <span class="badge badge-warning p-2">Leasee Requested Modifications</span>
      <% else %>
        <span class="badge badge-info p-2">Awaiting Leasee Response</span>
      <% end %>
    </div>

    <dl class="row">
      <dt class="col-sm-4">Office</dt>
      <dd class="col-sm-8"><%= link_to @request.office_lease.office.name, office_path(@request.office_lease.office) %></dd>

      <dt class="col-sm-4">Leasee</dt>
      <dd class="col-sm-8"><%= @request.leasee_name %></dd>

      <dt class="col-sm-4">Current Price</dt>
      <dd class="col-sm-8"><%= @request.current_price_formatted %></dd>

      <dt class="col-sm-4">Proposed Price</dt>
      <dd class="col-sm-8"><strong><%= @request.proposed_price_formatted %></strong></dd>

      <dt class="col-sm-4">Escalation</dt>
      <dd class="col-sm-8"><%= @request.escalation_applied %></dd>

      <dt class="col-sm-4">New Period</dt>
      <dd class="col-sm-8"><%= short_date(@request.proposed_start_date) %> — <%= short_date(@request.proposed_end_date) %></dd>
    </dl>

    <% if @request.leasee_notes.present? %>
      <div class="alert alert-warning mt-2">
        <strong>Leasee Notes:</strong> <%= @request.leasee_notes %>
      </div>
    <% end %>

    <hr>
    <h5>Admin Actions</h5>

    <%# Approve with optional price override %>
    <%= form_with url: admin_approve_lease_renewal_request_path(@request), method: :post, local: true, class: "mb-3" do |f| %>
      <div class="form-group">
        <label>Override Price (optional, in dollars)</label>
        <div class="input-group">
          <div class="input-group-prepend">
            <span class="input-group-text">$</span>
          </div>
          <%= f.number_field :price_override, class: "form-control", step: "0.01", placeholder: "Leave blank to use proposed price" %>
        </div>
      </div>
      <div class="form-group">
        <%= f.text_area :notes, placeholder: "Admin notes (optional)...", class: "form-control", rows: 2 %>
      </div>
      <%= f.submit "Approve Renewal", class: "btn btn-block btn-primary", data: { confirm: "Approve this renewal and create the new lease?" } %>
    <% end %>

    <%# Force approve (when leasee hasn't responded) %>
    <% if @request.pending_leasee? %>
      <%= form_with url: admin_force_approve_lease_renewal_request_path(@request), method: :post, local: true, class: "mb-3" do |f| %>
        <div class="form-group">
          <label>Override Price (optional, in dollars)</label>
          <div class="input-group">
            <div class="input-group-prepend">
              <span class="input-group-text">$</span>
            </div>
            <%= f.number_field :price_override, class: "form-control", step: "0.01", placeholder: "Leave blank to use proposed price" %>
          </div>
        </div>
        <div class="form-group">
          <%= f.text_area :notes, placeholder: "Reason for force approval (e.g., verbal agreement)...", class: "form-control", rows: 2 %>
        </div>
        <%= f.submit "Force Approve (verbal/email agreement)", class: "btn btn-block btn-outline-primary", data: { confirm: "Force approve this renewal without leasee's digital acceptance?" } %>
      <% end %>
    <% end %>

    <%# Decline %>
    <%= form_with url: admin_decline_lease_renewal_request_path(@request), method: :post, local: true do |f| %>
      <div class="form-group">
        <%= f.text_area :notes, placeholder: "Reason for declining (optional)...", class: "form-control", rows: 2 %>
      </div>
      <%= f.submit "Decline Renewal", class: "btn btn-block btn-danger", data: { confirm: "Decline this renewal request?" } %>
    <% end %>
  <% end %>
<% end %>
