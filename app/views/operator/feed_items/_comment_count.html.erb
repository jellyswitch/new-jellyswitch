<%= link_to feed_item_path(feed_item), class: "text-muted text-decoration-none", title: "View comments", "aria-label": "View comments" do %>
  <i class="far fa-comment-alt"></i>
  <% if feed_item.feed_item_comments.count > 0 %>
    <span class="ml-1"><%= feed_item.feed_item_comments.count %></span>
  <% end %>
<% end %>
