<div id="feed-item-<%= feed_item.id %>" class='feed-item'>
  <% comments = local_assigns.fetch(:comments, false) %>
  <% if feed_item.type == "reservation" %>
    <% if feed_item.operator.reservation_notifications? %>
      <%= render(FeedItemComponent.new(feed_item: feed_item, comments: comments)) %>
    <% end %>
  <% elsif feed_item.type == "new-user" %>
  <% else %>
    <%= render(FeedItemComponent.new(feed_item: feed_item, comments: comments)) %>
  <% end %>
</div>