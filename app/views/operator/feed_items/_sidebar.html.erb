<%= render "operator/search_results/form" %>


<div class="d-flex justify-content-center mb-2">
  <div class="btn-group mt-2" role="group" aria-label="Feed filters">
    <%= link_to "All", feed_items_path, class: "btn btn-light #{@all_active}", title: "All activity", "aria-label": "All activity", data: {"turbo-action" => "replace"} %>

    <%= link_to notes_feed_items_path, class: "filter-note-feed-items btn btn-light #{@notes_active}", title: "Management notes", "aria-label": "Management notes", data: {"turbo-action" => "replace"} do %>
      <i class="fas fa-clipboard"></i>
    <% end %>

    <%= link_to questions_feed_items_path, class: "filter-question-feed-items btn btn-light #{@questions_active}", title: "Questions", "aria-label": "Questions", data: {"turbo-action" => "replace"} do %>
      <i class="fas fa-question"></i>
    <% end %>

    <%= link_to activity_feed_items_path, class: "filter-activity-feed-items btn btn-light #{@activity_active}", title: "Member activity", "aria-label": "Member activity", data: {"turbo-action" => "replace"} do %>
      <i class="fas fa-users"></i>
    <% end %>

    <%= link_to financial_feed_items_path, class: "btn btn-light #{@financial_active}", title: "Financial events", "aria-label": "Financial events", data: {"turbo-action" => "replace"} do %>
      <i class="fas fa-dollar-sign"></i>
    <% end %>

    <button type="button" class="btn btn-info" data-toggle="modal" data-target="#newModal" id="new-management-note" title="Create" aria-label="Create">
      <i class="fas fa-plus"></i>
      <span class="d-none d-lg-inline ml-1" style="font-size: 13px;">Create</span>
    </button>
  </div>
</div>

<%= list_wrapper do %>
  <li class="list-group-item m-0 pt-3 pb-2" style="border-bottom: 0px;">
    <h5>What's Happening?</h5>
  </li>

  <%= link_to todays_activity_index_path, class: "list-group-item list-group-item-action m-0" do %>
    <div class="row">
      <div class="col-lg-10 col-11">
        <i class="fas fa-users mt-2"></i>
        &nbsp;
        Who's coming today
      </div>
      <div class="col-1">
        <i class="fas fa-chevron-right"></i>
      </div>
    </div>
  <% end %>

  <% if policy(:room).enabled? %>
    <%= link_to today_reservations_path, class: "list-group-item list-group-item-action m-0", style: "border-top: 0px;" do %>
      <div class="row">
        <div class="col-lg-10 col-11">
          <i class="fas fa-briefcase mt-2"></i>
          &nbsp;
          <%= @reservations %> reservations today
        </div>
        <div class="col-1">
          <i class="fas fa-chevron-right"></i>
        </div>
      </div>
    <% end %>
  <% end %>

  <% if @users.count > 0 %>

    <%= link_to unapproved_users_path, class: "list-group-item list-group-item-action m-0", style: "border-top: 0px;" do %>
      <div class="row">
        <div class="col-lg-10 col-11">
          <i class="fas fa-hand-paper"></i>
          &nbsp;
          <%= @users.count %> members awaiting approval
        </div>
        <div class="col-1">
          <i class="fas fa-chevron-right"></i>
        </div>
      </div>
    <% end %>

    <% active_users = @users.select { |u| u.subscriptions.pending.any? || u.day_passes.any? || (u.last_active_at.present? && u.last_active_at > 15.minutes.ago) } %>
    <% active_users.first(5).each do |user| %>
      <% pending_sub = user.subscriptions.pending.first %>
      <% has_billing = user.has_billing_for_location?(current_location) %>
      <%= link_to user_path(user), class: "list-group-item list-group-item-action m-0 py-2", style: "border-top: 0px;" do %>
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <strong style="font-size: 13px;"><%= user.name %></strong>
            <div style="font-size: 11px;" class="text-muted">
              <% if pending_sub %>
                <span class="text-success"><%= pending_sub.plan.name %></span>
                · <%= has_billing ? "card on file" : "no payment yet" %>
              <% elsif user.day_passes.any? %>
                <span class="text-success">Purchased a day pass</span>
              <% else %>
                Browsing options
              <% end %>
            </div>
          </div>
          <%= link_to "Approve", user_approve_path(user), class: "btn btn-sm btn-success", data: { turbo_method: :get } %>
        </div>
      <% end %>
    <% end %>

  <% end %>

  <% if policy(:childcare).enabled? %>
    <%= link_to childcare_index_path, class: "list-group-item list-group-item-action m-0", style: "border-top: 0px;" do %>
      <div class="row">
        <div class="col-lg-10 col-11">
          <i class="fas fa-child"></i>
          &nbsp;
          <%= @upcoming_childcare_reservations.count %> upcoming childcare reservations
        </div>
        <div class="col-1">
          <i class="fas fa-chevron-right"></i>
        </div>
      </div>
    <% end %>
  <% end %>

  <% if @outstanding_invoices.count > 0 %>
    <%= link_to open_invoices_path, class: "list-group-item list-group-item-action d-flx m-0", style: "border-top: 0;" do %>
      <div class="row">
        <div class="col-lg-10 col-11">
          <i class="fas fa-dollar-sign"></i>
          &nbsp;
          <%= @outstanding_invoices.count %> <%= quantize(@outstanding_invoices.count, "outstanding invoice") %>
          -
          <span class="text-muted"><%= number_to_currency(@outstanding_amount) %></span>
          <% if @delinquent_invoices.count > 0 %>
            <div style="font-size: 12px; margin-top: 2px; margin-left: 22px;">
              <span class="text-danger">
                <i class="fas fa-exclamation-circle"></i>
                <%= @delinquent_invoices.count %> past due (<%= number_to_currency(@delinquent_amount) %>)
              </span>
            </div>
          <% end %>
        </div>
        <div class="col-1">
          <i class="fas fa-chevron-right"></i>
        </div>
      </div>
    <% end %>
  <% end %>

  <% if policy(:office).enabled? %>
    <% if @upcoming_renewals.count > 0 %>
      <%= link_to upcoming_renewals_offices_path, class: "list-group-item list-group-item-action d-flx m-0", style: "border-top: 0;" do %>
        <div class="row">
          <div class="col-lg-10 col-11">
            <i class="fas fa-user-clock"></i>
            &nbsp;
            <%= @upcoming_renewals.count %> <%= quantize(@upcoming_renewals.count, "upcoming renewal") %>
          </div>
          <div class="col-1">
            <i class="fas fa-chevron-right"></i>
          </div>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <% if policy(:event).enabled? %>
    <% if @events.count > 0 %>
      <% @events.each do |event| %>
        <%= link_to event_path(event), class: "list-group-item list-group-item-action m-0", style: "border-top: 0px;" do %>
          <i class="far fa-calendar-alt"></i>
          &nbsp;
          <%= event.title %>
          &nbsp;
          <strong class="text-danger"><%= render "operator/events/timestamp", event: event %></strong>
        <% end %>
      <% end %>
    <% end %>

    <%= link_to events_path, class: "list-group-item list-group-item-action m-0", style: "border-top: 0px;" do %>
      <div class="row">
        <div class="col-lg-10 col-11">
          <div class="text-center">
            View all events
          </div>
        </div>
        <div class="col-1">
          <i class="fas fa-chevron-right"></i>
        </div>
      </div>
    <% end %>
  <% end %>

<% end %>


<% if !current_location.onboarded? %>
  <% if mobile_app_request? %>
    <div class="d-flex justify-content-center mb-2 mt-2">
      <%= link_to "Resume onboarding", new_operator_onboarding_path, class: "btn btn-block btn-sm btn-success" %>
    </div>
  <% else %>
    <%= render(OnboardingSidebar.new(operator: current_tenant, location: current_location)) %>
  <% end %>
<% end %>

<div class="modal fade" id="newModal" tabindex="-1" role="dialog" aria-labelledby="newModalTitle">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content">
      <div class="modal-header py-2">
        <h6 class="modal-title mb-0" id="newModalTitle">What would you like to do?</h6>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body p-0">
        <div class="list-group list-group-flush">

          <% if policy(:room).enabled? %>
            <div class="list-group-item bg-light py-1 px-3 text-uppercase text-muted" style="font-size: 11px; letter-spacing: 0.5px;">Reserve</div>

            <%= link_to calendar_reservations_path(reserve_now: true), class: "list-group-item list-group-item-action d-flex align-items-start" do %>
              <i class="fas fa-calendar-alt text-muted mr-3 mt-1" style="width: 18px;"></i>
              <div>
                <div>Reserve now</div>
                <small class="text-muted">Book a room starting right now</small>
              </div>
            <% end %>

            <%= link_to rooms_path, class: "list-group-item list-group-item-action d-flex align-items-start" do %>
              <i class="fas fa-briefcase text-muted mr-3 mt-1" style="width: 18px;"></i>
              <div>
                <div>Reserve a room</div>
                <small class="text-muted">Pick a room and a future time</small>
              </div>
            <% end %>
          <% end %>

          <div class="list-group-item bg-light py-1 px-3 text-uppercase text-muted" style="font-size: 11px; letter-spacing: 0.5px;">Post</div>

          <%= link_to new_feed_item_path, class: "list-group-item list-group-item-action d-flex align-items-start" do %>
            <i class="fas fa-edit text-muted mr-3 mt-1" style="width: 18px;"></i>
            <div>
              <div>Management note</div>
              <small class="text-muted">Share an update with your team</small>
            </div>
          <% end %>

          <% if policy(:announcement).enabled? %>
            <%= link_to new_announcement_path, class: "list-group-item list-group-item-action d-flex align-items-start" do %>
              <i class="fas fa-bullhorn text-muted mr-3 mt-1" style="width: 18px;"></i>
              <div>
                <div>Announcement</div>
                <small class="text-muted">Push a message to all members</small>
              </div>
            <% end %>
          <% end %>

          <% if policy(:event).enabled? %>
            <%= link_to new_event_path, class: "list-group-item list-group-item-action d-flex align-items-start" do %>
              <i class="far fa-calendar-alt text-muted mr-3 mt-1" style="width: 18px;"></i>
              <div>
                <div>Event</div>
                <small class="text-muted">Schedule something on the location calendar</small>
              </div>
            <% end %>
          <% end %>

          <div class="list-group-item bg-light py-1 px-3 text-uppercase text-muted" style="font-size: 11px; letter-spacing: 0.5px;">Add</div>

          <%= link_to add_member_users_path, class: "list-group-item list-group-item-action d-flex align-items-start" do %>
            <i class="fas fa-users text-muted mr-3 mt-1" style="width: 18px;"></i>
            <div>
              <div>Member</div>
              <small class="text-muted">Create a member account manually</small>
            </div>
          <% end %>

          <% if policy(:office).enabled? %>
            <%= link_to new_office_lease_path, class: "list-group-item list-group-item-action d-flex align-items-start" do %>
              <i class="fas fa-file-alt text-muted mr-3 mt-1" style="width: 18px;"></i>
              <div>
                <div>Office lease</div>
                <small class="text-muted">Set up a private office contract</small>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
      <div class="modal-footer py-2">
        <button type="button" class="btn btn-sm btn-outline-secondary" data-dismiss="modal">Cancel</button>
      </div>
    </div>
  </div>
</div>