<%= turbo_frame_tag "comment-form-#{feed_item.id}" do %>
  <%= form_with(model: feed_item.feed_item_comments.new, url: feed_item_comments_path(feed_item, subdomain: current_tenant.subdomain)) do |f| %>
    <div class="row mt-4">
      <div class="col">
        <%# FeedItemComments are INTERNAL — staff-only, never delivered to the
            member the card is about. The old "Write a reply…"/"Send reply"
            wording read like it messaged the member. %>
        <small class="text-muted d-block mb-1">
          <i class="fas fa-lock"></i> Internal note &mdash; staff only. The member never sees feed notes.
        </small>
        <%= f.text_area :comment, class: "form-control", placeholder: "Add an internal note for the team..." %>
      </div>
    </div>

    <div class="row mt-1">
      <div class="col">
        <%= f.submit "Save internal note", class: "btn btn-block btn-primary" %>
      </div>
    </div>
  <%- end %>
<% end %>
