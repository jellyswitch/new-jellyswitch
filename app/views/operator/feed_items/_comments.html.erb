<div>
  <div id="comments-<%= feed_item.id %>">
    <%- feed_item.feed_item_comments.each do |comment| %>
      <%= render "operator/feed_items/comment", feed_item_comment: comment %>
    <%- end %>
  </div>

  <%= turbo_frame_tag "comment-form-#{feed_item.id}" do %>
    <%= form_with(model: feed_item.feed_item_comments.new, url: feed_item_comments_path(feed_item, subdomain: current_tenant.subdomain)) do |f| %>
      <div class="row mt-4">
        <div class="col">
          <%= f.text_area :comment, class: "form-control", placeholder: "Write a reply..." %>
        </div>
      </div>

      <div class="row mt-1">
        <div class="col">
          <%= f.submit "Send reply", class: "btn btn-block btn-primary" %>
        </div>
      </div>
    <%- end %>
  <% end %>
</div>
