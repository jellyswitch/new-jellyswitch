<% title "Home" %>

<%= turbo_stream_from current_tenant, "feed_items" %>

<div class="row mt-1 mb-0 p-0" style="overflow-x: hidden;">
  <div class="col-lg-2 order-2 order-lg-1"></div>
  <div class="col-lg-6 order-3 order-lg-2 m-0 p-0">
    <% if @feed_items.count > 0 %>
      <%= list_wrapper do %>
        <div id="feed-items">
          <% @feed_items.each do |feed_item| %>
            <%= render partial: "operator/feed_items/feed_item", locals: { feed_item: feed_item } %>
          <% end %>
        </div>
      <% end %>

      <%== pagy_bootstrap_nav(@pagy) %>
    <% else %>
      <%= list_wrapper do %>
        <div id="feed-items">
          <%= list_item do %>
            No feed items yet!
          <% end %>
        </div>
      <% end %>
    <% end %>

  </div>
  <div class="col-lg-3 order-1 order-lg-3 mt-1 mb-2 p-0 pl-lg-2 pr-lg-2">
    <%= render "sidebar" %>
  </div>

  <div class="col-lg-1 order-4"></div>
</div>