<% if feed_item.expense? && feed_item.amount.to_i > 0 %>
  <dl class="row">
    <dt class="col-6">
      Amount:
    </dt>
    <dd class="col">
      <span class="text-danger">
        <%= number_to_currency(feed_item.amount.to_f/100.0)  %>
      </span>
    </dd>
  </dl>
<% end %>

<% body_style = "overflow-wrap: break-word;" %>
<% body_style += " white-space: pre-wrap;" unless feed_item.rich_html_body? %>
<div class="feed-item-post-body" style="<%= body_style %>">
  <%= feed_item.text %>
</div>

<%- if feed_item.has_photos? %>
  <div class="row mt-1 mb-3">
    <div class="col">
    <%- feed_item.feed_photos.each do |photo| %>
      <%= image_tag photo, class: "img-fluid" %>
    <%- end %>
    </div>
  </div>
<%- end %>