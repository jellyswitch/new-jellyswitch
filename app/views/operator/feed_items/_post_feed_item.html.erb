<% if feed_item.expense? %>
  <dl class="row">
    <dt class="col-6">
      Amount:
    </dt>
    <dd class="col">
      <span class="text-danger">
        <%= number_to_currency(feed_item.amount.to_f/100.0)  %>
      </span>
    </dd>
  </dl>
<% end %>

<div class="feed-item-post-body" style="overflow-wrap: break-word; white-space: pre-wrap;">
  <%= feed_item.text %>
</div>

<%- if feed_item.has_photos? %>
  <div class="row mt-1 mb-3">
    <div class="col">
    <%- feed_item.feed_photos.each do |photo| %>
      <%= image_tag photo, class: "img-fluid" %>
    <%- end %>
    </div>
  </div>
<%- end %>