<%= form_for(feed_item, html: {multipart: true}, **feed_item_remote_params , data: { type: :html, turbo: feed_item_turbo_value }) do |f| %>
  <%= render "shared/error_messages" , model: feed_item %>
  <div>
    <%= f.rich_text_area :text, placeholder: "What do you want the team to know?", data: { controller: "mentions", mentions_target: "field" }, id: "text" %>
  </div>
  <p class="text-muted small mt-1 mb-3">
    <i class="fas fa-at"></i> Type <code>@</code> to mention a teammate.
  </p>
  <div class="form-group row m-0 p-0">
    <%# No client-side enable/disable gate: the old shared/disable_button bound
        keyup/input on the hidden field, but this is a Trix rich-text editor
        which fires `trix-change` on the <trix-editor> — so the gate left the
        button permanently disabled and notes couldn't be posted. The button is
        always submittable (ActionText's default UX); an empty note is rejected
        server-side. %>
    <button class="form-control btn btn-primary col" id="submit" data-disable-with="Posting...">
      <i class="fas fa-edit"></i>
      &nbsp;
      Post management note
    </button>
  </div>
<%- end %>
