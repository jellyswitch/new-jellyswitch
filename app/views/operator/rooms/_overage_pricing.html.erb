<%= render Layout::FullWidth.new do %>
  <%= list_item do %>
    <h4 class="display-4 text-center">Meeting Room Pricing</h4>
    <%= form_with model: current_location, url: settings_update_payments_path(location_id: current_location.id), method: :patch, local: true do |f| %>
      <div class="form-group">
        <%= f.label :overage_rate, "Overage / add-on meeting room time (per hour)" %>
        <div class="input-group">
          <div class="input-group-prepend">
            <span class="input-group-text">$</span>
          </div>
          <%= f.text_field :overage_rate, class: "form-control",
                value: number_with_precision(current_location.overage_rate_in_cents / 100.0, precision: 2) %>
        </div>
        <small class="form-text text-muted">
          Hourly rate billed for $0 "call" rooms beyond a day pass's included
          minutes — and for anyone booking a call room with no day pass. Priced
          meeting rooms always bill at their own hourly rate.
        </small>
      </div>
      <%= f.submit "Save", class: "btn btn-primary" %>
    <% end %>
  <% end %>
<% end %>
