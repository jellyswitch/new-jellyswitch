<%- title @room.name %>

<%= render "shared/back_bar", back_path: rooms_path, back_label: "Rooms", page_title: @room.name %>

<%= render Layout::FullWidth.new do %>
  <%= list_item do %>
    <%= render partial: "operator/rooms/room", locals: { room: @room } %>
  <% end %>
<% end %>

<%= render Layout::FullWidth.new do %>
  <%= list_item do %>
    <h4 class="display-4 text-center mt-4">Reservations</h4>
    <%- if @reservations.count < 1 %>
      (none)
    <%- else %>
      <ul class="list-group list-group-flush">
        <%- @reservations.each do |reservation| %>
          <%= render "operator/reservations/reservation_card", reservation: reservation %>
        <%- end %>
      </ul>
    <%- end %>
    <%== pagy_bootstrap_nav(@pagy) %>
  <% end %>
<% end %>