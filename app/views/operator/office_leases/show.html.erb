<% title "Lease" %>

<%= breadcrumb do %>
  <li class="breadcrumb-item"><%= link_to "Offices", offices_path %></li>
  <li class="breadcrumb-item"><%= link_to @office_lease.office.name, office_path(@office_lease.office) %></li>
  <li class="breadcrumb-item active" aria-current="page">Lease for <%= @office_lease.office.name %></li>
<% end %>

<%= render Layout::FullWidth.new do %>

  <%= list_item do %>
    <h4 class="display-4 text-center">Lease for <%= @office_lease.office.name %></h4>

    <dl class="row">
      <dt class="col-sm-3"><%= @office_lease.individual_lease? ? "Member" : "Group" %></dt>
      <dd class="col-sm">
        <% if @office_lease.individual_lease? %>
          <%= link_to @office_lease.user.name, user_path(@office_lease.user) %>
        <% else %>
          <%= link_to @office_lease.organization.name, organization_path(@office_lease.organization) %>
        <% end %>
      </dd>
    </dl>

    <dl class="row">
      <dt class="col-sm-3">Office</dt>
      <dd class="col-sm">
        <%= link_to @office_lease.office_name, office_path(@office_lease.office) %>
      </dd>
    </dl>

    <dl class="row">
      <dt class="col-sm-3">Plan</dt>
      <dd class="col-sm">
        <%= pretty_price(@office_lease) %>
      </dd>
    </dl>

    <dl class="row">
      <dt class="col-sm-3">Lease Start Date</dt>
      <dd class="col-sm">
        <%= short_date(@office_lease.start_date) %>
      </dd>
    </dl>

    <dl class="row">
      <dt class="col-sm-3">Lease End Date</dt>
      <dd class="col-sm">
        <div class="row">
          <div class="col">
            <%= short_date(@office_lease.end_date) %>
          </div>
        </div>
      </dd>
    </dl>

    <dl class="row">
      <dt class="col-sm-3">Initial Invoice Date</dt>
      <dd class="col-sm">
        <%= short_date(@office_lease.initial_invoice_date) %>
      </dd>
    </dl>

    <% if @office_lease.deposit_amount_in_cents.to_i > 0 %>
      <dl class="row">
        <dt class="col-sm-3">Deposit / Setup Fee</dt>
        <dd class="col-sm"><%= number_to_currency(@office_lease.deposit_amount_in_cents / 100.0) %></dd>
      </dl>
    <% end %>

    <dl class="row">
      <dt class="col-sm-3">Always allow building access?</dt>
      <dd class="col-sm"><%= boolean_to_yesno(@office_lease.always_allow_building_access?) %></dd>
    </dl>

    <% if @office_lease.individual_lease? && @office_lease.active? %>
      <%= form_with url: office_lease_convert_to_organization_path(@office_lease), method: :post, local: true do %>
        <%= submit_tag "Convert to Organization (add members)", class: "btn btn-block btn-outline-primary mb-2", data: { confirm: "This will create an organization for this lease so you can add additional members. Continue?" } %>
      <% end %>
    <% end %>

    <% if @office_lease.individual_lease? %>
      <%= link_to "View Invoices", user_invoices_path(@office_lease.user), class: "btn btn-block btn-outline-primary mb-2" %>
    <% elsif @office_lease.organization.present? %>
      <%= link_to "View Invoices", organization_invoices_path(@office_lease.organization), class: "btn btn-block btn-outline-primary mb-2" %>
    <% end %>

    <% if @office_lease.has_lease? %>
      <%= link_to "Download Lease", rails_blob_path(@office_lease.lease_agreement, disposition: "attachment"), class: "btn btn-block btn-primary" %>
    <% end %>

    <% if policy(@office_lease).edit_price? %>
      <%= link_to "Update Lease Pricing", office_lease_edit_price_path(@office_lease), class: "btn btn-block btn-primary" %>
    <% end %>

    <% if @office_lease.has_pending_renewal? %>
      <% renewal = @office_lease.pending_renewal_request %>
      <div class="alert alert-info mt-2">
        <strong>Renewal In Progress</strong>
        <br>
        <small>
          <%= renewal.current_price_formatted %> → <%= renewal.proposed_price_formatted %>
          (<%= renewal.escalation_applied %>)
          — Status: <%= renewal.status.humanize %>
        </small>
        <br>
        <% if current_user.admin_or_manager?(current_location) %>
          <%= link_to "Review Renewal", admin_review_lease_renewal_request_path(renewal), class: "btn btn-sm btn-outline-primary mt-1" %>
        <% else %>
          <%= link_to "View Renewal", lease_renewal_request_path(renewal), class: "btn btn-sm btn-outline-primary mt-1" %>
        <% end %>
      </div>
    <% elsif @office_lease.eligible_for_renewal? %>
      <%= link_to "Setup Renewal Lease", office_lease_renewal_path(@office_lease), class: "btn btn-block btn-primary" %>
    <% end %>

    <% if @office_lease.auto_renew? %>
      <div class="mt-2">
        <small class="text-muted">
          <i class="fas fa-sync-alt"></i> Auto-renewal enabled
          <% if @office_lease.escalation_type.present? %>
            — <%= @office_lease.escalation_description %>
          <% end %>
        </small>
      </div>
    <% end %>

    <% if @office_lease.subscription_active? %>
      <%= link_to "Terminate Lease (end of billing cycle)", office_lease_path(@office_lease), data: { turbo_method: :delete }, class: "btn btn-block btn-danger" %>
      <%= link_to "Terminate Lease (now)", destroy_office_lease_now_path(@office_lease), data: { turbo_method: :delete }, class: "btn btn-block btn-danger" %>
    <% end %>

  <% end %>

  <% if superadmin? %>
    <%= list_item do %>
      <h4 class="display-4 text-center">Debug</h4>

      <dl>
        <dt>ID</dt>
        <dd><%= @office_lease.subscription.stripe_subscription_id %></dd>

        <dt>End Date</dt>
        <dd>
          <% if @office_lease.subscription.has_end_date? %>
            <%= short_date(@office_lease.subscription.end_date) %>
          <% else %>
            None
          <% end %>
        </dd>
      </dl>
    <% end %>
  <% end %>
<% end %>
