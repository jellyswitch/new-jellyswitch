<% title "Onboarding" %>

<div class="row mt-3">
</div>

<%= wide_card do %>
  <div class="p-3">
  <h4 class="display-4 text-center mb-3">Let's get your space ready for customers!</h4>

  <ul class="list-group list-group-flush">
    <li class="list-group-item">
      <div class="row">
        <div class="col-1">
          <%= render "checkbox", checked: current_tenant.stripe_user_id.present? %>
        </div>
        <div class="col">
          <%= link_to "Connect Stripe", new_stripe_connect_operator_onboarding_index_path, class: "btn btn-block btn-primary" %>
        </div>
      </div>
    </li>

    <li class="list-group-item">
      <div class="row">
        <div class="col-1">
          <%= render "checkbox", checked: !@branding_incomplete %>
        </div>
        <div class="col">
          <%= link_to "Add your logo & branding", new_branding_operator_onboarding_index_path, class: "btn btn-block btn-primary" %>
        </div>
      </div>
    </li>

    <li class="list-group-item">
      <div class="row">
        <div class="col-1">
          <%= render "checkbox", checked: true %>
        </div>
        <div class="col">
          <%= link_to "Configure your space settings", new_settings_operator_onboarding_index_path, class: "btn btn-block btn-primary" %>
        </div>
      </div>
    </li>

    <li class="list-group-item">
      <div class="row">
        <div class="col-1">
          <%= render "checkbox", checked: current_location.plans.count > 0 %>
        </div>
        <div class="col">
          <%= link_to "Set up membership plans", new_membership_plan_operator_onboarding_index_path, class: "btn btn-block btn-primary" %>
        </div>

      </div>
    </li>

    <li class="list-group-item">
      <div class="row">
        <div class="col-1">
          <%= render "checkbox", checked: current_location.day_pass_types.count > 0 %>
        </div>
        <div class="col">
          <%= link_to "Set up day passes", new_day_pass_type_operator_onboarding_index_path, class: "btn btn-block btn-primary" %>
        </div>
      </div>
    </li>

    <% if policy(:room).enabled? %>
      <li class="list-group-item">
        <div class="row">
          <div class="col-1">
            <%= render "checkbox", checked: current_location.rooms.count > 0 %>
          </div>
          <div class="col">
            <%= link_to "Add reservable conference and/or phone rooms", new_room_operator_onboarding_index_path, class: "btn btn-block btn-primary" %>
          </div>
        </div>
      </li>
    <% end %>

    <% if policy(:door).enabled? %>
      <li class="list-group-item">
        <div class="row">
          <div class="col-1">
            <%= render "checkbox", checked: current_location.doors.count > 0 %>
          </div>
          <div class="col">
            <%= link_to "Set up building access", new_kisi_operator_onboarding_index_path, class: "btn btn-block btn-primary" %>
          </div>
        </div>
      </li>
    <% end %>

    <li class="list-group-item">
      <div class="row">
        <div class="col-1">
          <%= render "checkbox", checked: current_location.users.members.count > 0 %>
        </div>
        <div class="col">
          <%= link_to "Import your member information", add_members_operator_onboarding_index_path, class: "btn btn-block btn-primary" %>
        </div>
      </div>
    </li>
  </ul>
  <div class="row mt-4">
    <%= link_to "Skip onboarding", skip_operator_onboarding_index_path, class: "btn btn-block btn-outline-info" %>
  </div>

  <% if @branding_incomplete %>
    <div class="alert alert-warning mt-4">
      <strong>Finish your branding</strong> before inviting members — your logo, "about" snippet, and terms of service show up in member emails and screens.
      <%= link_to "Add your branding", new_branding_operator_onboarding_index_path, class: "btn btn-sm btn-primary mt-2" %>
    </div>
  <% end %>

  <% if !@branding_incomplete %>
    <div class="mt-4">
      <% if current_tenant.mobile_app_requested_at.present? %>
        <p class="text-muted">Mobile app requested on <%= current_tenant.mobile_app_requested_at.to_date %>.</p>
      <% else %>
        <%= button_to "Create mobile app", request_mobile_app_operator_onboarding_index_path,
              method: :post, class: "btn btn-outline-primary" %>
      <% end %>
    </div>
  <% end %>
  </div>
<% end %>
