<div class="container py-4" style="max-width: 760px;">
  <h2>Concierge inbox</h2>
  <p class="text-muted">Live chats from your website Concierge. Reply here or from the mobile app.</p>

  <% if @conversations.empty? %>
    <p class="text-muted">No active conversations right now.</p>
  <% else %>
    <div class="list-group">
      <% @conversations.each do |c| %>
        <% last = c.messages.max_by(&:created_at) %>
        <%= link_to concierge_conversation_path(c), class: "list-group-item list-group-item-action" do %>
          <div class="d-flex justify-content-between">
            <strong><%= c.user&.name || "Website visitor" %><%= " · #{c.location.name}" if c.location %></strong>
            <% if c.awaiting_staff_timeout? %>
              <span class="badge badge-warning">waiting</span>
            <% elsif c.status == "staffed" %>
              <span class="badge badge-success">replied</span>
            <% end %>
          </div>
          <div class="text-muted small text-truncate"><%= last&.body %></div>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
