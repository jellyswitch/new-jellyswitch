<div class="container py-4" style="max-width: 680px;">
  <%= link_to "← Inbox", concierge_conversations_path, class: "btn btn-sm btn-link px-0" %>
  <h4>
    <%= @conversation.user&.name || "Website visitor" %>
    <% if @conversation.location %><small class="text-muted">· <%= @conversation.location.name %></small><% end %>
  </h4>

  <div id="thread" data-poll-url="<%= messages_concierge_conversation_path(@conversation) %>"
       style="border:1px solid #e5e7eb; border-radius:8px; padding:14px; height:50vh; overflow-y:auto; display:flex; flex-direction:column; gap:8px;">
    <% @messages.each do |m| %>
      <div class="cxm cxm-<%= m.role %>" data-id="<%= m.id %>"
           style="max-width:80%; padding:8px 12px; border-radius:12px; font-size:14px;
                  <%= m.role == 'visitor' ? 'align-self:flex-start; background:#f3f4f6;' : 'align-self:flex-end; background:#2563eb; color:#fff;' %>">
        <%= m.body %>
        <% if m.role == "staff" && m.author %><div style="font-size:11px; opacity:.8;"><%= m.author.name %></div><% end %>
      </div>
    <% end %>
  </div>

  <%= form_with url: reply_concierge_conversation_path(@conversation), method: :post, local: true, class: "mt-3" do |f| %>
    <div class="input-group">
      <%= text_field_tag :body, nil, class: "form-control", placeholder: "Type your reply…", autocomplete: "off", autofocus: true %>
      <%= f.submit "Send", class: "btn btn-primary" %>
    </div>
  <% end %>
</div>

<script>
  (function () {
    var box = document.getElementById("thread");
    var pollUrl = box.dataset.pollUrl;
    function lastId() {
      var nodes = box.querySelectorAll("[data-id]");
      return nodes.length ? parseInt(nodes[nodes.length - 1].dataset.id, 10) : 0;
    }
    box.scrollTop = box.scrollHeight;
    setInterval(function () {
      fetch(pollUrl + "?after=" + lastId())
        .then(function (r) { return r.json(); })
        .then(function (msgs) {
          (msgs || []).forEach(function (m) {
            var d = document.createElement("div");
            d.className = "cxm cxm-" + m.role; d.dataset.id = m.id; d.textContent = m.body;
            d.style.cssText = "max-width:80%; padding:8px 12px; border-radius:12px; font-size:14px;" +
              (m.role === "visitor" ? "align-self:flex-start; background:#f3f4f6;" : "align-self:flex-end; background:#2563eb; color:#fff;");
            box.appendChild(d); box.scrollTop = box.scrollHeight;
          });
        }).catch(function () {});
    }, 4000);
  })();
</script>
