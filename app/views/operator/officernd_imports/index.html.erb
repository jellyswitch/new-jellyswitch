<% title "OfficeRnD imports" %>

<%= breadcrumb do %>
  <li class="breadcrumb-item"><%= link_to "Onboarding", new_operator_onboarding_path %></li>
  <li class="breadcrumb-item active" aria-current="page">OfficeRnD imports</li>
<% end %>

<%
  badge_class = {
    "committed" => "badge-success",
    "previewed" => "badge-info",
    "committing" => "badge-warning",
    "pending" => "badge-secondary",
    "failed" => "badge-danger",
  }

  resume_path = lambda do |imp|
    case imp.status
    when "committed" then result_officernd_import_path(imp)
    when "committing" then processing_officernd_import_path(imp)
    when "failed", "previewed" then preview_officernd_import_path(imp)
    else map_officernd_import_path(imp)
    end
  end

  outcome = lambda do |imp|
    s = imp.result_log["summary"] || {}
    next "" if s.blank?
    if imp.invoices?
      "#{s['invoices_created'].to_i} created, #{s['invoices_updated'].to_i} updated, #{s['skipped'].to_i} skipped"
    elsif imp.day_passes?
      "#{s['day_passes_created'].to_i} created, #{s['skipped'].to_i} skipped"
    else
      "#{s['users_created'].to_i} created, #{s['users_updated'].to_i} updated, #{s['subscriptions_created'].to_i} subs"
    end
  end
%>

<%= wide_card do %>
  <div class="d-flex justify-content-between align-items-center mt-3">
    <h4 class="mb-0">OfficeRnD imports</h4>
    <%= link_to "New import", new_officernd_import_path, class: "btn btn-primary" %>
  </div>

  <% if @imports.empty? %>
    <p class="text-muted mt-4">No imports yet. <%= link_to "Start one", new_officernd_import_path %>.</p>
  <% else %>
    <div class="table-responsive mt-3">
      <table class="table">
        <thead>
          <tr><th>When</th><th>Type</th><th>Rows</th><th>Status</th><th>Outcome</th><th>By</th><th></th></tr>
        </thead>
        <tbody>
          <% @imports.each do |imp| %>
            <tr>
              <td><%= imp.created_at.strftime("%b %-d, %Y %-l:%M%P") %></td>
              <td><%= imp.kind.titleize %></td>
              <td><%= imp.row_count %></td>
              <td><span class="badge <%= badge_class[imp.status] || 'badge-secondary' %>"><%= imp.status %></span></td>
              <td class="small text-muted"><%= outcome.call(imp) %></td>
              <td class="small"><%= imp.created_by&.name %></td>
              <td><%= link_to "View", resume_path.call(imp), class: "btn btn-sm btn-outline-secondary" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
<% end %>
