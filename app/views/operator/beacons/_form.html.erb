<%= form_with(model: @beacon) do |f| %>
  <%= render "shared/error_messages", model: @beacon %>

  <div class="form-group">
    <%= f.label :name %>
    <%= f.text_field :name, class: "form-control", placeholder: "Front Door" %>
  </div>

  <div class="form-group">
    <%= f.label :uuid, "iBeacon UUID" %>
    <%= f.text_field :uuid, class: "form-control", placeholder: "426C7565-4368-6172-6D42-6561636F6E73" %>
    <small class="form-text text-muted">
      The proximity UUID broadcast by the BC04P. Find it in the BlueCharm config app.
    </small>
  </div>

  <div class="row">
    <div class="col">
      <div class="form-group">
        <%= f.label :major %>
        <%= f.number_field :major, class: "form-control", min: 0, max: 65535 %>
      </div>
    </div>
    <div class="col">
      <div class="form-group">
        <%= f.label :minor %>
        <%= f.number_field :minor, class: "form-control", min: 0, max: 65535 %>
      </div>
    </div>
  </div>

  <div class="form-group">
    <%= f.label :door_id, "Door" %>
    <%= f.collection_select :door_id,
        current_location.doors.available.order(:name),
        :id, :name,
        { include_blank: "— unassigned —" },
        { class: "form-control" } %>
    <small class="form-text text-muted">
      Which door this beacon unlocks. Beacons without a door assignment are ignored by the auto-unlock API.
    </small>
  </div>

  <div class="form-group">
    <%= f.label :installed_at %>
    <%= f.date_field :installed_at, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= f.label :notes %>
    <%= f.text_area :notes, class: "form-control", rows: 2 %>
  </div>

  <%= f.submit label, class: "form-control btn btn-primary" %>
<%- end %>
