<%- title "Beacons" %>

<%= turbo_frame_tag "beacons_list" do %>
  <%= wide_card do %>
    <h4 class="display-4 text-center">Door Beacons</h4>
    <p class="text-center text-muted">
      BLE beacons mounted near each door let members unlock by approach.
      Showing beacons for <strong><%= current_location.name %></strong>.
    </p>

    <%= link_to "Add a Beacon", new_beacon_path, class: "btn btn-block btn-primary" %>

    <%= link_to archived_beacons_path, class: "list-group-item list-group-item-action d-flex m-0 mt-3" do %>
      <div class="row w-100">
        <div class="col-11">
          <i class="fas fa-archive"></i>
          &nbsp;
          Archived Beacons
        </div>
        <div class="col-1">
          <i class="fas fa-chevron-right"></i>
        </div>
      </div>
    <% end %>
  <% end %>

  <% if @beacons.empty? %>
    <%= wide_card do %>
      <p class="text-center text-muted my-3">
        No beacons configured yet. Click <strong>Add a Beacon</strong> above to register your first BC04P.
      </p>
    <% end %>
  <% else %>
    <% @beacons.each do |beacon| %>
      <%= wide_card do %>
        <%= render beacon %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
