<%- title "Day Pass Types" %>

<%= render "shared/back_bar", back_path: plans_day_passes_path, back_label: "Plans & Day Passes", page_title: "Day Passes" %>

<%= render Layout::FullWidth.new do %>
  <%= list_item do %>
    <h4 class="display-4 text-center mt-4 mb-4">Day Pass Types</h4>

    <%= link_to "Add a new day pass type", new_day_pass_type_path, class: "btn btn-primary btn-block" %>
  <% end %>

  <%= link_to archived_day_pass_types_path, class: "list-group-item list-group-item-action d-flex m-0" do %>
    <div class="row w-100">
      <div class="col-11">
        <i class="fas fa-archive"></i>
        &nbsp;
        Archived Day Pass Types
      </div>
      <div class="col-1">
        <i class="fas fa-chevron-right"></i>
      </div>
    </div>
  <% end %>

  <% if @day_pass_types.count < 1 %>
    <%= list_item do %>
      <i>There are no day pass types available.</i>
    <% end %>
  <% else %>
    <div class="list-group list-group-flush mt-4">
      <%= render partial: "operator/day_pass_types/day_pass_type", collection: @day_pass_types, as: :day_pass_type, locals: { view: true } %>
    </div>
  <% end %>
<% end %>