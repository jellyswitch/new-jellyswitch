<%- title "Archived Day Pass Types" %>

<%= breadcrumb do %>
  <li class="breadcrumb-item"><%= link_to "Plans & Day Passes", plans_day_passes_path %></li>
  <li class="breadcrumb-item"><%= link_to "Day Passes", day_pass_types_path %></li>
  <li class="breadcrumb-item active" aria-current="page">Archived</li>
<% end %>

<%= render Layout::FullWidth.new do %>
  <%= list_item do %>
    <h4 class="display-4 text-center">Archived Day Pass Types</h4>

    <% if @day_pass_types.count < 1 %>
      <i>All day pass types are available.</i>
    <% else %>
      <div class="list-group list-group-flush mt-4">
        <% @day_pass_types.each do |day_pass_type| %>
          <div class="list-group-item">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <strong><%= day_pass_type.name %></strong>
                <br>
                <small class="text-muted"><%= number_to_currency(day_pass_type.amount_in_cents.to_f / 100) %></small>
              </div>
              <%= link_to "Unarchive", day_pass_type_unarchive_path(day_pass_type), method: :post, class: "btn btn-sm btn-success", data: { confirm: "Unarchive #{day_pass_type.name}?" } %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>
