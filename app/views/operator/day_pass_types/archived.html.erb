<%- title "Archived Day Pass Types" %>

<%= render "shared/back_bar", back_path: plans_day_passes_path, back_label: "Plans & Day Passes", page_title: "Archived" %>

<%= render Layout::FullWidth.new do %>
  <%= list_item do %>

    <% if @day_pass_types.count < 1 %>
      <i>All day pass types are available.</i>
    <% else %>
      <div class="list-group list-group-flush mt-4">
        <% @day_pass_types.each do |day_pass_type| %>
          <div class="list-group-item">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <strong><%= day_pass_type.name %></strong>
                <br>
                <small class="text-muted"><%= number_to_currency(day_pass_type.amount_in_cents.to_f / 100) %></small>
              </div>
              <%= link_to "Unarchive", day_pass_type_unarchive_path(day_pass_type), class: "btn btn-sm btn-success", data: { turbo_method: :post, turbo_confirm: "Unarchive #{day_pass_type.name}?" } %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>
