<%- title @day_pass_type.name %>

<%= render "shared/back_bar", back_path: day_pass_types_path, back_label: "Day Passes", page_title: "Day Pass Details" %>

<%= render Layout::FullWidth.new do %>
  <div class="list-group list-group-flush">
    <%= render partial: "operator/day_pass_types/day_pass_type", locals: { day_pass_type: @day_pass_type, view: false } %>
  </div>

  <% if @day_pass_type.available? %>
    <%= link_to "Archive", day_pass_type_path(@day_pass_type),
          data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to archive #{@day_pass_type.name}?" },
          class: "btn btn-outline-danger btn-block mt-3" %>
  <% end %>
<% end %>