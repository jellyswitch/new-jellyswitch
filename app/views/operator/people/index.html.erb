<% title "People (CRM)" %>

<%= wide_card do %>
  <%= render "shared/people_subnav", active_tab: "people" %>
  <%= render "operator/people/guide" %>
  <h4 class="display-4 text-center mb-3">People</h4>
  <p class="text-muted text-center mb-3">
    <%= @pagy.count %> <%= "person".pluralize(@pagy.count) %>
    <%= " in #{Operator::PeopleController::STAGE_LABELS[@stage]}" unless @stage == "all" %>
  </p>

  <div class="text-center mb-4">
    <% Operator::PeopleController::STAGE_LABELS.each do |key, label| %>
      <% active = @stage == key %>
      <%= link_to label,
                  people_path(stage: key == "all" ? nil : key, owned_by_me: @owned_by_me ? 1 : nil),
                  class: "btn btn-sm #{active ? 'btn-primary' : 'btn-outline-secondary'} mr-1 mb-1" %>
    <% end %>
  </div>

  <div class="text-center mb-3">
    <div class="dropdown d-inline-block">
      <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
        From: <%= from_filter_label(@from, primary_city: @primary_city) %>
      </button>
      <div class="dropdown-menu">
        <%= link_to "Any", people_path(stage: @stage == "all" ? nil : @stage, owned_by_me: @owned_by_me ? 1 : nil), class: "dropdown-item" %>
        <% if @primary_city.present? %>
          <%= link_to "#{@primary_city} (local)", people_path(stage: @stage == "all" ? nil : @stage, owned_by_me: @owned_by_me ? 1 : nil, from: "local"), class: "dropdown-item" %>
          <%= link_to "Out of town", people_path(stage: @stage == "all" ? nil : @stage, owned_by_me: @owned_by_me ? 1 : nil, from: "out"), class: "dropdown-item" %>
          <% if @available_states.any? %><div class="dropdown-divider"></div><% end %>
        <% end %>
        <% @available_states.each do |state| %>
          <%= link_to "State: #{state}", people_path(stage: @stage == "all" ? nil : @stage, owned_by_me: @owned_by_me ? 1 : nil, from: "state:#{state}"), class: "dropdown-item" %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="text-center mb-3">
    <%= link_to (@owned_by_me ? "Showing only people I own" : "People I own"),
                people_path(stage: @stage == "all" ? nil : @stage, owned_by_me: @owned_by_me ? nil : 1),
                class: "btn btn-sm #{@owned_by_me ? 'btn-primary' : 'btn-outline-secondary'}" %>
  </div>

  <% if @people.any? %>
    <ul class="list-group list-group-flush">
      <% @people.each do |person| %>
        <li class="list-group-item">
          <div class="d-flex align-items-center">
            <%= render "shared/small_profile_photo", user: person %>
            <div class="ml-3 flex-grow-1">
              <div>
                <%= link_to person.name, user_path(person), class: "font-weight-bold" %>
                <%= stage_badge(person.lifecycle_stage) %>
              </div>
              <div class="text-muted small">
                <% last = @last_activity_by_user_id[person.id] %>
                <% if last %>
                  Last activity: <%= time_ago_in_words(last) %> ago
                <% else %>
                  No activity yet
                <% end %>
                <% if person.point_of_contact %>
                  · Owner: <%= person.point_of_contact.name %>
                <% end %>
              </div>
              <% if person.home_city.present? %>
                <div class="text-muted small">From: <%= person.home_city %><%= ", #{person.home_state}" if person.home_state.present? %></div>
              <% end %>
            </div>
          </div>
        </li>
      <% end %>
    </ul>

    <div class="mt-3">
      <%== pagy_bootstrap_nav(@pagy) %>
    </div>
  <% else %>
    <p class="text-center text-muted my-5">No people in this stage yet.</p>
  <% end %>
<% end %>
