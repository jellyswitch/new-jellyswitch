<% title "People (CRM)" %>

<%= wide_card do %>
  <%= render "shared/people_subnav", active_tab: "people" %>
  <%= render "operator/people/guide" %>
  <h4 class="display-4 text-center mb-3">People</h4>
  <p class="text-muted text-center mb-3">
    <%= @pagy.count %> <%= "person".pluralize(@pagy.count) %>
    <%= " matching \"#{@q}\"" if @q.present? %>
    <%= " in #{Operator::PeopleController::STAGE_LABELS[@stage]}" unless @stage == "all" %>
  </p>

  <%= form_with(url: people_path, method: :get, local: true, class: "mb-3") do |f| %>
    <%= f.hidden_field :stage, value: @stage if @stage != "all" %>
    <%= f.hidden_field :owned_by_me, value: 1 if @owned_by_me %>
    <%= f.hidden_field :from, value: @from if @from.present? %>
    <div class="input-group">
      <%= f.text_field :q, value: @q, placeholder: "Search by name, email, or zip", class: "form-control", "aria-label": "Search people" %>
      <div class="input-group-append">
        <%= f.submit "Search", class: "btn btn-primary" %>
        <% if @q.present? %>
          <%= link_to "Clear", people_path(stage: @stage == "all" ? nil : @stage, owned_by_me: @owned_by_me ? 1 : nil, from: @from.presence), class: "btn btn-outline-secondary" %>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="text-center mb-4">
    <% Operator::PeopleController::STAGE_LABELS.each do |key, label| %>
      <% active = @stage == key %>
      <%= link_to label,
                  people_path(stage: key == "all" ? nil : key, owned_by_me: @owned_by_me ? 1 : nil, from: @from.presence, q: @q.presence),
                  class: "btn btn-sm #{active ? 'btn-primary' : 'btn-outline-secondary'} mr-1 mb-1" %>
    <% end %>
  </div>

  <div class="text-center mb-3">
    <div class="dropdown d-inline-block">
      <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
        From: <%= from_filter_label(@from, primary_city: @primary_city) %>
      </button>
      <div class="dropdown-menu">
        <%= link_to "Any", people_path(stage: @stage == "all" ? nil : @stage, owned_by_me: @owned_by_me ? 1 : nil, q: @q.presence), class: "dropdown-item" %>
        <% if @primary_city.present? %>
          <%= link_to "#{@primary_city} (local)", people_path(stage: @stage == "all" ? nil : @stage, owned_by_me: @owned_by_me ? 1 : nil, from: "local", q: @q.presence), class: "dropdown-item" %>
          <%= link_to "Out of town", people_path(stage: @stage == "all" ? nil : @stage, owned_by_me: @owned_by_me ? 1 : nil, from: "out", q: @q.presence), class: "dropdown-item" %>
          <% if @available_states.any? %><div class="dropdown-divider"></div><% end %>
        <% end %>
        <% @available_states.each do |state| %>
          <%= link_to "State: #{state}", people_path(stage: @stage == "all" ? nil : @stage, owned_by_me: @owned_by_me ? 1 : nil, from: "state:#{state}", q: @q.presence), class: "dropdown-item" %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="text-center mb-3">
    <%= link_to (@owned_by_me ? "Showing only people I own" : "People I own"),
                people_path(stage: @stage == "all" ? nil : @stage, owned_by_me: @owned_by_me ? nil : 1, from: @from.presence, q: @q.presence),
                class: "btn btn-sm #{@owned_by_me ? 'btn-primary' : 'btn-outline-secondary'}" %>
  </div>

  <% if @people.any? %>
    <% if @pagy.pages > 1 %>
      <div class="d-flex justify-content-between align-items-center mb-3 py-2 px-3 bg-light rounded">
        <% if @pagy.prev %>
          <%= link_to "‹ Prev", url_for(request.query_parameters.merge(page: @pagy.prev)), class: "btn btn-sm btn-outline-secondary" %>
        <% else %>
          <span class="btn btn-sm btn-outline-secondary disabled">‹ Prev</span>
        <% end %>
        <span class="text-muted small">Page <%= @pagy.page %> of <%= @pagy.pages %> · <%= @pagy.count %> <%= "person".pluralize(@pagy.count) %></span>
        <% if @pagy.next %>
          <%= link_to "Next ›", url_for(request.query_parameters.merge(page: @pagy.next)), class: "btn btn-sm btn-outline-secondary" %>
        <% else %>
          <span class="btn btn-sm btn-outline-secondary disabled">Next ›</span>
        <% end %>
      </div>
    <% end %>

    <ul class="list-group list-group-flush">
      <% @people.each do |person| %>
        <li class="list-group-item">
          <div class="d-flex align-items-center">
            <%= render "shared/small_profile_photo", user: person %>
            <div class="ml-3 flex-grow-1">
              <div>
                <%= link_to person.name, user_path(person), class: "font-weight-bold" %>
                <%= stage_badge(person.lifecycle_stage) %>
              </div>
              <div class="text-muted small">
                <% last = @last_activity_by_user_id[person.id] %>
                <% if last %>
                  Last activity: <%= time_ago_in_words(last) %> ago
                <% else %>
                  No activity yet
                <% end %>
                <% if person.point_of_contact %>
                  · Owner: <%= person.point_of_contact.name %>
                <% end %>
              </div>
              <% if person.home_city.present? || person.home_zip.present? %>
                <div class="text-muted small">
                  From:
                  <%= person.home_city if person.home_city.present? %><%= ", #{person.home_state}" if person.home_state.present? %><%= person.home_city.present? ? " · " : "" %><%= person.home_zip if person.home_zip.present? %>
                </div>
              <% end %>
            </div>
          </div>
        </li>
      <% end %>
    </ul>

    <div class="mt-3">
      <%== pagy_bootstrap_nav(@pagy) %>
    </div>
  <% else %>
    <p class="text-center text-muted my-5">No people in this stage yet.</p>
  <% end %>
<% end %>

<%# Mobile WebView: native bottom tab bar overlays the last ~80-100px of the
    web content, hiding the pagy nav behind it. Add an inert spacer below so
    the bottom of the list (and its pagination) is reachable. Includes
    safe-area-inset-bottom for devices with home indicators. %>
<% if mobile_app_request? %>
  <div style="height: calc(120px + env(safe-area-inset-bottom, 0px));" aria-hidden="true"></div>
<% end %>
