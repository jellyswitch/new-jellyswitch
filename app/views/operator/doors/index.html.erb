<%- title "Building Access" %>

<%= turbo_frame_tag "doors_list" do %>
  <%= wide_card do %>
    <h4 class="display-4 text-center">Building Access</h4>
    <%= render "operator/doors/keys", doors: @doors, untethered_ios: untethered_ios_request? %>
  <% end %>

  <%= wide_card do %>
    <h4 class="display-4 text-center">Add a door</h4>

    <p>
      Showing doors for <strong><%= current_location.name %></strong>. Switch locations to manage doors at other locations.
    </p>

    <%= link_to "Add a Door", new_door_path, class: "btn btn-block btn-primary" %>

    <%= link_to archived_doors_path, class: "list-group-item list-group-item-action d-flex m-0 mt-3" do %>
      <div class="row w-100">
        <div class="col-11">
          <i class="fas fa-archive"></i>
          &nbsp;
          Archived Doors
        </div>
        <div class="col-1">
          <i class="fas fa-chevron-right"></i>
        </div>
      </div>
    <% end %>
  <% end %>

  <% @doors.each do |door| %>
    <%= wide_card do %>
      <%= render door %>
    <% end %>
  <% end %>
<% end %>
