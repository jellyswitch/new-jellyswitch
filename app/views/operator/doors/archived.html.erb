<%- title "Archived Doors" %>

<%= render "shared/back_bar", back_path: doors_path, back_label: "Doors", page_title: "Archived Doors" %>

<%= wide_card do %>

  <% if @doors.count < 1 %>
    <p class="text-center"><i>No archived doors.</i></p>
  <% else %>
    <div class="list-group list-group-flush mt-4">
      <% @doors.each do |door| %>
        <div class="list-group-item">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <strong><%= door.name %></strong>
              <br>
              <small class="text-muted">Kisi ID: <%= door.kisi_id %></small>
            </div>
            <%= link_to "Unarchive", door_unarchive_path(door), class: "btn btn-sm btn-success", data: { turbo_method: :post, turbo_confirm: "Unarchive #{door.name}?" } %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>
