<%- title @door.name %>

<%= render "shared/back_bar", back_path: doors_path, back_label: "Doors", page_title: "Door Details" %>

<%= render(Layout::FullWidth.new) do %>
  <%= list_item do %>
    <h4 class="display-4 text-center mt-4">Access Log</h4>
    <p class="lead text-center"><%= @door.name %></p>
    <%= column_chart @door.door_punches.group_by_day(:created_at, last: 30).count, label: "Punches" %>
    <p>Kisi ID: <pre><%= @door.kisi_id %></pre></p>
    <%= link_to "Edit", edit_door_path(@door), class: "btn btn-info btn-block" %>
    <%= link_to "Archive", door_path(@door), class: "btn btn-outline-danger btn-block mt-2", data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to archive #{@door.name}?" } %>
  <% end %>
  <% @punches.each do |punch| %>
    <%= link_to door_punch_path(punch), class: "list-group-item list-group-item-action m-0" do %>
      <div class="row">
        <div class="col-lg-10 col-11">
          <%= punch.pretty_datetime %>
          &nbsp;
          <strong><%= punch.user.name %></strong>
        </div>
        <div class="col-1">
          <i class="fas fa-chevron-right"></i>
        </div>
      </div>
    <% end %>
  <% end %>
  <%== pagy_bootstrap_nav(@pagy) %>
<% end %>