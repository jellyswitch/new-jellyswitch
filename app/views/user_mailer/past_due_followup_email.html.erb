<%= render layout: "user_mailer/email_layout" do %>
  <p style="font-family: Helvetica, sans-serif; font-size: 14px; font-weight: normal; margin: 0; margin-bottom: 16px;">Hi <%= @user.name.to_s.split(" ").first %>,</p>
  <p style="font-family: Helvetica, sans-serif; font-size: 14px; font-weight: normal; margin: 0; margin-bottom: 16px;">This is a reminder that your payment<%= " of $#{sprintf('%.2f', (@invoice.amount_due || 0) / 100.0)}" if @invoice.amount_due.present? && @invoice.amount_due > 0 %> is past due. Please update your payment method to avoid any service interruption.</p>
  <p style="font-family: Helvetica, sans-serif; font-size: 14px; font-weight: normal; margin: 0; margin-bottom: 16px;">If you've already taken care of this, please disregard this email.</p>
  <table border="0" cellpadding="0" cellspacing="0" style="border-collapse: separate; margin: 0 auto;">
    <tr>
      <td style="border-radius: 4px; background-color: #e74c3c; text-align: center;" align="center" bgcolor="#e74c3c">
        <a href="<%= home_url(subdomain: @operator.subdomain) %>" target="_blank" style="display: inline-block; color: #ffffff; background-color: #e74c3c; border: solid 1px #e74c3c; border-radius: 4px; box-sizing: border-box; cursor: pointer; text-decoration: none; font-size: 14px; font-weight: bold; margin: 0; padding: 12px 24px;">Update Payment Method</a>
      </td>
    </tr>
  </table>
<% end %>
