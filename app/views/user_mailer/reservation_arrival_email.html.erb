<%= render layout: "user_mailer/email_layout" do %>
  <p style="font-family: Helvetica, sans-serif; font-size: 14px; font-weight: normal; margin: 0; margin-bottom: 16px;">Hi <%= @user.name.to_s.split(" ").first %>,</p>
  <p style="font-family: Helvetica, sans-serif; font-size: 14px; font-weight: normal; margin: 0; margin-bottom: 16px;"><%= @message %></p>
  <p style="font-family: Helvetica, sans-serif; font-size: 14px; font-weight: normal; margin: 0; margin-bottom: 16px;"><strong><%= @reservation.room.name %></strong> · <%= @reservation.datetime_in.strftime("%B %e, %Y") %> · <%= @reservation.datetime_in.strftime("%-l:%M %p") %> – <%= @reservation.datetime_out.strftime("%-l:%M %p") %></p>
  <table border="0" cellpadding="0" cellspacing="0" style="border-collapse: separate; margin: 0 auto;">
    <tr>
      <td style="border-radius: 4px; background-color: #3498db; text-align: center;" align="center" bgcolor="#3498db">
        <a href="<%= home_url(subdomain: @operator.subdomain) %>" target="_blank" style="display: inline-block; color: #ffffff; background-color: #3498db; border: solid 1px #3498db; border-radius: 4px; box-sizing: border-box; cursor: pointer; text-decoration: none; font-size: 14px; font-weight: bold; margin: 0; padding: 12px 24px;">View Reservation</a>
      </td>
    </tr>
  </table>
<% end %>
