<%= render layout: "user_mailer/email_layout" do %>
  <p style="font-family: Helvetica, sans-serif; font-size: 14px; font-weight: normal; margin: 0; margin-bottom: 16px;">Hi <%= @user.name.to_s.split(" ").first %>,</p>

  <p style="font-family: Helvetica, sans-serif; font-size: 14px; font-weight: normal; margin: 0; margin-bottom: 16px;">Your day pass<%= " at #{@location.name}" if @location %> has been rescheduled.</p>

  <table border="0" cellpadding="0" cellspacing="0" style="border-collapse: separate; width: 100%; margin-bottom: 16px;">
    <tr>
      <td style="font-family: Helvetica, sans-serif; font-size: 14px; padding: 8px 0;"><strong>New date:</strong></td>
      <td style="font-family: Helvetica, sans-serif; font-size: 14px; padding: 8px 0;"><%= @day_pass.day.strftime("%A, %B %e, %Y") %></td>
    </tr>
    <tr>
      <td style="font-family: Helvetica, sans-serif; font-size: 14px; padding: 8px 0;"><strong>Previously:</strong></td>
      <td style="font-family: Helvetica, sans-serif; font-size: 14px; padding: 8px 0;"><%= @old_day.strftime("%A, %B %e, %Y") %></td>
    </tr>
    <% if @office_hold %>
      <tr>
        <td style="font-family: Helvetica, sans-serif; font-size: 14px; padding: 8px 0;"><strong>Your office:</strong></td>
        <td style="font-family: Helvetica, sans-serif; font-size: 14px; padding: 8px 0;"><%= @office_hold.room.name %>, <%= @office_hold.window_label %></td>
      </tr>
    <% end %>
    <% if @location %>
      <tr>
        <td style="font-family: Helvetica, sans-serif; font-size: 14px; padding: 8px 0;"><strong>Location:</strong></td>
        <td style="font-family: Helvetica, sans-serif; font-size: 14px; padding: 8px 0;"><%= @location.name %></td>
      </tr>
    <% end %>
  </table>

  <p style="font-family: Helvetica, sans-serif; font-size: 13px; color: #666; margin: 0;">
    If this change doesn't look right, just reply to this email and we'll sort it out.
  </p>
<% end %>
