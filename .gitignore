# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile '~/.gitignore_global'

# Ignore bundler config.
/.bundle

# Ignore the default SQLite database.
/db/*.sqlite3
/db/*.sqlite3-*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore uploaded files in development
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore master key for decrypting credentials and more.
/config/master.key

# Mine
/vendor/*
.DS_Store
.env
*.dump
*.code-workspace
/public/packs
/public/packs-test

/config/credentials/production.key
.production-env

/config/credentials/development.key
.byebug_history

# Secrets and credential material — `.env` alone missed the variants.
.env.*
!.env.example
*.pem
*.p12
*.pfx
*.keystore
*.mobileprovision

# Database dumps and data exports. The tracked sample/fixture CSVs are
# placeholder data and stay; anything new is assumed to be a real export
# until proven otherwise.
*.sql
*.csv
!docs/officernd-migration/sample-members.csv
!spec/fixtures/officernd_day_passes.csv
!spec/fixtures/officernd_members.csv
